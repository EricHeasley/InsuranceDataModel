{
  "domain": "product",
  "description": "What the insurer sells: products, where they are approved, the coverages they offer, the limits/deductibles/benefit terms each coverage can carry, and policy forms.",
  "enums": {
    "product_status": { "description": "Lifecycle status of a product.", "values": ["DRAFT", "FILED", "ACTIVE", "CLOSED_TO_NEW_BUSINESS", "RETIRED"] },
    "market_type": { "description": "Regulatory market a product is written in.", "values": { "ADMITTED": "", "SURPLUS_LINES": "Excess & surplus lines", "RESIDUAL": "Assigned risk / FAIR plan / residual market", "SELF_FUNDED": "Administrative services only (health)", "GOVERNMENT": "Medicare, Medicaid, NFIP and similar programs" } },
    "filing_type": { "description": "Subject of a regulatory filing.", "values": ["RATE", "RULE", "FORM", "RATE_AND_RULE", "PRODUCT", "ADVERTISING"] },
    "filing_status": { "description": "Disposition of a regulatory filing.", "values": ["DRAFT", "SUBMITTED", "APPROVED", "ACKNOWLEDGED", "DISAPPROVED", "WITHDRAWN"] },
    "coverage_category": {
      "description": "Broad nature of a coverage.",
      "values": { "LIABILITY": "Third-party bodily injury / property damage / financial loss", "PROPERTY": "First-party damage to property", "MEDICAL_PAYMENTS": "No-fault medical, PIP, med pay", "TIME_ELEMENT": "Business income, loss of use, additional living expense", "WORKERS_COMP": "Statutory workers' compensation benefits", "DEATH_BENEFIT": "Life insurance base coverage", "LIVING_BENEFIT": "Annuity and life living-benefit guarantees", "RIDER": "Optional life/annuity rider", "HEALTH_BENEFIT": "Medical, dental, vision benefit package", "INCOME_REPLACEMENT": "Disability and long-term care", "SURETY": "Bond obligation", "OTHER": "" }
    },
    "coverage_term_type": { "description": "Kind of quantitative term attached to a coverage.", "values": ["LIMIT", "SUBLIMIT", "DEDUCTIBLE", "SELF_INSURED_RETENTION", "COINSURANCE", "COPAY", "OUT_OF_POCKET_MAX", "WAITING_PERIOD", "ELIMINATION_PERIOD", "BENEFIT_PERIOD", "BENEFIT_AMOUNT", "FACE_AMOUNT", "OPTION"] },
    "coverage_term_basis": { "description": "Scope a coverage term applies over.", "values": ["PER_OCCURRENCE", "PER_CLAIM", "PER_PERSON", "PER_ACCIDENT", "PER_ITEM", "PER_LOCATION", "PER_DAY", "PER_WEEK", "PER_MONTH", "PER_VISIT", "AGGREGATE", "POLICY_PERIOD", "CALENDAR_YEAR", "LIFETIME", "NOT_APPLICABLE"] },
    "term_value_type": { "description": "How the value of a coverage term is expressed.", "values": ["AMOUNT", "PERCENT", "DAYS", "MONTHS", "COUNT", "CODE"] },
    "form_type": { "description": "Kind of policy form.", "values": ["POLICY_JACKET", "COVERAGE_FORM", "DECLARATIONS", "ENDORSEMENT", "RIDER", "NOTICE", "APPLICATION", "CERTIFICATE"] },
    "form_usage": { "description": "When a form attaches to a policy.", "values": ["MANDATORY", "CONDITIONAL", "OPTIONAL"] }
  },
  "entities": [
    {
      "name": "product",
      "description": "An insurance product offered to the market, such as a personal auto program, a businessowners policy, a 20-year level term life plan or a deferred indexed annuity.",
      "primaryKey": ["product_id"],
      "unique": [["product_code"]],
      "attributes": [
        { "name": "product_id", "type": "uuid", "required": true },
        { "name": "product_code", "type": "string", "maxLength": 30, "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "line_of_business_code", "type": "string", "maxLength": 30, "required": true, "references": "line_of_business.line_of_business_code" },
        { "name": "market_type", "type": "string", "enum": "market_type", "required": true },
        { "name": "product_status", "type": "string", "enum": "product_status", "required": true },
        { "name": "is_package", "type": "boolean", "description": "True when the product bundles multiple lines (e.g. BOP, commercial package)." },
        { "name": "is_group", "type": "boolean", "description": "True when sold as a group master contract with certificates or members." },
        { "name": "default_term_months", "type": "integer", "description": "Standard policy term length; null for continuous contracts." },
        { "name": "introduced_on", "type": "date" },
        { "name": "retired_on", "type": "date" }
      ]
    },
    {
      "name": "product_jurisdiction",
      "description": "Availability of a product in a jurisdiction through a specific writing company.",
      "primaryKey": ["product_jurisdiction_id"],
      "attributes": [
        { "name": "product_jurisdiction_id", "type": "uuid", "required": true },
        { "name": "product_id", "type": "uuid", "required": true, "references": "product.product_id" },
        { "name": "jurisdiction_code", "type": "string", "maxLength": 6, "required": true, "references": "jurisdiction.jurisdiction_code" },
        { "name": "insurer_id", "type": "uuid", "required": true, "references": "insurer.insurer_id" },
        { "name": "new_business_effective_on", "type": "date", "required": true },
        { "name": "renewal_effective_on", "type": "date" },
        { "name": "closed_on", "type": "date" }
      ]
    },
    {
      "name": "product_filing",
      "description": "A rate, rule or form filing made with a regulator for a product (typically via SERFF).",
      "primaryKey": ["product_filing_id"],
      "attributes": [
        { "name": "product_filing_id", "type": "uuid", "required": true },
        { "name": "product_id", "type": "uuid", "required": true, "references": "product.product_id" },
        { "name": "jurisdiction_code", "type": "string", "maxLength": 6, "required": true, "references": "jurisdiction.jurisdiction_code" },
        { "name": "insurer_id", "type": "uuid", "references": "insurer.insurer_id" },
        { "name": "filing_type", "type": "string", "enum": "filing_type", "required": true },
        { "name": "filing_status", "type": "string", "enum": "filing_status", "required": true },
        { "name": "tracking_number", "type": "string", "maxLength": 50, "description": "SERFF or state tracking number." },
        { "name": "overall_rate_change_percent", "type": "percent" },
        { "name": "submitted_on", "type": "date" },
        { "name": "disposition_on", "type": "date" },
        { "name": "new_business_effective_on", "type": "date" },
        { "name": "renewal_effective_on", "type": "date" }
      ]
    },
    {
      "name": "coverage_definition",
      "description": "A coverage, benefit or rider a product can provide, e.g. Bodily Injury Liability, Dwelling (Coverage A), Employers Liability, Waiver of Premium rider, Guaranteed Lifetime Withdrawal Benefit.",
      "primaryKey": ["coverage_definition_id"],
      "unique": [["product_id", "coverage_code"]],
      "attributes": [
        { "name": "coverage_definition_id", "type": "uuid", "required": true },
        { "name": "product_id", "type": "uuid", "required": true, "references": "product.product_id" },
        { "name": "coverage_code", "type": "string", "maxLength": 30, "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "coverage_category", "type": "string", "enum": "coverage_category", "required": true },
        { "name": "line_of_business_code", "type": "string", "maxLength": 30, "references": "line_of_business.line_of_business_code", "description": "Sub-line within a package product." },
        { "name": "asl_code", "type": "string", "maxLength": 10, "references": "annual_statement_line.asl_code", "description": "Default statutory line for premium and loss." },
        { "name": "applies_to_object_type", "type": "string", "enum": "insurable_object_type", "description": "Kind of risk this coverage attaches to; null for policy-level coverages." },
        { "name": "is_mandatory", "type": "boolean", "required": true },
        { "name": "is_rider", "type": "boolean" },
        { "name": "parent_coverage_definition_id", "type": "uuid", "references": "coverage_definition.coverage_definition_id", "description": "Base coverage this sub-coverage or rider depends on." }
      ]
    },
    {
      "name": "coverage_term_definition",
      "description": "A limit, deductible, coinsurance, waiting period or other quantitative term that a coverage can carry, with its allowed range.",
      "primaryKey": ["coverage_term_definition_id"],
      "unique": [["coverage_definition_id", "term_code"]],
      "attributes": [
        { "name": "coverage_term_definition_id", "type": "uuid", "required": true },
        { "name": "coverage_definition_id", "type": "uuid", "required": true, "references": "coverage_definition.coverage_definition_id" },
        { "name": "term_code", "type": "string", "maxLength": 30, "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "coverage_term_type", "type": "string", "enum": "coverage_term_type", "required": true },
        { "name": "coverage_term_basis", "type": "string", "enum": "coverage_term_basis", "required": true },
        { "name": "term_value_type", "type": "string", "enum": "term_value_type", "required": true },
        { "name": "default_value", "type": "decimal" },
        { "name": "minimum_value", "type": "decimal" },
        { "name": "maximum_value", "type": "decimal" },
        { "name": "is_required", "type": "boolean", "required": true }
      ]
    },
    {
      "name": "form",
      "description": "A policy form, endorsement or notice edition (ISO, NCCI, ACORD or proprietary).",
      "primaryKey": ["form_id"],
      "unique": [["form_number", "edition"]],
      "attributes": [
        { "name": "form_id", "type": "uuid", "required": true },
        { "name": "form_number", "type": "string", "maxLength": 50, "required": true },
        { "name": "edition", "type": "string", "maxLength": 20, "required": true, "description": "Edition date as printed, e.g. 04 13." },
        { "name": "title", "type": "string", "required": true },
        { "name": "form_type", "type": "string", "enum": "form_type", "required": true },
        { "name": "publisher", "type": "string", "maxLength": 50, "description": "ISO, NCCI, AAIS, ACORD or the company." },
        { "name": "template_document_id", "type": "uuid", "references": "document.document_id" }
      ]
    },
    {
      "name": "product_form",
      "description": "Approval of a form for use with a product in a jurisdiction.",
      "primaryKey": ["product_form_id"],
      "attributes": [
        { "name": "product_form_id", "type": "uuid", "required": true },
        { "name": "product_id", "type": "uuid", "required": true, "references": "product.product_id" },
        { "name": "form_id", "type": "uuid", "required": true, "references": "form.form_id" },
        { "name": "jurisdiction_code", "type": "string", "maxLength": 6, "references": "jurisdiction.jurisdiction_code", "description": "Null for countrywide forms." },
        { "name": "coverage_definition_id", "type": "uuid", "references": "coverage_definition.coverage_definition_id", "description": "Coverage whose selection triggers the form, if any." },
        { "name": "form_usage", "type": "string", "enum": "form_usage", "required": true },
        { "name": "product_filing_id", "type": "uuid", "references": "product_filing.product_filing_id" },
        { "name": "effective_on", "type": "date", "required": true },
        { "name": "expires_on", "type": "date" }
      ]
    }
  ]
}
