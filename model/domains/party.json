{
  "domain": "party",
  "description": "People and organizations, how to reach them, how they relate to each other, and the enterprise-level roles they hold (insurer, staff).",
  "enums": {
    "party_type": { "description": "Kind of party.", "values": ["PERSON", "ORGANIZATION"] },
    "party_status": { "description": "Lifecycle status of a party record.", "values": { "ACTIVE": "", "INACTIVE": "", "DECEASED": "", "DISSOLVED": "", "MERGED": "Merged into another party record as a duplicate" } },
    "gender": { "description": "Gender as used for rating and health administration.", "values": ["FEMALE", "MALE", "NONBINARY", "UNKNOWN"] },
    "marital_status": { "description": "Marital status.", "values": ["SINGLE", "MARRIED", "DOMESTIC_PARTNER", "DIVORCED", "SEPARATED", "WIDOWED", "UNKNOWN"] },
    "organization_type": { "description": "Legal form of an organization.", "values": ["CORPORATION", "LLC", "PARTNERSHIP", "SOLE_PROPRIETOR", "NONPROFIT", "GOVERNMENT", "TRUST", "ESTATE", "ASSOCIATION", "OTHER"] },
    "identifier_type": {
      "description": "Kind of externally issued identifier.",
      "values": { "SSN": "Social Security number", "ITIN": "Individual taxpayer identification number", "FEIN": "Federal employer identification number", "DRIVER_LICENSE": "", "PASSPORT": "", "STATE_ID": "", "NPI": "National Provider Identifier", "NPN": "National Producer Number", "NAIC_COMPANY_CODE": "", "DUNS": "", "MEDICARE_BENEFICIARY_ID": "", "MEDICAID_ID": "", "OTHER": "" }
    },
    "address_usage": { "description": "What a party uses an address for.", "values": ["RESIDENCE", "MAILING", "BILLING", "BUSINESS", "PRACTICE", "PAY_TO", "OTHER"] },
    "contact_point_type": { "description": "Channel of a contact point.", "values": ["EMAIL", "PHONE", "MOBILE", "FAX", "PORTAL", "OTHER"] },
    "contact_usage": { "description": "Context a contact point is used in.", "values": ["HOME", "WORK", "OTHER"] },
    "party_relationship_type": {
      "description": "Relationship of from-party to to-party.",
      "values": { "SPOUSE": "", "DOMESTIC_PARTNER": "", "CHILD": "", "PARENT": "", "DEPENDENT": "", "HOUSEHOLD_MEMBER": "", "EMPLOYEE": "From-party is employed by to-party", "OWNER": "From-party owns to-party", "SUBSIDIARY": "From-party is a subsidiary of to-party", "TRUSTEE": "", "GUARDIAN": "", "POWER_OF_ATTORNEY": "", "ATTORNEY": "From-party legally represents to-party", "CONTACT": "From-party is a contact person for to-party", "OTHER": "" }
    },
    "consent_type": { "description": "Subject of a consent or preference.", "values": ["ELECTRONIC_DELIVERY", "MARKETING", "TELEMATICS", "CREDIT_SCORE", "HIPAA_AUTHORIZATION", "DATA_SHARING", "CALL_RECORDING", "AUTO_DIALER_TCPA"] },
    "consent_status": { "description": "State of a consent.", "values": ["GRANTED", "DENIED", "REVOKED", "EXPIRED"] },
    "staff_role": { "description": "Primary function of a staff member.", "values": ["UNDERWRITER", "CLAIM_ADJUSTER", "CLAIM_SUPERVISOR", "SIU_INVESTIGATOR", "CUSTOMER_SERVICE", "BILLING_SPECIALIST", "PREMIUM_AUDITOR", "NURSE_CASE_MANAGER", "ACTUARY", "SYSTEM", "OTHER"] }
  },
  "entities": [
    {
      "name": "party",
      "description": "A person or organization of interest to the business in any capacity. Supertype of person and organization.",
      "primaryKey": ["party_id"],
      "attributes": [
        { "name": "party_id", "type": "uuid", "required": true },
        { "name": "party_type", "type": "string", "enum": "party_type", "required": true },
        { "name": "display_name", "type": "string", "required": true, "sensitivity": "PII", "description": "Full name formatted for display and search." },
        { "name": "party_status", "type": "string", "enum": "party_status", "required": true },
        { "name": "merged_into_party_id", "type": "uuid", "references": "party.party_id", "description": "Surviving record when this one was merged as a duplicate." },
        { "name": "preferred_language", "type": "string", "maxLength": 10, "description": "BCP 47 language tag." }
      ]
    },
    {
      "name": "person",
      "description": "A natural person.",
      "subtypeOf": "party",
      "primaryKey": ["party_id"],
      "attributes": [
        { "name": "party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "first_name", "type": "string", "maxLength": 100, "sensitivity": "PII" },
        { "name": "middle_name", "type": "string", "maxLength": 100, "sensitivity": "PII" },
        { "name": "last_name", "type": "string", "maxLength": 100, "required": true, "sensitivity": "PII" },
        { "name": "name_suffix", "type": "string", "maxLength": 20 },
        { "name": "birth_date", "type": "date", "sensitivity": "PII" },
        { "name": "death_date", "type": "date", "sensitivity": "PII" },
        { "name": "gender", "type": "string", "enum": "gender", "sensitivity": "SPI" },
        { "name": "marital_status", "type": "string", "enum": "marital_status", "sensitivity": "SPI" },
        { "name": "occupation", "type": "string" }
      ]
    },
    {
      "name": "organization",
      "description": "A legal entity or other organized group.",
      "subtypeOf": "party",
      "primaryKey": ["party_id"],
      "attributes": [
        { "name": "party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "legal_name", "type": "string", "required": true },
        { "name": "dba_name", "type": "string", "description": "Doing-business-as name." },
        { "name": "organization_type", "type": "string", "enum": "organization_type" },
        { "name": "naics_code_value_id", "type": "uuid", "references": "code_value.code_value_id", "description": "Primary NAICS industry code." },
        { "name": "formation_date", "type": "date" },
        { "name": "formation_jurisdiction_code", "type": "string", "maxLength": 6, "references": "jurisdiction.jurisdiction_code" },
        { "name": "annual_revenue_amount", "type": "money" },
        { "name": "employee_count", "type": "integer" },
        { "name": "website_url", "type": "string", "maxLength": 500 }
      ]
    },
    {
      "name": "party_identifier",
      "description": "An identifier issued to a party by an external authority (SSN, FEIN, driver license, NPI, NPN, ...).",
      "primaryKey": ["party_identifier_id"],
      "unique": [["identifier_type", "identifier_value", "issuing_jurisdiction_code", "party_id"]],
      "attributes": [
        { "name": "party_identifier_id", "type": "uuid", "required": true },
        { "name": "party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "identifier_type", "type": "string", "enum": "identifier_type", "required": true },
        { "name": "identifier_value", "type": "string", "maxLength": 100, "required": true, "sensitivity": "PII", "description": "Store encrypted or tokenized." },
        { "name": "issuing_jurisdiction_code", "type": "string", "maxLength": 6, "references": "jurisdiction.jurisdiction_code" },
        { "name": "valid_from", "type": "date" },
        { "name": "valid_to", "type": "date" }
      ]
    },
    {
      "name": "address",
      "description": "A postal or physical location. Shared by parties, insured locations and loss locations.",
      "primaryKey": ["address_id"],
      "attributes": [
        { "name": "address_id", "type": "uuid", "required": true },
        { "name": "line_1", "type": "string", "required": true, "sensitivity": "PII" },
        { "name": "line_2", "type": "string", "sensitivity": "PII" },
        { "name": "city", "type": "string", "maxLength": 100, "required": true },
        { "name": "county", "type": "string", "maxLength": 100 },
        { "name": "jurisdiction_code", "type": "string", "maxLength": 6, "references": "jurisdiction.jurisdiction_code", "description": "State or equivalent." },
        { "name": "postal_code", "type": "string", "maxLength": 20, "required": true },
        { "name": "country_code", "type": "string", "maxLength": 2, "required": true, "references": "country.country_code" },
        { "name": "latitude", "type": "decimal" },
        { "name": "longitude", "type": "decimal" },
        { "name": "geocode_precision", "type": "string", "maxLength": 30, "description": "ROOFTOP, PARCEL, STREET, POSTAL_CODE, ..." },
        { "name": "census_block_fips", "type": "string", "maxLength": 15 },
        { "name": "is_validated", "type": "boolean", "description": "True when standardized against a postal reference (e.g. USPS CASS)." }
      ]
    },
    {
      "name": "party_address",
      "description": "Use of an address by a party over a period.",
      "primaryKey": ["party_address_id"],
      "attributes": [
        { "name": "party_address_id", "type": "uuid", "required": true },
        { "name": "party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "address_id", "type": "uuid", "required": true, "references": "address.address_id" },
        { "name": "address_usage", "type": "string", "enum": "address_usage", "required": true },
        { "name": "is_primary", "type": "boolean", "required": true },
        { "name": "valid_from", "type": "date" },
        { "name": "valid_to", "type": "date" }
      ]
    },
    {
      "name": "contact_point",
      "description": "An email address, phone number or other channel for reaching a party.",
      "primaryKey": ["contact_point_id"],
      "attributes": [
        { "name": "contact_point_id", "type": "uuid", "required": true },
        { "name": "party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "contact_point_type", "type": "string", "enum": "contact_point_type", "required": true },
        { "name": "contact_value", "type": "string", "maxLength": 320, "required": true, "sensitivity": "PII" },
        { "name": "contact_usage", "type": "string", "enum": "contact_usage" },
        { "name": "is_primary", "type": "boolean", "required": true },
        { "name": "is_verified", "type": "boolean" },
        { "name": "do_not_contact", "type": "boolean" }
      ]
    },
    {
      "name": "party_relationship",
      "description": "A directed relationship between two parties (family, household, employment, ownership, legal representation).",
      "primaryKey": ["party_relationship_id"],
      "attributes": [
        { "name": "party_relationship_id", "type": "uuid", "required": true },
        { "name": "from_party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "to_party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "party_relationship_type", "type": "string", "enum": "party_relationship_type", "required": true },
        { "name": "ownership_percent", "type": "percent", "description": "For OWNER relationships." },
        { "name": "valid_from", "type": "date" },
        { "name": "valid_to", "type": "date" }
      ]
    },
    {
      "name": "party_consent",
      "description": "A consent, authorization or communication preference given by a party.",
      "primaryKey": ["party_consent_id"],
      "attributes": [
        { "name": "party_consent_id", "type": "uuid", "required": true },
        { "name": "party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "consent_type", "type": "string", "enum": "consent_type", "required": true },
        { "name": "consent_status", "type": "string", "enum": "consent_status", "required": true },
        { "name": "captured_at", "type": "timestamp", "required": true },
        { "name": "capture_channel", "type": "string", "maxLength": 30 },
        { "name": "expires_on", "type": "date" },
        { "name": "evidence_document_id", "type": "uuid", "references": "document.document_id" }
      ]
    },
    {
      "name": "insurer",
      "description": "A licensed insurance company (underwriting/writing company) of the enterprise, or an external carrier referenced on claims and prior coverage.",
      "primaryKey": ["insurer_id"],
      "unique": [["party_id"]],
      "attributes": [
        { "name": "insurer_id", "type": "uuid", "required": true },
        { "name": "party_id", "type": "uuid", "required": true, "references": "organization.party_id" },
        { "name": "naic_company_code", "type": "string", "maxLength": 5 },
        { "name": "naic_group_code", "type": "string", "maxLength": 5 },
        { "name": "domicile_jurisdiction_code", "type": "string", "maxLength": 6, "references": "jurisdiction.jurisdiction_code" },
        { "name": "is_internal", "type": "boolean", "required": true, "description": "True for the enterprise's own writing companies." },
        { "name": "financial_strength_rating", "type": "string", "maxLength": 10, "description": "E.g. AM Best rating." }
      ]
    },
    {
      "name": "staff_member",
      "description": "An employee, contractor or system identity that performs work on policies and claims.",
      "primaryKey": ["staff_member_id"],
      "attributes": [
        { "name": "staff_member_id", "type": "uuid", "required": true },
        { "name": "party_id", "type": "uuid", "references": "party.party_id", "description": "Null for system identities." },
        { "name": "user_name", "type": "string", "maxLength": 100, "required": true },
        { "name": "staff_role", "type": "string", "enum": "staff_role", "required": true },
        { "name": "supervisor_staff_member_id", "type": "uuid", "references": "staff_member.staff_member_id" },
        { "name": "office_code", "type": "string", "maxLength": 30 },
        { "name": "payment_authority_amount", "type": "money", "description": "Maximum single claim payment this person may approve." },
        { "name": "reserve_authority_amount", "type": "money" },
        { "name": "is_active", "type": "boolean", "required": true }
      ]
    },
    {
      "name": "document",
      "description": "Metadata for a stored document or image (application, policy declaration, loss photo, medical record, correspondence). Content lives in a document store.",
      "primaryKey": ["document_id"],
      "attributes": [
        { "name": "document_id", "type": "uuid", "required": true },
        { "name": "document_type", "type": "string", "maxLength": 50, "required": true, "description": "E.g. APPLICATION, DECLARATIONS, ENDORSEMENT, INVOICE, LOSS_PHOTO, ESTIMATE, MEDICAL_RECORD, EOB, CORRESPONDENCE." },
        { "name": "title", "type": "string" },
        { "name": "storage_uri", "type": "string", "maxLength": 1000, "required": true },
        { "name": "mime_type", "type": "string", "maxLength": 100 },
        { "name": "content_hash", "type": "string", "maxLength": 128, "description": "Digest of the content for integrity." },
        { "name": "received_at", "type": "timestamp" },
        { "name": "direction", "type": "string", "maxLength": 10, "description": "INBOUND, OUTBOUND or INTERNAL." },
        { "name": "contains_phi", "type": "boolean" },
        { "name": "party_id", "type": "uuid", "references": "party.party_id" },
        { "name": "submission_id", "type": "uuid", "references": "submission.submission_id" },
        { "name": "policy_id", "type": "uuid", "references": "policy.policy_id" },
        { "name": "policy_transaction_id", "type": "uuid", "references": "policy_transaction.policy_transaction_id" },
        { "name": "claim_id", "type": "uuid", "references": "claim.claim_id" },
        { "name": "health_claim_id", "type": "uuid", "references": "health_claim.health_claim_id" },
        { "name": "billing_account_id", "type": "uuid", "references": "billing_account.billing_account_id" }
      ]
    }
  ]
}
