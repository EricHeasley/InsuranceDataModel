{
  "domain": "health",
  "description": "Health and accident & health detail: benefit plans, employer groups, members and enrollment, providers and networks, medical/dental/pharmacy claims with adjudication, prior authorization, accumulators, coordination of benefits and disability claims.",
  "enums": {
    "health_plan_type": { "description": "Plan design / network model.", "values": ["HMO", "PPO", "EPO", "POS", "HDHP", "INDEMNITY", "DENTAL_PPO", "DENTAL_HMO", "VISION", "MEDICARE_SUPPLEMENT", "MEDICARE_ADVANTAGE", "PART_D", "SHORT_TERM_DISABILITY", "LONG_TERM_DISABILITY", "LONG_TERM_CARE", "ACCIDENT", "CRITICAL_ILLNESS", "HOSPITAL_INDEMNITY"] },
    "market_segment": { "description": "Health market segment.", "values": ["INDIVIDUAL", "SMALL_GROUP", "LARGE_GROUP", "SELF_FUNDED", "MEDICARE", "MEDICAID", "STUDENT", "ASSOCIATION"] },
    "metal_tier": { "description": "ACA actuarial value tier.", "values": ["CATASTROPHIC", "BRONZE", "SILVER", "GOLD", "PLATINUM", "NOT_APPLICABLE"] },
    "network_tier": { "description": "Benefit tier by provider network status.", "values": ["IN_NETWORK", "PREFERRED", "OUT_OF_NETWORK", "ANY"] },
    "coverage_tier": { "description": "Who is covered under an enrollment.", "values": ["EMPLOYEE_ONLY", "EMPLOYEE_SPOUSE", "EMPLOYEE_CHILDREN", "FAMILY", "INDIVIDUAL", "CHILD_ONLY"] },
    "member_relationship": { "description": "Relationship of a member to the subscriber.", "values": ["SELF", "SPOUSE", "DOMESTIC_PARTNER", "CHILD", "DISABLED_DEPENDENT", "OTHER_DEPENDENT"] },
    "enrollment_status": { "description": "Status of an enrollment span.", "values": ["PENDING", "ACTIVE", "TERMINATED", "CANCELLED", "COBRA", "GRACE_PERIOD"] },
    "provider_type": { "description": "Kind of health care provider.", "values": ["INDIVIDUAL_PRACTITIONER", "GROUP_PRACTICE", "HOSPITAL", "AMBULATORY_FACILITY", "SKILLED_NURSING", "HOME_HEALTH", "PHARMACY", "LABORATORY", "DME_SUPPLIER", "DENTAL", "VISION", "BEHAVIORAL_HEALTH", "OTHER"] },
    "health_claim_type": { "description": "Claim form family.", "values": { "PROFESSIONAL": "CMS-1500 / 837P", "INSTITUTIONAL": "UB-04 / 837I", "DENTAL": "ADA / 837D", "PHARMACY": "NCPDP", "VISION": "", "MEMBER_REIMBURSEMENT": "" } },
    "health_claim_status": { "description": "Adjudication status of a claim.", "values": ["RECEIVED", "PENDED", "IN_REVIEW", "ADJUDICATED", "PAID", "DENIED", "PARTIALLY_DENIED", "ADJUSTED", "REVERSED", "VOIDED"] },
    "claim_line_status": { "description": "Adjudication status of a claim line.", "values": ["PENDED", "APPROVED", "DENIED", "ADJUSTED"] },
    "diagnosis_qualifier": { "description": "Role of a diagnosis on a claim.", "values": ["PRINCIPAL", "ADMITTING", "SECONDARY", "EXTERNAL_CAUSE", "PATIENT_REASON_FOR_VISIT"] },
    "authorization_status": { "description": "Status of a prior authorization.", "values": ["REQUESTED", "PENDED", "APPROVED", "PARTIALLY_APPROVED", "DENIED", "WITHDRAWN", "EXPIRED"] },
    "accumulator_type": { "description": "Kind of benefit accumulator.", "values": ["DEDUCTIBLE", "OUT_OF_POCKET_MAXIMUM", "BENEFIT_MAXIMUM", "VISIT_LIMIT", "LIFETIME_MAXIMUM"] },
    "accumulator_level": { "description": "Whether an accumulator is tracked per member or per family.", "values": ["INDIVIDUAL", "FAMILY"] },
    "disability_type": { "description": "Kind of disability claim.", "values": ["SHORT_TERM", "LONG_TERM", "WAIVER_OF_PREMIUM", "LONG_TERM_CARE", "PAID_FAMILY_LEAVE"] }
  },
  "entities": [
    {
      "name": "health_plan",
      "description": "A benefit plan design offered under a health product for a plan year.",
      "primaryKey": ["health_plan_id"],
      "unique": [["plan_code", "plan_year"]],
      "attributes": [
        { "name": "health_plan_id", "type": "uuid", "required": true },
        { "name": "product_id", "type": "uuid", "required": true, "references": "product.product_id" },
        { "name": "plan_code", "type": "string", "maxLength": 30, "required": true },
        { "name": "plan_year", "type": "integer", "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "health_plan_type", "type": "string", "enum": "health_plan_type", "required": true },
        { "name": "market_segment", "type": "string", "enum": "market_segment", "required": true },
        { "name": "metal_tier", "type": "string", "enum": "metal_tier" },
        { "name": "hios_plan_id", "type": "string", "maxLength": 20, "description": "CMS HIOS standard component ID with variant, for ACA plans." },
        { "name": "cms_contract_number", "type": "string", "maxLength": 20, "description": "Medicare Advantage / Part D contract and plan benefit package." },
        { "name": "provider_network_id", "type": "uuid", "references": "provider_network.provider_network_id" },
        { "name": "individual_deductible_amount", "type": "money" },
        { "name": "family_deductible_amount", "type": "money" },
        { "name": "individual_out_of_pocket_max_amount", "type": "money" },
        { "name": "family_out_of_pocket_max_amount", "type": "money" },
        { "name": "is_hsa_eligible", "type": "boolean" },
        { "name": "actuarial_value_percent", "type": "percent" },
        { "name": "accumulator_period", "type": "string", "maxLength": 20, "description": "CALENDAR_YEAR or PLAN_YEAR." }
      ]
    },
    {
      "name": "plan_benefit",
      "description": "Cost sharing and limits for a category of service under a plan and network tier.",
      "primaryKey": ["plan_benefit_id"],
      "unique": [["health_plan_id", "benefit_code", "network_tier"]],
      "attributes": [
        { "name": "plan_benefit_id", "type": "uuid", "required": true },
        { "name": "health_plan_id", "type": "uuid", "required": true, "references": "health_plan.health_plan_id" },
        { "name": "benefit_code", "type": "string", "maxLength": 30, "required": true, "description": "Service category, e.g. PCP_VISIT, SPECIALIST, ER, INPATIENT, RX_TIER_1, PREVENTIVE_DENTAL." },
        { "name": "name", "type": "string", "required": true },
        { "name": "network_tier", "type": "string", "enum": "network_tier", "required": true },
        { "name": "is_covered", "type": "boolean", "required": true },
        { "name": "copay_amount", "type": "money" },
        { "name": "coinsurance_percent", "type": "percent", "description": "Member share." },
        { "name": "deductible_applies", "type": "boolean" },
        { "name": "limit_quantity", "type": "decimal" },
        { "name": "limit_unit", "type": "string", "maxLength": 20, "description": "VISITS, DAYS, DOLLARS, UNITS." },
        { "name": "limit_period", "type": "string", "enum": "coverage_term_basis" },
        { "name": "requires_prior_authorization", "type": "boolean" },
        { "name": "requires_referral", "type": "boolean" },
        { "name": "waiting_period_days", "type": "integer" }
      ]
    },
    {
      "name": "employer_group",
      "description": "Group-specific attributes of a group master policy: the employer or association sponsoring coverage for its members.",
      "subtypeOf": "policy",
      "primaryKey": ["policy_id"],
      "attributes": [
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "group_number", "type": "string", "maxLength": 30, "required": true },
        { "name": "sponsor_party_id", "type": "uuid", "required": true, "references": "organization.party_id" },
        { "name": "market_segment", "type": "string", "enum": "market_segment", "required": true },
        { "name": "eligible_employee_count", "type": "integer" },
        { "name": "enrolled_employee_count", "type": "integer" },
        { "name": "new_hire_waiting_period_days", "type": "integer" },
        { "name": "employer_contribution_percent", "type": "percent" },
        { "name": "plan_year_start_month", "type": "integer" },
        { "name": "is_erisa_plan", "type": "boolean" },
        { "name": "is_cobra_eligible", "type": "boolean" },
        { "name": "funding_arrangement", "type": "string", "maxLength": 30, "description": "FULLY_INSURED, LEVEL_FUNDED, ASO, MINIMUM_PREMIUM." },
        { "name": "stop_loss_specific_attachment_amount", "type": "money" },
        { "name": "stop_loss_aggregate_attachment_percent", "type": "percent" }
      ]
    },
    {
      "name": "group_subgroup",
      "description": "A division, class or billing unit within an employer group, with the plans offered to it.",
      "primaryKey": ["group_subgroup_id"],
      "unique": [["policy_id", "subgroup_code"]],
      "attributes": [
        { "name": "group_subgroup_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "employer_group.policy_id" },
        { "name": "subgroup_code", "type": "string", "maxLength": 30, "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "eligibility_class", "type": "string", "maxLength": 50, "description": "E.g. salaried, hourly, executives, retirees." },
        { "name": "billing_account_id", "type": "uuid", "references": "billing_account.billing_account_id" },
        { "name": "effective_date", "type": "date", "required": true },
        { "name": "termination_date", "type": "date" }
      ]
    },
    {
      "name": "member",
      "description": "A person covered or formerly covered by health or group benefits, identified by a member ID.",
      "primaryKey": ["member_id"],
      "unique": [["member_number"]],
      "attributes": [
        { "name": "member_id", "type": "uuid", "required": true },
        { "name": "party_id", "type": "uuid", "required": true, "references": "person.party_id" },
        { "name": "member_number", "type": "string", "maxLength": 30, "required": true, "sensitivity": "PHI", "description": "ID printed on the member's card." },
        { "name": "medicare_eligibility_reason", "type": "string", "maxLength": 20, "description": "AGE, DISABILITY, ESRD." },
        { "name": "is_tobacco_user", "type": "boolean", "sensitivity": "PHI" }
      ]
    },
    {
      "name": "enrollment",
      "description": "A span of a member's coverage in a plan under a policy (individual policy or group master). Subscribers and dependents each have their own spans; dependents point to the subscriber.",
      "primaryKey": ["enrollment_id"],
      "attributes": [
        { "name": "enrollment_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "health_plan_id", "type": "uuid", "required": true, "references": "health_plan.health_plan_id" },
        { "name": "member_id", "type": "uuid", "required": true, "references": "member.member_id" },
        { "name": "subscriber_member_id", "type": "uuid", "required": true, "references": "member.member_id" },
        { "name": "member_relationship", "type": "string", "enum": "member_relationship", "required": true },
        { "name": "coverage_tier", "type": "string", "enum": "coverage_tier" },
        { "name": "group_subgroup_id", "type": "uuid", "references": "group_subgroup.group_subgroup_id" },
        { "name": "enrollment_status", "type": "string", "enum": "enrollment_status", "required": true },
        { "name": "effective_date", "type": "date", "required": true },
        { "name": "termination_date", "type": "date" },
        { "name": "termination_reason", "type": "string", "maxLength": 50 },
        { "name": "enrollment_source", "type": "string", "maxLength": 30, "description": "EDI_834, EXCHANGE, PORTAL, PAPER, ..." },
        { "name": "qualifying_event", "type": "string", "maxLength": 50, "description": "Special enrollment or COBRA qualifying event." },
        { "name": "primary_care_provider_id", "type": "uuid", "references": "provider.provider_id" },
        { "name": "exchange_subscriber_id", "type": "string", "maxLength": 30 },
        { "name": "paid_through_date", "type": "date" }
      ]
    },
    {
      "name": "enrollment_rate",
      "description": "Premium rate for an enrollment over a period, with its split between employer, member and subsidy.",
      "primaryKey": ["enrollment_rate_id"],
      "attributes": [
        { "name": "enrollment_rate_id", "type": "uuid", "required": true },
        { "name": "enrollment_id", "type": "uuid", "required": true, "references": "enrollment.enrollment_id" },
        { "name": "effective_date", "type": "date", "required": true },
        { "name": "end_date", "type": "date" },
        { "name": "monthly_premium_amount", "type": "money", "required": true },
        { "name": "employer_contribution_amount", "type": "money" },
        { "name": "member_contribution_amount", "type": "money" },
        { "name": "advance_premium_tax_credit_amount", "type": "money", "description": "ACA APTC subsidy." },
        { "name": "rating_area", "type": "string", "maxLength": 20 },
        { "name": "rated_age", "type": "integer" },
        { "name": "tobacco_surcharge_amount", "type": "money" }
      ]
    },
    {
      "name": "provider",
      "description": "A health care practitioner, group or facility that renders or bills services.",
      "primaryKey": ["provider_id"],
      "attributes": [
        { "name": "provider_id", "type": "uuid", "required": true },
        { "name": "party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "npi", "type": "string", "maxLength": 10, "description": "National Provider Identifier." },
        { "name": "provider_type", "type": "string", "enum": "provider_type", "required": true },
        { "name": "taxonomy_code_value_id", "type": "uuid", "references": "code_value.code_value_id", "description": "NUCC health care provider taxonomy code." },
        { "name": "specialty", "type": "string", "maxLength": 100 },
        { "name": "billing_group_provider_id", "type": "uuid", "references": "provider.provider_id", "description": "Group practice the practitioner bills under." },
        { "name": "credentialed_on", "type": "date" },
        { "name": "recredential_due_on", "type": "date" },
        { "name": "is_accepting_new_patients", "type": "boolean" },
        { "name": "is_sanctioned", "type": "boolean", "description": "Excluded from federal programs (OIG/SAM)." }
      ]
    },
    {
      "name": "provider_network",
      "description": "A contracted network of providers that plans use to define in-network benefits.",
      "primaryKey": ["provider_network_id"],
      "unique": [["network_code"]],
      "attributes": [
        { "name": "provider_network_id", "type": "uuid", "required": true },
        { "name": "network_code", "type": "string", "maxLength": 30, "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "network_type", "type": "string", "maxLength": 30, "description": "MEDICAL, DENTAL, VISION, PHARMACY, BEHAVIORAL." },
        { "name": "is_leased", "type": "boolean", "description": "Rented from a third-party network." }
      ]
    },
    {
      "name": "network_participation",
      "description": "Participation of a provider in a network at a practice location over a period, with the reimbursement arrangement.",
      "primaryKey": ["network_participation_id"],
      "attributes": [
        { "name": "network_participation_id", "type": "uuid", "required": true },
        { "name": "provider_network_id", "type": "uuid", "required": true, "references": "provider_network.provider_network_id" },
        { "name": "provider_id", "type": "uuid", "required": true, "references": "provider.provider_id" },
        { "name": "practice_address_id", "type": "uuid", "references": "address.address_id" },
        { "name": "network_tier", "type": "string", "enum": "network_tier" },
        { "name": "contract_number", "type": "string", "maxLength": 50 },
        { "name": "reimbursement_method", "type": "string", "maxLength": 30, "description": "FEE_SCHEDULE, PERCENT_OF_CHARGES, PERCENT_OF_MEDICARE, DRG, PER_DIEM, CAPITATION, CASE_RATE." },
        { "name": "reimbursement_percent", "type": "percent" },
        { "name": "fee_schedule_code", "type": "string", "maxLength": 30 },
        { "name": "effective_date", "type": "date", "required": true },
        { "name": "termination_date", "type": "date" }
      ]
    },
    {
      "name": "prior_authorization",
      "description": "A request for approval of services before they are rendered, and the utilization management decision.",
      "primaryKey": ["prior_authorization_id"],
      "unique": [["authorization_number"]],
      "attributes": [
        { "name": "prior_authorization_id", "type": "uuid", "required": true },
        { "name": "authorization_number", "type": "string", "maxLength": 30, "required": true },
        { "name": "enrollment_id", "type": "uuid", "required": true, "references": "enrollment.enrollment_id" },
        { "name": "requesting_provider_id", "type": "uuid", "references": "provider.provider_id" },
        { "name": "servicing_provider_id", "type": "uuid", "references": "provider.provider_id" },
        { "name": "authorization_status", "type": "string", "enum": "authorization_status", "required": true },
        { "name": "service_type", "type": "string", "maxLength": 50, "description": "INPATIENT, OUTPATIENT_SURGERY, IMAGING, DME, SPECIALTY_DRUG, ..." },
        { "name": "is_urgent", "type": "boolean" },
        { "name": "procedure_code_value_id", "type": "uuid", "references": "code_value.code_value_id", "sensitivity": "PHI" },
        { "name": "diagnosis_code_value_id", "type": "uuid", "references": "code_value.code_value_id", "sensitivity": "PHI" },
        { "name": "requested_units", "type": "decimal" },
        { "name": "approved_units", "type": "decimal" },
        { "name": "requested_at", "type": "timestamp", "required": true },
        { "name": "decided_at", "type": "timestamp" },
        { "name": "valid_from", "type": "date" },
        { "name": "valid_to", "type": "date" },
        { "name": "denial_reason", "type": "string", "maxLength": 200 },
        { "name": "reviewer_staff_member_id", "type": "uuid", "references": "staff_member.staff_member_id" }
      ]
    },
    {
      "name": "health_claim",
      "description": "A claim for health care services submitted by a provider or member, as adjudicated. Adjustments are new claims that point to the claim they replace.",
      "primaryKey": ["health_claim_id"],
      "unique": [["claim_number"]],
      "attributes": [
        { "name": "health_claim_id", "type": "uuid", "required": true },
        { "name": "claim_number", "type": "string", "maxLength": 30, "required": true },
        { "name": "health_claim_type", "type": "string", "enum": "health_claim_type", "required": true },
        { "name": "health_claim_status", "type": "string", "enum": "health_claim_status", "required": true },
        { "name": "enrollment_id", "type": "uuid", "required": true, "references": "enrollment.enrollment_id", "description": "Coverage span of the patient the claim is adjudicated under." },
        { "name": "billing_provider_id", "type": "uuid", "references": "provider.provider_id" },
        { "name": "rendering_provider_id", "type": "uuid", "references": "provider.provider_id" },
        { "name": "facility_provider_id", "type": "uuid", "references": "provider.provider_id" },
        { "name": "referring_provider_id", "type": "uuid", "references": "provider.provider_id" },
        { "name": "network_tier", "type": "string", "enum": "network_tier" },
        { "name": "received_date", "type": "date", "required": true },
        { "name": "service_from_date", "type": "date", "required": true, "sensitivity": "PHI" },
        { "name": "service_to_date", "type": "date", "sensitivity": "PHI" },
        { "name": "admission_date", "type": "date", "sensitivity": "PHI" },
        { "name": "discharge_date", "type": "date", "sensitivity": "PHI" },
        { "name": "type_of_bill", "type": "string", "maxLength": 4, "description": "UB-04 type of bill." },
        { "name": "place_of_service_code", "type": "string", "maxLength": 2 },
        { "name": "drg_code_value_id", "type": "uuid", "references": "code_value.code_value_id", "sensitivity": "PHI" },
        { "name": "discharge_status_code", "type": "string", "maxLength": 2 },
        { "name": "claim_frequency_code", "type": "string", "maxLength": 1, "description": "1 original, 7 replacement, 8 void." },
        { "name": "replaces_health_claim_id", "type": "uuid", "references": "health_claim.health_claim_id" },
        { "name": "prior_authorization_id", "type": "uuid", "references": "prior_authorization.prior_authorization_id" },
        { "name": "submitter_claim_id", "type": "string", "maxLength": 50, "description": "Patient control number from the provider." },
        { "name": "billed_amount", "type": "money", "required": true },
        { "name": "allowed_amount", "type": "money" },
        { "name": "paid_amount", "type": "money" },
        { "name": "member_responsibility_amount", "type": "money" },
        { "name": "other_payer_paid_amount", "type": "money" },
        { "name": "adjudicated_at", "type": "timestamp" },
        { "name": "accounting_date", "type": "date" },
        { "name": "is_accident_related", "type": "boolean" },
        { "name": "accident_date", "type": "date" }
      ]
    },
    {
      "name": "health_claim_diagnosis",
      "description": "A diagnosis reported on a health claim.",
      "primaryKey": ["health_claim_diagnosis_id"],
      "unique": [["health_claim_id", "sequence_number"]],
      "attributes": [
        { "name": "health_claim_diagnosis_id", "type": "uuid", "required": true },
        { "name": "health_claim_id", "type": "uuid", "required": true, "references": "health_claim.health_claim_id" },
        { "name": "sequence_number", "type": "integer", "required": true },
        { "name": "diagnosis_code_value_id", "type": "uuid", "required": true, "references": "code_value.code_value_id", "sensitivity": "PHI", "description": "ICD-10-CM code." },
        { "name": "diagnosis_qualifier", "type": "string", "enum": "diagnosis_qualifier", "required": true },
        { "name": "present_on_admission", "type": "string", "maxLength": 1 }
      ]
    },
    {
      "name": "health_claim_line",
      "description": "A service line of a health claim with its adjudicated amounts.",
      "primaryKey": ["health_claim_line_id"],
      "unique": [["health_claim_id", "line_number"]],
      "attributes": [
        { "name": "health_claim_line_id", "type": "uuid", "required": true },
        { "name": "health_claim_id", "type": "uuid", "required": true, "references": "health_claim.health_claim_id" },
        { "name": "line_number", "type": "integer", "required": true },
        { "name": "claim_line_status", "type": "string", "enum": "claim_line_status", "required": true },
        { "name": "service_from_date", "type": "date", "required": true, "sensitivity": "PHI" },
        { "name": "service_to_date", "type": "date", "sensitivity": "PHI" },
        { "name": "procedure_code_value_id", "type": "uuid", "references": "code_value.code_value_id", "sensitivity": "PHI", "description": "CPT, HCPCS or CDT code." },
        { "name": "modifier_1", "type": "string", "maxLength": 2 },
        { "name": "modifier_2", "type": "string", "maxLength": 2 },
        { "name": "modifier_3", "type": "string", "maxLength": 2 },
        { "name": "modifier_4", "type": "string", "maxLength": 2 },
        { "name": "revenue_code", "type": "string", "maxLength": 4 },
        { "name": "ndc_code", "type": "string", "maxLength": 11, "sensitivity": "PHI", "description": "National Drug Code." },
        { "name": "tooth_number", "type": "string", "maxLength": 5 },
        { "name": "place_of_service_code", "type": "string", "maxLength": 2 },
        { "name": "diagnosis_pointers", "type": "string", "maxLength": 20, "description": "Sequence numbers of related diagnoses." },
        { "name": "rendering_provider_id", "type": "uuid", "references": "provider.provider_id" },
