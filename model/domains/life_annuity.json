{
  "domain": "life_annuity",
  "description": "Life insurance and annuity detail: contract attributes, insured lives and their underwriting classes, beneficiaries, medical underwriting cases, account values, funds, the contract-level financial ledger, loans, annuity payouts and life claims.",
  "enums": {
    "life_plan_type": { "description": "Kind of life insurance plan.", "values": ["TERM", "WHOLE_LIFE", "UNIVERSAL_LIFE", "INDEXED_UNIVERSAL_LIFE", "VARIABLE_UNIVERSAL_LIFE", "VARIABLE_LIFE", "FINAL_EXPENSE", "GROUP_TERM", "CREDIT_LIFE", "ENDOWMENT"] },
    "death_benefit_option": { "description": "Universal life death benefit option.", "values": { "LEVEL": "Option A / 1: face amount", "INCREASING": "Option B / 2: face amount plus account value", "RETURN_OF_PREMIUM": "Option C / 3: face amount plus premiums paid" } },
    "premium_mode": { "description": "Frequency of premium payment.", "values": ["ANNUAL", "SEMI_ANNUAL", "QUARTERLY", "MONTHLY", "BIWEEKLY", "WEEKLY", "SINGLE", "FLEXIBLE"] },
    "tax_qualification_type": { "description": "Tax status of a life or annuity contract.", "values": ["NON_QUALIFIED", "TRADITIONAL_IRA", "ROTH_IRA", "SEP_IRA", "SIMPLE_IRA", "INHERITED_IRA", "PLAN_401K", "PLAN_403B", "PLAN_457", "PENSION", "QLAC"] },
    "dividend_option": { "description": "Disposition of participating policy dividends.", "values": ["CASH", "PREMIUM_REDUCTION", "ACCUMULATE_AT_INTEREST", "PAID_UP_ADDITIONS", "ONE_YEAR_TERM", "LOAN_REDUCTION"] },
    "nonforfeiture_option": { "description": "Automatic option on lapse of a cash-value policy.", "values": ["CASH_SURRENDER", "REDUCED_PAID_UP", "EXTENDED_TERM", "AUTOMATIC_PREMIUM_LOAN"] },
    "insured_role": { "description": "Role of a life on a coverage.", "values": ["PRIMARY", "JOINT", "SPOUSE", "CHILD", "OTHER_INSURED"] },
    "tobacco_status": { "description": "Tobacco classification.", "values": ["NON_TOBACCO", "TOBACCO", "UNISMOKE"] },
    "beneficiary_class": { "description": "Order of entitlement of a beneficiary.", "values": ["PRIMARY", "CONTINGENT", "TERTIARY"] },
    "underwriting_case_status": { "description": "Status of a medical underwriting case.", "values": ["OPEN", "PENDING_REQUIREMENTS", "IN_REVIEW", "DECIDED", "ISSUED", "CLOSED_INCOMPLETE", "WITHDRAWN"] },
    "requirement_status": { "description": "Status of an underwriting requirement.", "values": ["ORDERED", "RECEIVED", "REVIEWED", "WAIVED", "CANCELLED"] },
    "fund_type": { "description": "Kind of investment option.", "values": ["FIXED_ACCOUNT", "VARIABLE_SUBACCOUNT", "INDEXED_STRATEGY", "MVA_GUARANTEE_PERIOD", "LOAN_COLLATERAL_ACCOUNT", "DOLLAR_COST_AVERAGING"] },
    "contract_financial_transaction_type": {
      "description": "Kind of movement in a life or annuity contract's values.",
      "values": { "PREMIUM": "Premium or deposit applied", "PREMIUM_LOAD": "", "COST_OF_INSURANCE": "", "RIDER_CHARGE": "", "ADMINISTRATIVE_CHARGE": "", "MORTALITY_EXPENSE_CHARGE": "", "INTEREST_CREDIT": "", "INDEX_CREDIT": "", "INVESTMENT_GAIN_LOSS": "", "DIVIDEND": "", "PARTIAL_WITHDRAWAL": "", "SYSTEMATIC_WITHDRAWAL": "", "REQUIRED_MINIMUM_DISTRIBUTION": "", "FULL_SURRENDER": "", "SURRENDER_CHARGE": "", "MARKET_VALUE_ADJUSTMENT": "", "LOAN": "", "LOAN_REPAYMENT": "", "LOAN_INTEREST": "", "FUND_TRANSFER": "", "ANNUITY_PAYMENT": "", "DEATH_BENEFIT": "", "MATURITY_BENEFIT": "", "EXCHANGE_IN": "1035 exchange or rollover received", "EXCHANGE_OUT": "", "BONUS_CREDIT": "", "TAX_WITHHOLDING": "" }
    },
    "annuity_type": { "description": "Kind of annuity.", "values": ["FIXED_DEFERRED", "MULTI_YEAR_GUARANTEED", "FIXED_INDEXED", "VARIABLE", "REGISTERED_INDEX_LINKED", "SINGLE_PREMIUM_IMMEDIATE", "DEFERRED_INCOME", "STRUCTURED_SETTLEMENT", "PENSION_RISK_TRANSFER"] },
    "annuity_phase": { "description": "Phase of an annuity contract.", "values": ["ACCUMULATION", "PAYOUT"] },
    "payout_option": { "description": "Form of annuity or settlement payout.", "values": ["LIFE_ONLY", "LIFE_WITH_PERIOD_CERTAIN", "PERIOD_CERTAIN", "JOINT_AND_SURVIVOR", "LIFE_WITH_CASH_REFUND", "LIFE_WITH_INSTALLMENT_REFUND", "LUMP_SUM", "INTEREST_ONLY", "FIXED_AMOUNT"] },
    "payout_status": { "description": "Status of a payout stream.", "values": ["PENDING", "ACTIVE", "SUSPENDED", "COMPLETED", "TERMINATED"] },
    "life_claim_type": { "description": "Kind of life or annuity claim.", "values": ["DEATH", "ACCIDENTAL_DEATH", "ACCELERATED_DEATH_BENEFIT", "WAIVER_OF_PREMIUM", "CRITICAL_ILLNESS", "LONG_TERM_CARE_RIDER", "ANNUITY_DEATH", "MATURITY"] },
    "manner_of_death": { "description": "Manner of death from the death certificate.", "values": ["NATURAL", "ACCIDENT", "SUICIDE", "HOMICIDE", "PENDING", "UNDETERMINED"] }
  },
  "entities": [
    {
      "name": "life_policy_detail",
      "description": "Life insurance specific attributes of a policy.",
      "subtypeOf": "policy",
      "primaryKey": ["policy_id"],
      "attributes": [
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "life_plan_type", "type": "string", "enum": "life_plan_type", "required": true },
        { "name": "face_amount", "type": "money", "required": true, "description": "Current base face amount." },
        { "name": "death_benefit_option", "type": "string", "enum": "death_benefit_option" },
        { "name": "premium_mode", "type": "string", "enum": "premium_mode", "required": true },
        { "name": "modal_premium_amount", "type": "money" },
        { "name": "planned_periodic_premium_amount", "type": "money", "description": "Planned premium for flexible-premium plans." },
        { "name": "level_term_period_years", "type": "integer" },
        { "name": "issue_date", "type": "date", "required": true },
        { "name": "maturity_date", "type": "date" },
        { "name": "paid_to_date", "type": "date" },
        { "name": "tax_qualification_type", "type": "string", "enum": "tax_qualification_type" },
        { "name": "is_participating", "type": "boolean" },
        { "name": "dividend_option", "type": "string", "enum": "dividend_option" },
        { "name": "nonforfeiture_option", "type": "string", "enum": "nonforfeiture_option" },
        { "name": "is_modified_endowment_contract", "type": "boolean", "description": "IRC 7702A MEC status." },
        { "name": "seven_pay_premium_amount", "type": "money" },
        { "name": "guideline_single_premium_amount", "type": "money", "description": "IRC 7702 guideline single premium." },
        { "name": "guideline_level_premium_amount", "type": "money" },
        { "name": "definition_of_life_insurance_test", "type": "string", "maxLength": 10, "description": "GPT or CVAT." },
        { "name": "contestability_end_date", "type": "date" },
        { "name": "suicide_exclusion_end_date", "type": "date" },
        { "name": "no_lapse_guarantee_end_date", "type": "date" },
        { "name": "is_replacement", "type": "boolean", "description": "Policy replaced existing coverage (replacement regulation applies)." }
      ]
    },
    {
      "name": "coverage_insured",
      "description": "A person whose life is insured under a coverage or rider, with the underwriting class assigned to them.",
      "primaryKey": ["coverage_insured_id"],
      "unique": [["policy_coverage_id", "party_id"]],
      "attributes": [
        { "name": "coverage_insured_id", "type": "uuid", "required": true },
        { "name": "policy_coverage_id", "type": "uuid", "required": true, "references": "policy_coverage.policy_coverage_id" },
        { "name": "party_id", "type": "uuid", "required": true, "references": "person.party_id" },
        { "name": "insured_role", "type": "string", "enum": "insured_role", "required": true },
        { "name": "issue_age", "type": "integer", "required": true },
        { "name": "age_basis", "type": "string", "maxLength": 20, "description": "AGE_NEAREST or AGE_LAST birthday." },
        { "name": "rated_gender", "type": "string", "enum": "gender" },
        { "name": "underwriting_class", "type": "string", "maxLength": 30, "sensitivity": "PHI", "description": "PREFERRED_PLUS, PREFERRED, STANDARD_PLUS, STANDARD, SUBSTANDARD, ..." },
        { "name": "tobacco_status", "type": "string", "enum": "tobacco_status", "sensitivity": "PHI" },
        { "name": "table_rating", "type": "string", "maxLength": 5, "sensitivity": "PHI", "description": "Substandard table (A-P or 1-16)." },
        { "name": "flat_extra_per_thousand", "type": "rate", "sensitivity": "PHI" },
        { "name": "flat_extra_end_date", "type": "date" }
      ]
    },
    {
      "name": "beneficiary_designation",
      "description": "Designation of a party to receive proceeds of a policy or a specific coverage.",
      "primaryKey": ["beneficiary_designation_id"],
      "attributes": [
        { "name": "beneficiary_designation_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "policy_coverage_id", "type": "uuid", "references": "policy_coverage.policy_coverage_id", "description": "Null when the designation covers the whole policy." },
        { "name": "party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "beneficiary_class", "type": "string", "enum": "beneficiary_class", "required": true },
        { "name": "share_percent", "type": "percent", "required": true },
        { "name": "relationship_to_insured", "type": "string", "maxLength": 30 },
        { "name": "is_irrevocable", "type": "boolean", "required": true },
        { "name": "is_per_stirpes", "type": "boolean" },
        { "name": "effective_date", "type": "date", "required": true },
        { "name": "end_date", "type": "date" },
        { "name": "designation_document_id", "type": "uuid", "references": "document.document_id" }
      ]
    },
    {
      "name": "underwriting_case",
      "description": "Medical and financial underwriting of one proposed insured for a life, disability or long-term care application.",
      "primaryKey": ["underwriting_case_id"],
      "attributes": [
        { "name": "underwriting_case_id", "type": "uuid", "required": true },
        { "name": "submission_id", "type": "uuid", "required": true, "references": "submission.submission_id" },
        { "name": "insured_party_id", "type": "uuid", "required": true, "references": "person.party_id" },
        { "name": "underwriting_case_status", "type": "string", "enum": "underwriting_case_status", "required": true },
        { "name": "requested_face_amount", "type": "money" },
        { "name": "is_accelerated_underwriting", "type": "boolean", "description": "Decided without fluids/exam using data and models." },
        { "name": "underwriter_staff_member_id", "type": "uuid", "references": "staff_member.staff_member_id" },
        { "name": "height_inches", "type": "decimal", "sensitivity": "PHI" },
        { "name": "weight_pounds", "type": "decimal", "sensitivity": "PHI" },
        { "name": "annual_income_amount", "type": "money", "sensitivity": "SPI" },
        { "name": "net_worth_amount", "type": "money", "sensitivity": "SPI" },
        { "name": "total_inforce_and_applied_amount", "type": "money", "description": "Coverage in force and applied for with all carriers." },
        { "name": "approved_underwriting_class", "type": "string", "maxLength": 30, "sensitivity": "PHI" },
        { "name": "approved_table_rating", "type": "string", "maxLength": 5, "sensitivity": "PHI" },
        { "name": "underwriting_decision_id", "type": "uuid", "references": "underwriting_decision.underwriting_decision_id" },
        { "name": "reinsurance_contract_id", "type": "uuid", "references": "reinsurance_contract.reinsurance_contract_id", "description": "Facultative reinsurer consulted, if any." }
      ]
    },
    {
      "name": "underwriting_requirement",
      "description": "A piece of evidence ordered for an underwriting case: paramedical exam, labs, attending physician statement, MIB check, prescription history, MVR, inspection report, financial statement.",
      "primaryKey": ["underwriting_requirement_id"],
      "attributes": [
        { "name": "underwriting_requirement_id", "type": "uuid", "required": true },
        { "name": "underwriting_case_id", "type": "uuid", "required": true, "references": "underwriting_case.underwriting_case_id" },
        { "name": "requirement_code", "type": "string", "maxLength": 30, "required": true, "description": "PARAMED, BLOOD, URINE, EKG, APS, MIB, RX, MVR, INSPECTION, FINANCIAL, ..." },
        { "name": "requirement_status", "type": "string", "enum": "requirement_status", "required": true },
        { "name": "vendor_party_id", "type": "uuid", "references": "party.party_id" },
        { "name": "ordered_on", "type": "date" },
        { "name": "received_on", "type": "date" },
        { "name": "result_summary", "type": "text", "sensitivity": "PHI" },
        { "name": "result_document_id", "type": "uuid", "references": "document.document_id" }
      ]
    },
    {
      "name": "investment_fund",
      "description": "An investment option available within life and annuity products: fixed account, variable subaccount or index crediting strategy.",
      "primaryKey": ["investment_fund_id"],
      "unique": [["fund_code"]],
      "attributes": [
        { "name": "investment_fund_id", "type": "uuid", "required": true },
        { "name": "fund_code", "type": "string", "maxLength": 30, "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "fund_type", "type": "string", "enum": "fund_type", "required": true },
        { "name": "underlying_cusip", "type": "string", "maxLength": 9 },
        { "name": "index_name", "type": "string", "maxLength": 100, "description": "Reference index for indexed strategies." },
        { "name": "crediting_method", "type": "string", "maxLength": 50, "description": "ANNUAL_POINT_TO_POINT, MONTHLY_AVERAGE, ... for indexed strategies." },
        { "name": "expense_ratio_percent", "type": "percent" },
        { "name": "opened_on", "type": "date" },
        { "name": "closed_on", "type": "date" }
      ]
    },
    {
      "name": "contract_fund_allocation",
      "description": "Standing instruction for how premiums, charges or rebalancing are allocated across funds in a contract.",
      "primaryKey": ["contract_fund_allocation_id"],
      "attributes": [
        { "name": "contract_fund_allocation_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "investment_fund_id", "type": "uuid", "required": true, "references": "investment_fund.investment_fund_id" },
        { "name": "allocation_purpose", "type": "string", "maxLength": 30, "required": true, "description": "PREMIUM, CHARGE_DEDUCTION, REBALANCE_TARGET." },
        { "name": "allocation_percent", "type": "percent", "required": true },
        { "name": "effective_date", "type": "date", "required": true },
        { "name": "end_date", "type": "date" }
      ]
    },
    {
      "name": "contract_fund_position",
      "description": "Holding of a contract in a fund as of a valuation date, including index strategy terms for the current segment.",
      "primaryKey": ["contract_fund_position_id"],
      "unique": [["policy_id", "investment_fund_id", "valuation_date", "segment_start_date"]],
      "attributes": [
        { "name": "contract_fund_position_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "investment_fund_id", "type": "uuid", "required": true, "references": "investment_fund.investment_fund_id" },
        { "name": "valuation_date", "type": "date", "required": true },
        { "name": "unit_count", "type": "decimal" },
        { "name": "unit_value", "type": "rate" },
        { "name": "position_value_amount", "type": "money", "required": true },
        { "name": "segment_start_date", "type": "date", "description": "Start of the index or guarantee segment." },
        { "name": "segment_end_date", "type": "date" },
        { "name": "credited_rate_percent", "type": "percent" },
        { "name": "cap_rate_percent", "type": "percent" },
        { "name": "participation_rate_percent", "type": "percent" },
        { "name": "spread_percent", "type": "percent" },
        { "name": "buffer_or_floor_percent", "type": "percent" }
      ]
    },
    {
      "name": "contract_value",
      "description": "Snapshot of a life or annuity contract's values on a valuation date (anniversary, month-end or on demand).",
      "primaryKey": ["contract_value_id"],
      "unique": [["policy_id", "valuation_date"]],
      "attributes": [
        { "name": "contract_value_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "valuation_date", "type": "date", "required": true },
        { "name": "account_value_amount", "type": "money" },
        { "name": "cash_surrender_value_amount", "type": "money" },
        { "name": "surrender_charge_amount", "type": "money" },
        { "name": "loan_balance_amount", "type": "money" },
        { "name": "death_benefit_amount", "type": "money" },
        { "name": "net_amount_at_risk_amount", "type": "money" },
        { "name": "cost_basis_amount", "type": "money", "description": "Investment in the contract for tax purposes." },
        { "name": "cumulative_premium_amount", "type": "money" },
        { "name": "paid_up_additions_face_amount", "type": "money" },
        { "name": "dividend_accumulation_amount", "type": "money" },
        { "name": "guaranteed_benefit_base_amount", "type": "money", "description": "Benefit base of a guaranteed living or death benefit rider." },
        { "name": "free_withdrawal_remaining_amount", "type": "money" }
      ]
    },
    {
      "name": "contract_financial_transaction",
      "description": "The ledger of money moving into, out of and within a life or annuity contract: premiums applied, charges, interest and index credits, withdrawals, loans, transfers and benefits.",
      "primaryKey": ["contract_financial_transaction_id"],
      "attributes": [
        { "name": "contract_financial_transaction_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "contract_financial_transaction_type", "type": "string", "enum": "contract_financial_transaction_type", "required": true },
        { "name": "amount", "type": "money", "required": true, "description": "Signed: positive increases contract value." },
        { "name": "effective_date", "type": "date", "required": true },
        { "name": "processed_at", "type": "timestamp", "required": true },
        { "name": "accounting_date", "type": "date" },
        { "name": "investment_fund_id", "type": "uuid", "references": "investment_fund.investment_fund_id" },
        { "name": "unit_count", "type": "decimal" },
        { "name": "unit_value", "type": "rate" },
        { "name": "policy_coverage_id", "type": "uuid", "references": "policy_coverage.policy_coverage_id", "description": "Coverage or rider a charge relates to." },
        { "name": "policy_transaction_id", "type": "uuid", "references": "policy_transaction.policy_transaction_id" },
        { "name": "contract_loan_id", "type": "uuid", "references": "contract_loan.contract_loan_id" },
        { "name": "payment_id", "type": "uuid", "references": "payment.payment_id", "description": "Incoming payment that funded the transaction." },
        { "name": "disbursement_id", "type": "uuid", "references": "disbursement.disbursement_id", "description": "Outgoing payment that settled the transaction." },
        { "name": "taxable_amount", "type": "money" },
        { "name": "federal_withholding_amount", "type": "money" },
        { "name": "state_withholding_amount", "type": "money" },
        { "name": "tax_distribution_code", "type": "string", "maxLength": 5, "description": "IRS Form 1099-R distribution code." },
        { "name": "reverses_transaction_id", "type": "uuid", "references": "contract_financial_transaction.contract_financial_transaction_id" }
      ]
    },
    {
      "name": "contract_loan",
      "description": "A loan taken against the cash value of a contract.",
      "primaryKey": ["contract_loan_id"],
      "attributes": [
        { "name": "contract_loan_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "loan_number", "type": "integer", "required": true },
        { "name": "loan_type", "type": "string", "maxLength": 30, "description": "STANDARD, PREFERRED, AUTOMATIC_PREMIUM_LOAN." },
        { "name": "principal_amount", "type": "money", "required": true },
        { "name": "interest_rate_percent", "type": "percent", "required": true },
        { "name": "is_variable_rate", "type": "boolean" },
        { "name": "interest_in_advance", "type": "boolean" },
        { "name": "originated_on", "type": "date", "required": true },
        { "name": "repaid_on", "type": "date" }
      ]
    },
    {
      "name": "annuity_contract_detail",
      "description": "Annuity specific attributes of a policy.",
      "subtypeOf": "policy",
      "primaryKey": ["policy_id"],
      "attributes": [
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "annuity_type", "type": "string", "enum": "annuity_type", "required": true },
        { "name": "annuity_phase", "type": "string", "enum": "annuity_phase", "required": true },
        { "name": "tax_qualification_type", "type": "string", "enum": "tax_qualification_type", "required": true },
        { "name": "issue_date", "type": "date", "required": true },
        { "name": "is_flexible_premium", "type": "boolean" },
        { "name": "initial_premium_amount", "type": "money" },
        { "name": "maturity_date", "type": "date", "description": "Latest annuitization date." },
        { "name": "annuitization_date", "type": "date" },
        { "name": "guaranteed_minimum_interest_percent", "type": "percent" },
        { "name": "initial_guarantee_period_years", "type": "integer" },
        { "name": "surrender_charge_period_years", "type": "integer" },
        { "name": "surrender_charge_end_date", "type": "date" },
        { "name": "free_withdrawal_percent", "type": "percent" },
        { "name": "has_market_value_adjustment", "type": "boolean" },
        { "name": "premium_bonus_percent", "type": "percent" },
        { "name": "rmd_start_date", "type": "date", "description": "Required beginning date for minimum distributions." },
        { "name": "is_replacement", "type": "boolean" },
        { "name": "suitability_reviewed_on", "type": "date", "description": "Best-interest / suitability review completed." }
      ]
    },
    {
      "name": "annuity_payout",
      "description": "A stream of periodic payments from an annuitized contract, an immediate annuity, a structured settlement or a settlement option on life proceeds.",
      "primaryKey": ["annuity_payout_id"],
      "attributes": [
        { "name": "annuity_payout_id", "type": "uuid", "required": true },
        { "name": "policy_id", "type": "uuid", "required": true, "references": "policy.policy_id" },
        { "name": "payee_party_id", "type": "uuid", "required": true, "references": "party.party_id" },
        { "name": "payout_option", "type": "string", "enum": "payout_option", "required": true },
        { "name": "payout_status", "type": "string", "enum": "payout_status", "required": true },
        { "name": "payment_frequency", "type": "string", "enum": "premium_mode", "required": true },
        { "name": "payment_amount", "type": "money", "required": true },
        { "name": "start_date", "type": "date", "required": true },
        { "name": "certain_period_months", "type": "integer" },
        { "name": "certain_period_end_date", "type": "date" },
        { "name": "survivor_percent", "type": "percent", "description": "Share continuing to the survivor under joint options." },
