{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract_fund_allocation",
  "description": "Standing instruction for how premiums, charges or rebalancing are allocated across funds in a contract.",
  "type": "object",
  "x-primaryKey": ["contract_fund_allocation_id"],
  "required": [
    "contract_fund_allocation_id", "policy_id", "investment_fund_id", "allocation_purpose", "allocation_percent",
    "effective_date"
  ],
  "properties": {
    "contract_fund_allocation_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "investment_fund_id": { "type": "string", "format": "uuid", "x-references": "investment_fund.investment_fund_id" },
    "allocation_purpose": { "type": "string", "maxLength": 30, "description": "PREMIUM, CHARGE_DEDUCTION, REBALANCE_TARGET." },
    "allocation_percent": { "type": "number", "format": "percent" },
    "effective_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
