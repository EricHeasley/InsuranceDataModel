{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "life_policy_detail",
  "description": "Life insurance specific attributes of a policy.",
  "type": "object",
  "x-primaryKey": ["policy_id"],
  "x-subtypeOf": "policy",
  "required": ["policy_id", "life_plan_type", "face_amount", "premium_mode", "issue_date"],
  "properties": {
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "life_plan_type": {
      "type": "string",
      "enum": [
        "TERM", "WHOLE_LIFE", "UNIVERSAL_LIFE", "INDEXED_UNIVERSAL_LIFE", "VARIABLE_UNIVERSAL_LIFE", "VARIABLE_LIFE",
        "FINAL_EXPENSE", "GROUP_TERM", "CREDIT_LIFE", "ENDOWMENT"
      ]
    },
    "face_amount": { "type": "number", "format": "money", "description": "Current base face amount." },
    "death_benefit_option": {
      "type": "string",
      "oneOf": [
        { "const": "LEVEL", "description": "Option A / 1: face amount" },
        { "const": "INCREASING", "description": "Option B / 2: face amount plus account value" },
        { "const": "RETURN_OF_PREMIUM", "description": "Option C / 3: face amount plus premiums paid" }
      ]
    },
    "premium_mode": {
      "type": "string",
      "enum": ["ANNUAL", "SEMI_ANNUAL", "QUARTERLY", "MONTHLY", "BIWEEKLY", "WEEKLY", "SINGLE", "FLEXIBLE"]
    },
    "modal_premium_amount": { "type": "number", "format": "money" },
    "planned_periodic_premium_amount": { "type": "number", "format": "money", "description": "Planned premium for flexible-premium plans." },
    "level_term_period_years": { "type": "integer" },
    "issue_date": { "type": "string", "format": "date" },
    "maturity_date": { "type": "string", "format": "date" },
    "paid_to_date": { "type": "string", "format": "date" },
    "tax_qualification_type": {
      "type": "string",
      "enum": [
        "NON_QUALIFIED", "TRADITIONAL_IRA", "ROTH_IRA", "SEP_IRA", "SIMPLE_IRA", "INHERITED_IRA", "PLAN_401K",
        "PLAN_403B", "PLAN_457", "PENSION", "QLAC"
      ]
    },
    "is_participating": { "type": "boolean" },
    "dividend_option": {
      "type": "string",
      "enum": ["CASH", "PREMIUM_REDUCTION", "ACCUMULATE_AT_INTEREST", "PAID_UP_ADDITIONS", "ONE_YEAR_TERM", "LOAN_REDUCTION"]
    },
    "nonforfeiture_option": { "type": "string", "enum": ["CASH_SURRENDER", "REDUCED_PAID_UP", "EXTENDED_TERM", "AUTOMATIC_PREMIUM_LOAN"] },
    "is_modified_endowment_contract": { "type": "boolean", "description": "IRC 7702A MEC status." },
    "seven_pay_premium_amount": { "type": "number", "format": "money" },
    "guideline_single_premium_amount": { "type": "number", "format": "money", "description": "IRC 7702 guideline single premium." },
    "guideline_level_premium_amount": { "type": "number", "format": "money" },
    "definition_of_life_insurance_test": { "type": "string", "maxLength": 10, "description": "GPT or CVAT." },
    "contestability_end_date": { "type": "string", "format": "date" },
    "suicide_exclusion_end_date": { "type": "string", "format": "date" },
    "no_lapse_guarantee_end_date": { "type": "string", "format": "date" },
    "is_replacement": { "type": "boolean", "description": "Policy replaced existing coverage (replacement regulation applies)." }
  },
  "additionalProperties": false
}
