{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract_financial_transaction",
  "description": "The ledger of money moving into, out of and within a life or annuity contract: premiums applied, charges, interest and index credits, withdrawals, loans, transfers and benefits.",
  "type": "object",
  "x-primaryKey": ["contract_financial_transaction_id"],
  "required": [
    "contract_financial_transaction_id", "policy_id", "contract_financial_transaction_type", "amount",
    "effective_date", "processed_at"
  ],
  "properties": {
    "contract_financial_transaction_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "contract_financial_transaction_type": {
      "type": "string",
      "oneOf": [
        { "const": "PREMIUM", "description": "Premium or deposit applied" },
        { "const": "PREMIUM_LOAD" },
        { "const": "COST_OF_INSURANCE" },
        { "const": "RIDER_CHARGE" },
        { "const": "ADMINISTRATIVE_CHARGE" },
        { "const": "MORTALITY_EXPENSE_CHARGE" },
        { "const": "INTEREST_CREDIT" },
        { "const": "INDEX_CREDIT" },
        { "const": "INVESTMENT_GAIN_LOSS" },
        { "const": "DIVIDEND" },
        { "const": "PARTIAL_WITHDRAWAL" },
        { "const": "SYSTEMATIC_WITHDRAWAL" },
        { "const": "REQUIRED_MINIMUM_DISTRIBUTION" },
        { "const": "FULL_SURRENDER" },
        { "const": "SURRENDER_CHARGE" },
        { "const": "MARKET_VALUE_ADJUSTMENT" },
        { "const": "LOAN" },
        { "const": "LOAN_REPAYMENT" },
        { "const": "LOAN_INTEREST" },
        { "const": "FUND_TRANSFER" },
        { "const": "ANNUITY_PAYMENT" },
        { "const": "DEATH_BENEFIT" },
        { "const": "MATURITY_BENEFIT" },
        { "const": "EXCHANGE_IN", "description": "1035 exchange or rollover received" },
        { "const": "EXCHANGE_OUT" },
        { "const": "BONUS_CREDIT" },
        { "const": "TAX_WITHHOLDING" }
      ]
    },
    "amount": { "type": "number", "format": "money", "description": "Signed: positive increases contract value." },
    "effective_date": { "type": "string", "format": "date" },
    "processed_at": { "type": "string", "format": "date-time" },
    "accounting_date": { "type": "string", "format": "date" },
    "investment_fund_id": { "type": "string", "format": "uuid", "x-references": "investment_fund.investment_fund_id" },
    "unit_count": { "type": "number", "format": "decimal" },
    "unit_value": { "type": "number", "format": "rate" },
    "policy_coverage_id": {
      "type": "string",
      "format": "uuid",
      "description": "Coverage or rider a charge relates to.",
      "x-references": "policy_coverage.policy_coverage_id"
    },
    "policy_transaction_id": { "type": "string", "format": "uuid", "x-references": "policy_transaction.policy_transaction_id" },
    "contract_loan_id": { "type": "string", "format": "uuid", "x-references": "contract_loan.contract_loan_id" },
    "payment_id": {
      "type": "string",
      "format": "uuid",
      "description": "Incoming payment that funded the transaction.",
      "x-references": "payment.payment_id"
    },
    "disbursement_id": {
      "type": "string",
      "format": "uuid",
      "description": "Outgoing payment that settled the transaction.",
      "x-references": "disbursement.disbursement_id"
    },
    "taxable_amount": { "type": "number", "format": "money" },
    "federal_withholding_amount": { "type": "number", "format": "money" },
    "state_withholding_amount": { "type": "number", "format": "money" },
    "tax_distribution_code": { "type": "string", "maxLength": 5, "description": "IRS Form 1099-R distribution code." },
    "reverses_transaction_id": {
      "type": "string",
      "format": "uuid",
      "x-references": "contract_financial_transaction.contract_financial_transaction_id"
    }
  },
  "additionalProperties": false
}
