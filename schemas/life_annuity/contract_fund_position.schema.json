{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract_fund_position",
  "description": "Holding of a contract in a fund as of a valuation date, including index strategy terms for the current segment.",
  "type": "object",
  "x-primaryKey": ["contract_fund_position_id"],
  "x-unique": [
    ["policy_id", "investment_fund_id", "valuation_date", "segment_start_date"]
  ],
  "required": ["contract_fund_position_id", "policy_id", "investment_fund_id", "valuation_date", "position_value_amount"],
  "properties": {
    "contract_fund_position_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "investment_fund_id": { "type": "string", "format": "uuid", "x-references": "investment_fund.investment_fund_id" },
    "valuation_date": { "type": "string", "format": "date" },
    "unit_count": { "type": "number", "format": "decimal" },
    "unit_value": { "type": "number", "format": "rate" },
    "position_value_amount": { "type": "number", "format": "money" },
    "segment_start_date": { "type": "string", "format": "date", "description": "Start of the index or guarantee segment." },
    "segment_end_date": { "type": "string", "format": "date" },
    "credited_rate_percent": { "type": "number", "format": "percent" },
    "cap_rate_percent": { "type": "number", "format": "percent" },
    "participation_rate_percent": { "type": "number", "format": "percent" },
    "spread_percent": { "type": "number", "format": "percent" },
    "buffer_or_floor_percent": { "type": "number", "format": "percent" }
  },
  "additionalProperties": false
}
