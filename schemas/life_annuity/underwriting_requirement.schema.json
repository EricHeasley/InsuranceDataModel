{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "underwriting_requirement",
  "description": "A piece of evidence ordered for an underwriting case: paramedical exam, labs, attending physician statement, MIB check, prescription history, MVR, inspection report, financial statement.",
  "type": "object",
  "x-primaryKey": ["underwriting_requirement_id"],
  "required": ["underwriting_requirement_id", "underwriting_case_id", "requirement_code", "requirement_status"],
  "properties": {
    "underwriting_requirement_id": { "type": "string", "format": "uuid" },
    "underwriting_case_id": { "type": "string", "format": "uuid", "x-references": "underwriting_case.underwriting_case_id" },
    "requirement_code": {
      "type": "string",
      "maxLength": 30,
      "description": "PARAMED, BLOOD, URINE, EKG, APS, MIB, RX, MVR, INSPECTION, FINANCIAL, ..."
    },
    "requirement_status": { "type": "string", "enum": ["ORDERED", "RECEIVED", "REVIEWED", "WAIVED", "CANCELLED"] },
    "vendor_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "ordered_on": { "type": "string", "format": "date" },
    "received_on": { "type": "string", "format": "date" },
    "result_summary": { "type": "string", "x-sensitivity": "PHI" },
    "result_document_id": { "type": "string", "format": "uuid", "x-references": "document.document_id" }
  },
  "additionalProperties": false
}
