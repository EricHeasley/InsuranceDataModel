{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beneficiary_designation",
  "description": "Designation of a party to receive proceeds of a policy or a specific coverage.",
  "type": "object",
  "x-primaryKey": ["beneficiary_designation_id"],
  "required": [
    "beneficiary_designation_id", "policy_id", "party_id", "beneficiary_class", "share_percent", "is_irrevocable",
    "effective_date"
  ],
  "properties": {
    "beneficiary_designation_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "policy_coverage_id": {
      "type": "string",
      "format": "uuid",
      "description": "Null when the designation covers the whole policy.",
      "x-references": "policy_coverage.policy_coverage_id"
    },
    "party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "beneficiary_class": { "type": "string", "enum": ["PRIMARY", "CONTINGENT", "TERTIARY"] },
    "share_percent": { "type": "number", "format": "percent" },
    "relationship_to_insured": { "type": "string", "maxLength": 30 },
    "is_irrevocable": { "type": "boolean" },
    "is_per_stirpes": { "type": "boolean" },
    "effective_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "designation_document_id": { "type": "string", "format": "uuid", "x-references": "document.document_id" }
  },
  "additionalProperties": false
}
