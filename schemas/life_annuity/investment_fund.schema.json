{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "investment_fund",
  "description": "An investment option available within life and annuity products: fixed account, variable subaccount or index crediting strategy.",
  "type": "object",
  "x-primaryKey": ["investment_fund_id"],
  "x-unique": [
    ["fund_code"]
  ],
  "required": ["investment_fund_id", "fund_code", "name", "fund_type"],
  "properties": {
    "investment_fund_id": { "type": "string", "format": "uuid" },
    "fund_code": { "type": "string", "maxLength": 30 },
    "name": { "type": "string", "maxLength": 255 },
    "fund_type": {
      "type": "string",
      "enum": [
        "FIXED_ACCOUNT", "VARIABLE_SUBACCOUNT", "INDEXED_STRATEGY", "MVA_GUARANTEE_PERIOD", "LOAN_COLLATERAL_ACCOUNT",
        "DOLLAR_COST_AVERAGING"
      ]
    },
    "underlying_cusip": { "type": "string", "maxLength": 9 },
    "index_name": { "type": "string", "maxLength": 100, "description": "Reference index for indexed strategies." },
    "crediting_method": {
      "type": "string",
      "maxLength": 50,
      "description": "ANNUAL_POINT_TO_POINT, MONTHLY_AVERAGE, ... for indexed strategies."
    },
    "expense_ratio_percent": { "type": "number", "format": "percent" },
    "opened_on": { "type": "string", "format": "date" },
    "closed_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
