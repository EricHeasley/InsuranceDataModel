{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage_insured",
  "description": "A person whose life is insured under a coverage or rider, with the underwriting class assigned to them.",
  "type": "object",
  "x-primaryKey": ["coverage_insured_id"],
  "x-unique": [
    ["policy_coverage_id", "party_id"]
  ],
  "required": ["coverage_insured_id", "policy_coverage_id", "party_id", "insured_role", "issue_age"],
  "properties": {
    "coverage_insured_id": { "type": "string", "format": "uuid" },
    "policy_coverage_id": { "type": "string", "format": "uuid", "x-references": "policy_coverage.policy_coverage_id" },
    "party_id": { "type": "string", "format": "uuid", "x-references": "person.party_id" },
    "insured_role": { "type": "string", "enum": ["PRIMARY", "JOINT", "SPOUSE", "CHILD", "OTHER_INSURED"] },
    "issue_age": { "type": "integer" },
    "age_basis": { "type": "string", "maxLength": 20, "description": "AGE_NEAREST or AGE_LAST birthday." },
    "rated_gender": { "type": "string", "enum": ["FEMALE", "MALE", "NONBINARY", "UNKNOWN"] },
    "underwriting_class": {
      "type": "string",
      "maxLength": 30,
      "description": "PREFERRED_PLUS, PREFERRED, STANDARD_PLUS, STANDARD, SUBSTANDARD, ...",
      "x-sensitivity": "PHI"
    },
    "tobacco_status": { "type": "string", "enum": ["NON_TOBACCO", "TOBACCO", "UNISMOKE"], "x-sensitivity": "PHI" },
    "table_rating": { "type": "string", "maxLength": 5, "description": "Substandard table (A-P or 1-16).", "x-sensitivity": "PHI" },
    "flat_extra_per_thousand": { "type": "number", "format": "rate", "x-sensitivity": "PHI" },
    "flat_extra_end_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
