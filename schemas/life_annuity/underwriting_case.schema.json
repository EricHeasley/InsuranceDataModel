{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "underwriting_case",
  "description": "Medical and financial underwriting of one proposed insured for a life, disability or long-term care application.",
  "type": "object",
  "x-primaryKey": ["underwriting_case_id"],
  "required": ["underwriting_case_id", "submission_id", "insured_party_id", "underwriting_case_status"],
  "properties": {
    "underwriting_case_id": { "type": "string", "format": "uuid" },
    "submission_id": { "type": "string", "format": "uuid", "x-references": "submission.submission_id" },
    "insured_party_id": { "type": "string", "format": "uuid", "x-references": "person.party_id" },
    "underwriting_case_status": {
      "type": "string",
      "enum": ["OPEN", "PENDING_REQUIREMENTS", "IN_REVIEW", "DECIDED", "ISSUED", "CLOSED_INCOMPLETE", "WITHDRAWN"]
    },
    "requested_face_amount": { "type": "number", "format": "money" },
    "is_accelerated_underwriting": { "type": "boolean", "description": "Decided without fluids/exam using data and models." },
    "underwriter_staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "height_inches": { "type": "number", "format": "decimal", "x-sensitivity": "PHI" },
    "weight_pounds": { "type": "number", "format": "decimal", "x-sensitivity": "PHI" },
    "annual_income_amount": { "type": "number", "format": "money", "x-sensitivity": "SPI" },
    "net_worth_amount": { "type": "number", "format": "money", "x-sensitivity": "SPI" },
    "total_inforce_and_applied_amount": { "type": "number", "format": "money", "description": "Coverage in force and applied for with all carriers." },
    "approved_underwriting_class": { "type": "string", "maxLength": 30, "x-sensitivity": "PHI" },
    "approved_table_rating": { "type": "string", "maxLength": 5, "x-sensitivity": "PHI" },
    "underwriting_decision_id": { "type": "string", "format": "uuid", "x-references": "underwriting_decision.underwriting_decision_id" },
    "reinsurance_contract_id": {
      "type": "string",
      "format": "uuid",
      "description": "Facultative reinsurer consulted, if any.",
      "x-references": "reinsurance_contract.reinsurance_contract_id"
    }
  },
  "additionalProperties": false
}
