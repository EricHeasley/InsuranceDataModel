{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "annuity_payout",
  "description": "A stream of periodic payments from an annuitized contract, an immediate annuity, a structured settlement or a settlement option on life proceeds.",
  "type": "object",
  "x-primaryKey": ["annuity_payout_id"],
  "required": [
    "annuity_payout_id", "policy_id", "payee_party_id", "payout_option", "payout_status", "payment_frequency",
    "payment_amount", "start_date"
  ],
  "properties": {
    "annuity_payout_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "payee_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "payout_option": {
      "type": "string",
      "enum": [
        "LIFE_ONLY", "LIFE_WITH_PERIOD_CERTAIN", "PERIOD_CERTAIN", "JOINT_AND_SURVIVOR", "LIFE_WITH_CASH_REFUND",
        "LIFE_WITH_INSTALLMENT_REFUND", "LUMP_SUM", "INTEREST_ONLY", "FIXED_AMOUNT"
      ]
    },
    "payout_status": { "type": "string", "enum": ["PENDING", "ACTIVE", "SUSPENDED", "COMPLETED", "TERMINATED"] },
    "payment_frequency": {
      "type": "string",
      "enum": ["ANNUAL", "SEMI_ANNUAL", "QUARTERLY", "MONTHLY", "BIWEEKLY", "WEEKLY", "SINGLE", "FLEXIBLE"]
    },
    "payment_amount": { "type": "number", "format": "money" },
    "start_date": { "type": "string", "format": "date" },
    "certain_period_months": { "type": "integer" },
    "certain_period_end_date": { "type": "string", "format": "date" },
    "survivor_percent": { "type": "number", "format": "percent", "description": "Share continuing to the survivor under joint options." },
    "annual_increase_percent": { "type": "number", "format": "percent", "description": "Cost-of-living adjustment." },
    "exclusion_ratio_percent": { "type": "number", "format": "percent", "description": "Non-taxable share of each payment." },
    "end_date": { "type": "string", "format": "date" },
    "payment_instrument_id": { "type": "string", "format": "uuid", "x-references": "payment_instrument.payment_instrument_id" }
  },
  "additionalProperties": false
}
