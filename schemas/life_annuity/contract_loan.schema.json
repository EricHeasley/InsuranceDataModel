{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract_loan",
  "description": "A loan taken against the cash value of a contract.",
  "type": "object",
  "x-primaryKey": ["contract_loan_id"],
  "required": ["contract_loan_id", "policy_id", "loan_number", "principal_amount", "interest_rate_percent", "originated_on"],
  "properties": {
    "contract_loan_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "loan_number": { "type": "integer" },
    "loan_type": { "type": "string", "maxLength": 30, "description": "STANDARD, PREFERRED, AUTOMATIC_PREMIUM_LOAN." },
    "principal_amount": { "type": "number", "format": "money" },
    "interest_rate_percent": { "type": "number", "format": "percent" },
    "is_variable_rate": { "type": "boolean" },
    "interest_in_advance": { "type": "boolean" },
    "originated_on": { "type": "string", "format": "date" },
    "repaid_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
