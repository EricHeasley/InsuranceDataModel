{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "annual_statement_line",
  "description": "NAIC annual statement line of business (e.g. 19.2 Other Private Passenger Auto Liability) used for statutory reporting such as Schedule P and the state page.",
  "type": "object",
  "x-primaryKey": ["asl_code"],
  "required": ["asl_code", "name", "statement_type"],
  "properties": {
    "asl_code": { "type": "string", "maxLength": 10 },
    "name": { "type": "string", "maxLength": 255 },
    "statement_type": {
      "type": "string",
      "oneOf": [
        { "const": "PC", "description": "Property/Casualty blank" },
        { "const": "LIFE", "description": "Life, Accident & Health blank" },
        { "const": "HEALTH", "description": "Health blank" }
      ]
    }
  },
  "additionalProperties": false
}
