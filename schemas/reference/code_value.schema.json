{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "code_value",
  "description": "A single code within a code set.",
  "type": "object",
  "x-primaryKey": ["code_value_id"],
  "x-unique": [
    ["code_set_id", "code"]
  ],
  "required": ["code_value_id", "code_set_id", "code"],
  "properties": {
    "code_value_id": { "type": "string", "format": "uuid" },
    "code_set_id": { "type": "string", "format": "uuid", "x-references": "code_set.code_set_id" },
    "code": { "type": "string", "maxLength": 30 },
    "description": { "type": "string" },
    "parent_code_value_id": { "type": "string", "format": "uuid", "x-references": "code_value.code_value_id" },
    "valid_from": { "type": "string", "format": "date" },
    "valid_to": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
