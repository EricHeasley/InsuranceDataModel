{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "currency",
  "description": "ISO 4217 currency.",
  "type": "object",
  "x-primaryKey": ["currency_code"],
  "required": ["currency_code", "name", "minor_units"],
  "properties": {
    "currency_code": { "type": "string", "maxLength": 3, "description": "ISO 4217 alphabetic code." },
    "name": { "type": "string", "maxLength": 255 },
    "minor_units": { "type": "integer", "description": "Number of decimal places." }
  },
  "additionalProperties": false
}
