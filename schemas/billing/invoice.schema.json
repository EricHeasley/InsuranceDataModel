{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice",
  "description": "A bill or installment notice issued on a billing account.",
  "type": "object",
  "x-primaryKey": ["invoice_id"],
  "x-unique": [
    ["invoice_number"]
  ],
  "required": ["invoice_id", "billing_account_id", "invoice_number", "invoice_status", "invoice_date", "due_date", "total_amount"],
  "properties": {
    "invoice_id": { "type": "string", "format": "uuid" },
    "billing_account_id": { "type": "string", "format": "uuid", "x-references": "billing_account.billing_account_id" },
    "invoice_number": { "type": "string", "maxLength": 30 },
    "invoice_status": {
      "type": "string",
      "enum": ["PLANNED", "BILLED", "PARTIALLY_PAID", "PAID", "PAST_DUE", "CANCELLED", "WRITTEN_OFF"]
    },
    "invoice_date": { "type": "string", "format": "date" },
    "due_date": { "type": "string", "format": "date" },
    "period_start_date": { "type": "string", "format": "date" },
    "period_end_date": { "type": "string", "format": "date" },
    "total_amount": { "type": "number", "format": "money" },
    "document_id": { "type": "string", "format": "uuid", "x-references": "document.document_id" }
  },
  "additionalProperties": false
}
