{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payment",
  "description": "Money received from or on behalf of a payor.",
  "type": "object",
  "x-primaryKey": ["payment_id"],
  "required": ["payment_id", "payment_method", "payment_status", "amount", "received_at"],
  "properties": {
    "payment_id": { "type": "string", "format": "uuid" },
    "billing_account_id": {
      "type": "string",
      "format": "uuid",
      "description": "Null while unidentified cash sits in suspense.",
      "x-references": "billing_account.billing_account_id"
    },
    "payer_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "payment_method": {
      "type": "string",
      "enum": [
        "ACH", "CREDIT_CARD", "DEBIT_CARD", "CHECK", "WIRE", "CASH", "LOCKBOX", "DIGITAL_WALLET", "VIRTUAL_CARD",
        "PUSH_TO_DEBIT", "INTERNAL_TRANSFER"
      ]
    },
    "payment_status": { "type": "string", "enum": ["PENDING", "SETTLED", "RETURNED", "REVERSED", "REFUNDED", "SUSPENSE"] },
    "payment_instrument_id": { "type": "string", "format": "uuid", "x-references": "payment_instrument.payment_instrument_id" },
    "amount": { "type": "number", "format": "money" },
    "received_at": { "type": "string", "format": "date-time" },
    "deposit_date": { "type": "string", "format": "date" },
    "accounting_date": { "type": "string", "format": "date" },
    "reference_number": { "type": "string", "maxLength": 50, "description": "Check number, processor transaction ID or trace number." },
    "batch_number": { "type": "string", "maxLength": 50 },
    "reverses_payment_id": { "type": "string", "format": "uuid", "x-references": "payment.payment_id" },
    "return_reason_code": { "type": "string", "maxLength": 20, "description": "ACH return or chargeback reason." }
  },
  "additionalProperties": false
}
