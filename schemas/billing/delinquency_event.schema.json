{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delinquency_event",
  "description": "A step in handling a past-due account, such as a notice of cancellation for non-payment.",
  "type": "object",
  "x-primaryKey": ["delinquency_event_id"],
  "required": ["delinquency_event_id", "billing_account_id", "delinquency_event_type", "event_date"],
  "properties": {
    "delinquency_event_id": { "type": "string", "format": "uuid" },
    "billing_account_id": { "type": "string", "format": "uuid", "x-references": "billing_account.billing_account_id" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "delinquency_event_type": {
      "type": "string",
      "enum": [
        "PAST_DUE_NOTICE", "NOTICE_OF_CANCELLATION", "GRACE_PERIOD_START", "CANCELLATION_REQUESTED", "LAPSE_NOTICE",
        "COLLECTIONS_REFERRAL", "CURED"
      ]
    },
    "event_date": { "type": "string", "format": "date" },
    "past_due_amount": { "type": "number", "format": "money" },
    "cure_by_date": { "type": "string", "format": "date", "description": "Date by which payment avoids cancellation or lapse." },
    "notice_document_id": { "type": "string", "format": "uuid", "x-references": "document.document_id" },
    "policy_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Resulting cancellation or lapse transaction.",
      "x-references": "policy_transaction.policy_transaction_id"
    }
  },
  "additionalProperties": false
}
