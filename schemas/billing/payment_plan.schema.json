{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/billing/payment_plan.schema.json",
  "title": "payment_plan",
  "description": "An installment schedule offered to payors.",
  "x-primaryKey": ["payment_plan_id"],
  "x-unique": [
    ["plan_code"]
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "payment_plan_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "plan_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 30
    },
    "name": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 255
    },
    "billing_frequency": {
      "$ref": "enums/billing_frequency.schema.json"
    },
    "installment_count": {
      "$ref": "../common/types.schema.json#/$defs/integer"
    },
    "down_payment_percent": {
      "$ref": "../common/types.schema.json#/$defs/percent"
    },
    "installment_fee_amount": {
      "$ref": "../common/types.schema.json#/$defs/money"
    },
    "days_billed_before_due": {
      "$ref": "../common/types.schema.json#/$defs/integer"
    }
  },
  "required": ["payment_plan_id", "plan_code", "name", "billing_frequency"],
  "unevaluatedProperties": false
}
