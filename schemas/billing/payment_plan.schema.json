{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payment_plan",
  "description": "An installment schedule offered to payors.",
  "type": "object",
  "x-primaryKey": ["payment_plan_id"],
  "x-unique": [
    ["plan_code"]
  ],
  "required": ["payment_plan_id", "plan_code", "name", "billing_frequency"],
  "properties": {
    "payment_plan_id": { "type": "string", "format": "uuid" },
    "plan_code": { "type": "string", "maxLength": 30 },
    "name": { "type": "string", "maxLength": 255 },
    "billing_frequency": {
      "type": "string",
      "enum": ["FULL_PAY", "SEMI_ANNUAL", "QUARTERLY", "MONTHLY", "BIWEEKLY", "WEEKLY", "PER_PAYROLL"]
    },
    "installment_count": { "type": "integer" },
    "down_payment_percent": { "type": "number", "format": "percent" },
    "installment_fee_amount": { "type": "number", "format": "money" },
    "days_billed_before_due": { "type": "integer" }
  },
  "additionalProperties": false
}
