{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "billing_account_policy",
  "description": "Assignment of a policy to a billing account and payment plan over a period.",
  "type": "object",
  "x-primaryKey": ["billing_account_policy_id"],
  "required": ["billing_account_policy_id", "billing_account_id", "policy_id", "effective_date"],
  "properties": {
    "billing_account_policy_id": { "type": "string", "format": "uuid" },
    "billing_account_id": { "type": "string", "format": "uuid", "x-references": "billing_account.billing_account_id" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "payment_plan_id": { "type": "string", "format": "uuid", "x-references": "payment_plan.payment_plan_id" },
    "effective_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
