{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice_line",
  "description": "A charge on an invoice: an installment of premium, a fee or a tax for one policy, traceable to the premium transaction it bills.",
  "type": "object",
  "x-primaryKey": ["invoice_line_id"],
  "required": ["invoice_line_id", "invoice_id", "premium_charge_type", "amount"],
  "properties": {
    "invoice_line_id": { "type": "string", "format": "uuid" },
    "invoice_id": { "type": "string", "format": "uuid", "x-references": "invoice.invoice_id" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "premium_transaction_id": { "type": "string", "format": "uuid", "x-references": "premium_transaction.premium_transaction_id" },
    "enrollment_id": {
      "type": "string",
      "format": "uuid",
      "description": "Member line on a list bill.",
      "x-references": "enrollment.enrollment_id"
    },
    "premium_charge_type": {
      "type": "string",
      "oneOf": [
        { "const": "PREMIUM", "description": "Risk premium" },
        { "const": "MINIMUM_PREMIUM_ADJUSTMENT" },
        { "const": "POLICY_FEE" },
        { "const": "INSTALLMENT_FEE" },
        { "const": "INSPECTION_FEE" },
        { "const": "BROKER_FEE" },
        { "const": "PREMIUM_TAX" },
        { "const": "SURPLUS_LINES_TAX" },
        { "const": "STAMPING_FEE" },
        {
          "const": "STATE_SURCHARGE",
          "description": "Statutory assessment or surcharge (e.g. FIGA, FHCF, WC assessments)"
        },
        { "const": "TERRORISM_PREMIUM", "description": "TRIA premium" },
        { "const": "EXPENSE_CONSTANT" },
        { "const": "OTHER_FEE" }
      ]
    },
    "installment_number": { "type": "integer" },
    "description": { "type": "string", "maxLength": 200 },
    "amount": { "type": "number", "format": "money" }
  },
  "additionalProperties": false
}
