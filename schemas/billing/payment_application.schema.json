{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payment_application",
  "description": "Application of part of a payment to an invoice line or directly to a policy.",
  "type": "object",
  "x-primaryKey": ["payment_application_id"],
  "required": ["payment_application_id", "payment_id", "amount", "applied_at"],
  "properties": {
    "payment_application_id": { "type": "string", "format": "uuid" },
    "payment_id": { "type": "string", "format": "uuid", "x-references": "payment.payment_id" },
    "invoice_line_id": { "type": "string", "format": "uuid", "x-references": "invoice_line.invoice_line_id" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "amount": { "type": "number", "format": "money" },
    "applied_at": { "type": "string", "format": "date-time" },
    "reverses_payment_application_id": { "type": "string", "format": "uuid", "x-references": "payment_application.payment_application_id" }
  },
  "additionalProperties": false
}
