{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commission_statement",
  "description": "Periodic statement of commissions earned by and payable to a producer.",
  "type": "object",
  "x-primaryKey": ["commission_statement_id"],
  "required": ["commission_statement_id", "producer_id", "period_start_date", "period_end_date", "total_amount"],
  "properties": {
    "commission_statement_id": { "type": "string", "format": "uuid" },
    "producer_id": { "type": "string", "format": "uuid", "x-references": "producer.producer_id" },
    "period_start_date": { "type": "string", "format": "date" },
    "period_end_date": { "type": "string", "format": "date" },
    "total_amount": { "type": "number", "format": "money" },
    "disbursement_id": { "type": "string", "format": "uuid", "x-references": "disbursement.disbursement_id" },
    "issued_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
