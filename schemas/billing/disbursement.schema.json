{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "disbursement",
  "description": "Money paid out by the insurer for any purpose: claim payment, premium refund, commission, annuity payout, provider remittance.",
  "type": "object",
  "x-primaryKey": ["disbursement_id"],
  "required": [
    "disbursement_id", "disbursement_type", "disbursement_status", "payee_party_id", "payment_method", "amount",
    "currency_code"
  ],
  "properties": {
    "disbursement_id": { "type": "string", "format": "uuid" },
    "disbursement_type": {
      "type": "string",
      "enum": [
        "CLAIM_PAYMENT", "PREMIUM_REFUND", "COMMISSION", "ANNUITY_PAYOUT", "CONTRACT_WITHDRAWAL", "LOAN_PROCEEDS",
        "DIVIDEND", "PROVIDER_REMITTANCE", "REINSURANCE_SETTLEMENT", "VENDOR_PAYMENT", "ESCHEATMENT"
      ]
    },
    "disbursement_status": {
      "type": "string",
      "enum": ["PENDING", "ISSUED", "CLEARED", "VOIDED", "STOPPED", "RETURNED", "STALE_DATED", "ESCHEATED"]
    },
    "payee_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "payee_name_printed": { "type": "string", "maxLength": 500, "description": "Payee line as issued, including joint payees." },
    "payment_method": {
      "type": "string",
      "enum": [
        "ACH", "CREDIT_CARD", "DEBIT_CARD", "CHECK", "WIRE", "CASH", "LOCKBOX", "DIGITAL_WALLET", "VIRTUAL_CARD",
        "PUSH_TO_DEBIT", "INTERNAL_TRANSFER"
      ]
    },
    "payment_instrument_id": { "type": "string", "format": "uuid", "x-references": "payment_instrument.payment_instrument_id" },
    "mailing_address_id": { "type": "string", "format": "uuid", "x-references": "address.address_id" },
    "amount": { "type": "number", "format": "money" },
    "currency_code": { "type": "string", "maxLength": 3, "x-references": "currency.currency_code" },
    "issued_on": { "type": "string", "format": "date" },
    "cleared_on": { "type": "string", "format": "date" },
    "voided_on": { "type": "string", "format": "date" },
    "reference_number": { "type": "string", "maxLength": 50, "description": "Check number or EFT trace number." },
    "billing_account_id": {
      "type": "string",
      "format": "uuid",
      "description": "Account refunded, for premium refunds.",
      "x-references": "billing_account.billing_account_id"
    },
    "replaces_disbursement_id": {
      "type": "string",
      "format": "uuid",
      "description": "Disbursement this one reissues.",
      "x-references": "disbursement.disbursement_id"
    }
  },
  "additionalProperties": false
}
