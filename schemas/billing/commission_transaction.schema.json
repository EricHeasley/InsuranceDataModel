{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commission_transaction",
  "description": "Commission earned or charged back for a producer on a premium transaction or payment.",
  "type": "object",
  "x-primaryKey": ["commission_transaction_id"],
  "required": [
    "commission_transaction_id", "producer_id", "policy_id", "commission_transaction_type", "amount",
    "accounting_date"
  ],
  "properties": {
    "commission_transaction_id": { "type": "string", "format": "uuid" },
    "producer_id": { "type": "string", "format": "uuid", "x-references": "producer.producer_id" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "premium_transaction_id": { "type": "string", "format": "uuid", "x-references": "premium_transaction.premium_transaction_id" },
    "payment_application_id": {
      "type": "string",
      "format": "uuid",
      "description": "Collected premium that triggered commission, when paid on a collected basis.",
      "x-references": "payment_application.payment_application_id"
    },
    "commission_schedule_id": { "type": "string", "format": "uuid", "x-references": "commission_schedule.commission_schedule_id" },
    "commission_transaction_type": { "type": "string", "enum": ["EARNED", "CHARGEBACK", "ADVANCE", "ADVANCE_RECOVERY", "BONUS", "ADJUSTMENT"] },
    "commission_basis": {
      "type": "string",
      "enum": ["NEW_BUSINESS", "RENEWAL", "FIRST_YEAR", "TRAIL", "OVERRIDE", "CONTINGENT", "BONUS"]
    },
    "commissionable_premium_amount": { "type": "number", "format": "money" },
    "commission_percent": { "type": "number", "format": "percent" },
    "amount": { "type": "number", "format": "money" },
    "accounting_date": { "type": "string", "format": "date" },
    "commission_statement_id": { "type": "string", "format": "uuid", "x-references": "commission_statement.commission_statement_id" }
  },
  "additionalProperties": false
}
