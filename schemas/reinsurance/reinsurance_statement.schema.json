{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reinsurance_statement",
  "description": "Periodic account between cedent and a reinsurer for a contract, netting premium, commission and losses to a balance due.",
  "type": "object",
  "x-primaryKey": ["reinsurance_statement_id"],
  "required": [
    "reinsurance_statement_id", "reinsurance_contract_id", "reinsurance_statement_status", "period_start_date",
    "period_end_date", "balance_due_amount"
  ],
  "properties": {
    "reinsurance_statement_id": { "type": "string", "format": "uuid" },
    "reinsurance_contract_id": { "type": "string", "format": "uuid", "x-references": "reinsurance_contract.reinsurance_contract_id" },
    "reinsurance_participant_id": { "type": "string", "format": "uuid", "x-references": "reinsurance_participant.reinsurance_participant_id" },
    "reinsurance_statement_status": { "type": "string", "enum": ["DRAFT", "ISSUED", "AGREED", "DISPUTED", "SETTLED"] },
    "period_start_date": { "type": "string", "format": "date" },
    "period_end_date": { "type": "string", "format": "date" },
    "premium_amount": { "type": "number", "format": "money" },
    "commission_amount": { "type": "number", "format": "money" },
    "paid_loss_amount": { "type": "number", "format": "money" },
    "balance_due_amount": { "type": "number", "format": "money", "description": "Positive when due to the reinsurer." },
    "due_date": { "type": "string", "format": "date" },
    "settled_on": { "type": "string", "format": "date" },
    "payment_id": { "type": "string", "format": "uuid", "x-references": "payment.payment_id" },
    "disbursement_id": { "type": "string", "format": "uuid", "x-references": "disbursement.disbursement_id" }
  },
  "additionalProperties": false
}
