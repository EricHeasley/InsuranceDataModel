{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/reinsurance/reinsurance_statement.schema.json",
  "title": "reinsurance_statement",
  "description": "Periodic account between cedent and a reinsurer for a contract, netting premium, commission and losses to a balance due.",
  "x-primaryKey": ["reinsurance_statement_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "reinsurance_statement_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "reinsurance_contract_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "reinsurance_contract.reinsurance_contract_id"
    },
    "reinsurance_participant_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "reinsurance_participant.reinsurance_participant_id"
    },
    "reinsurance_statement_status": {
      "$ref": "enums/reinsurance_statement_status.schema.json"
    },
    "period_start_date": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "period_end_date": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "premium_amount": {
      "$ref": "../common/types.schema.json#/$defs/money"
    },
    "commission_amount": {
      "$ref": "../common/types.schema.json#/$defs/money"
    },
    "paid_loss_amount": {
      "$ref": "../common/types.schema.json#/$defs/money"
    },
    "balance_due_amount": {
      "$ref": "../common/types.schema.json#/$defs/money",
      "description": "Positive when due to the reinsurer."
    },
    "due_date": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "settled_on": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "payment_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "payment.payment_id"
    },
    "disbursement_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "disbursement.disbursement_id"
    }
  },
  "required": [
    "reinsurance_statement_id",
    "reinsurance_contract_id",
    "reinsurance_statement_status",
    "period_start_date",
    "period_end_date",
    "balance_due_amount"
  ],
  "unevaluatedProperties": false
}
