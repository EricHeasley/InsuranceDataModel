{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reinsurance_layer",
  "description": "A layer or section of a reinsurance contract with its own retention, limit and pricing. Proportional contracts have a single layer carrying the ceded share.",
  "type": "object",
  "x-primaryKey": ["reinsurance_layer_id"],
  "x-unique": [
    ["reinsurance_contract_id", "layer_number"]
  ],
  "required": ["reinsurance_layer_id", "reinsurance_contract_id", "layer_number"],
  "properties": {
    "reinsurance_layer_id": { "type": "string", "format": "uuid" },
    "reinsurance_contract_id": { "type": "string", "format": "uuid", "x-references": "reinsurance_contract.reinsurance_contract_id" },
    "layer_number": { "type": "integer" },
    "attachment_point_amount": { "type": "number", "format": "money", "description": "Retention the layer sits above." },
    "limit_amount": { "type": "number", "format": "money" },
    "aggregate_limit_amount": { "type": "number", "format": "money" },
    "aggregate_deductible_amount": { "type": "number", "format": "money" },
    "ceded_share_percent": { "type": "number", "format": "percent", "description": "Share ceded (proportional) or placed (excess)." },
    "maximum_line_count": { "type": "number", "format": "decimal", "description": "Number of lines for surplus share." },
    "ceding_commission_percent": { "type": "number", "format": "percent" },
    "has_sliding_scale_commission": { "type": "boolean" },
    "profit_commission_percent": { "type": "number", "format": "percent" },
    "reinstatement_count": { "type": "integer" },
    "reinstatement_premium_percent": { "type": "number", "format": "percent" },
    "rate_on_subject_premium_percent": { "type": "number", "format": "percent" },
    "deposit_premium_amount": { "type": "number", "format": "money" },
    "minimum_premium_amount": { "type": "number", "format": "money" },
    "estimated_subject_premium_amount": { "type": "number", "format": "money" }
  },
  "additionalProperties": false
}
