{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reinsurance_policy_cession",
  "description": "Attachment of a policy or coverage to a reinsurance layer: every facultative placement, and treaty cessions where the share varies by risk (surplus share, life automatic cessions).",
  "type": "object",
  "x-primaryKey": ["reinsurance_policy_cession_id"],
  "required": ["reinsurance_policy_cession_id", "reinsurance_layer_id", "policy_id", "effective_date"],
  "properties": {
    "reinsurance_policy_cession_id": { "type": "string", "format": "uuid" },
    "reinsurance_layer_id": { "type": "string", "format": "uuid", "x-references": "reinsurance_layer.reinsurance_layer_id" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "policy_coverage_id": { "type": "string", "format": "uuid", "x-references": "policy_coverage.policy_coverage_id" },
    "policy_risk_id": { "type": "string", "format": "uuid", "x-references": "policy_risk.policy_risk_id" },
    "ceded_percent": { "type": "number", "format": "percent" },
    "retained_amount": { "type": "number", "format": "money" },
    "ceded_amount": { "type": "number", "format": "money", "description": "Ceded limit or net amount at risk." },
    "certificate_number": { "type": "string", "maxLength": 50, "description": "Facultative certificate number." },
    "effective_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
