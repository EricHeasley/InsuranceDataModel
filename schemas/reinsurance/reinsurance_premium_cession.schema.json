{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reinsurance_premium_cession",
  "description": "Premium and commission ceded to (or assumed under) a layer, at policy or bulk level.",
  "type": "object",
  "x-primaryKey": ["reinsurance_premium_cession_id"],
  "required": [
    "reinsurance_premium_cession_id", "reinsurance_layer_id", "premium_type", "ceded_premium_amount",
    "accounting_date"
  ],
  "properties": {
    "reinsurance_premium_cession_id": { "type": "string", "format": "uuid" },
    "reinsurance_layer_id": { "type": "string", "format": "uuid", "x-references": "reinsurance_layer.reinsurance_layer_id" },
    "premium_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Null for bulk entries such as deposit, adjustment and reinstatement premium.",
      "x-references": "premium_transaction.premium_transaction_id"
    },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "premium_type": {
      "type": "string",
      "maxLength": 30,
      "description": "CEDED_WRITTEN, DEPOSIT, ADJUSTMENT, REINSTATEMENT, MINIMUM."
    },
    "ceded_premium_amount": { "type": "number", "format": "money" },
    "ceding_commission_amount": { "type": "number", "format": "money" },
    "earning_start_date": { "type": "string", "format": "date" },
    "earning_end_date": { "type": "string", "format": "date" },
    "accounting_date": { "type": "string", "format": "date" },
    "reinsurance_statement_id": { "type": "string", "format": "uuid", "x-references": "reinsurance_statement.reinsurance_statement_id" }
  },
  "additionalProperties": false
}
