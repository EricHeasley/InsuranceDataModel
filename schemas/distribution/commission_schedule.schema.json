{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/distribution/commission_schedule.schema.json",
  "title": "commission_schedule",
  "description": "Commission rate that applies under a producer agreement for a product or line, by business event and policy year.",
  "x-primaryKey": ["commission_schedule_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "commission_schedule_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "producer_agreement_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "producer_agreement.producer_agreement_id"
    },
    "product_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "product.product_id"
    },
    "line_of_business_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 30,
      "x-references": "line_of_business.line_of_business_code"
    },
    "jurisdiction_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 6,
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "commission_basis": {
      "$ref": "enums/commission_basis.schema.json"
    },
    "policy_year_from": {
      "$ref": "../common/types.schema.json#/$defs/integer",
      "description": "First policy year the rate applies to (life/annuity first-year vs renewal scales)."
    },
    "policy_year_to": {
      "$ref": "../common/types.schema.json#/$defs/integer"
    },
    "commission_percent": {
      "$ref": "../common/types.schema.json#/$defs/percent"
    },
    "flat_amount": {
      "$ref": "../common/types.schema.json#/$defs/money",
      "description": "Per-policy or per-member-per-month amount when not a percentage."
    },
    "effective_on": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "expires_on": {
      "$ref": "../common/types.schema.json#/$defs/date"
    }
  },
  "required": ["commission_schedule_id", "producer_agreement_id", "commission_basis", "effective_on"],
  "unevaluatedProperties": false
}
