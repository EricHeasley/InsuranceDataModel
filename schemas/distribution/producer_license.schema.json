{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/distribution/producer_license.schema.json",
  "title": "producer_license",
  "description": "A state insurance license held by a producer.",
  "x-primaryKey": ["producer_license_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "producer_license_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "producer_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "producer.producer_id"
    },
    "jurisdiction_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 6,
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "license_number": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 50
    },
    "license_class": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 50,
      "description": "E.g. Producer, Surplus Lines, Adjuster."
    },
    "lines_of_authority": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 500,
      "description": "Comma-separated lines of authority (Property, Casualty, Life, Health, Variable, ...)."
    },
    "is_resident_license": {
      "$ref": "../common/types.schema.json#/$defs/boolean"
    },
    "license_status": {
      "$ref": "enums/license_status.schema.json"
    },
    "issued_on": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "expires_on": {
      "$ref": "../common/types.schema.json#/$defs/date"
    }
  },
  "required": [
    "producer_license_id",
    "producer_id",
    "jurisdiction_code",
    "license_number",
    "license_status"
  ],
  "unevaluatedProperties": false
}
