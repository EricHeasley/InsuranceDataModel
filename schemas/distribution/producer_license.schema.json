{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "producer_license",
  "description": "A state insurance license held by a producer.",
  "type": "object",
  "x-primaryKey": ["producer_license_id"],
  "required": ["producer_license_id", "producer_id", "jurisdiction_code", "license_number", "license_status"],
  "properties": {
    "producer_license_id": { "type": "string", "format": "uuid" },
    "producer_id": { "type": "string", "format": "uuid", "x-references": "producer.producer_id" },
    "jurisdiction_code": { "type": "string", "maxLength": 6, "x-references": "jurisdiction.jurisdiction_code" },
    "license_number": { "type": "string", "maxLength": 50 },
    "license_class": { "type": "string", "maxLength": 50, "description": "E.g. Producer, Surplus Lines, Adjuster." },
    "lines_of_authority": {
      "type": "string",
      "maxLength": 500,
      "description": "Comma-separated lines of authority (Property, Casualty, Life, Health, Variable, ...)."
    },
    "is_resident_license": { "type": "boolean" },
    "license_status": { "type": "string", "enum": ["PENDING", "ACTIVE", "EXPIRED", "SUSPENDED", "REVOKED", "TERMINATED"] },
    "issued_on": { "type": "string", "format": "date" },
    "expires_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
