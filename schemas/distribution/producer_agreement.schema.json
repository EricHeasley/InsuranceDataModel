{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "producer_agreement",
  "description": "Contract between a producer and the insurer that governs authority and compensation.",
  "type": "object",
  "x-primaryKey": ["producer_agreement_id"],
  "x-unique": [
    ["agreement_number"]
  ],
  "required": ["producer_agreement_id", "producer_id", "agreement_number", "effective_on"],
  "properties": {
    "producer_agreement_id": { "type": "string", "format": "uuid" },
    "producer_id": { "type": "string", "format": "uuid", "x-references": "producer.producer_id" },
    "insurer_id": { "type": "string", "format": "uuid", "x-references": "insurer.insurer_id" },
    "agreement_number": { "type": "string", "maxLength": 50 },
    "has_binding_authority": { "type": "boolean" },
    "effective_on": { "type": "string", "format": "date" },
    "terminated_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
