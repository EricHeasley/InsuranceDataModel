{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim_payment",
  "description": "A payment issued on a claim to one or more payees. Its allocation to exposures and cost categories is in the claim ledger; the instrument is a disbursement.",
  "type": "object",
  "x-primaryKey": ["claim_payment_id"],
  "required": ["claim_payment_id", "claim_id", "claim_payment_type", "claim_payment_status", "amount", "requested_at"],
  "properties": {
    "claim_payment_id": { "type": "string", "format": "uuid" },
    "claim_id": { "type": "string", "format": "uuid", "x-references": "claim.claim_id" },
    "claim_payment_type": { "type": "string", "enum": ["PARTIAL", "FINAL", "SUPPLEMENTAL", "ADVANCE", "RECURRING"] },
    "claim_payment_status": {
      "type": "string",
      "enum": ["REQUESTED", "PENDING_APPROVAL", "APPROVED", "ISSUED", "CLEARED", "VOIDED", "STOPPED", "REJECTED"]
    },
    "amount": { "type": "number", "format": "money" },
    "disbursement_id": { "type": "string", "format": "uuid", "x-references": "disbursement.disbursement_id" },
    "requested_by_staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "approved_by_staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "requested_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": "string", "format": "date-time" },
    "invoice_number": { "type": "string", "maxLength": 50, "description": "Vendor invoice being paid." },
    "memo": { "type": "string", "maxLength": 500 },
    "is_tax_reportable": { "type": "boolean", "description": "Reportable on IRS Form 1099." }
  },
  "additionalProperties": false
}
