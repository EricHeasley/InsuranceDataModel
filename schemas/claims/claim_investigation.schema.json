{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim_investigation",
  "description": "A special investigation of suspected fraud on a claim.",
  "type": "object",
  "x-primaryKey": ["claim_investigation_id"],
  "required": ["claim_investigation_id", "claim_id", "investigation_status", "referred_on"],
  "properties": {
    "claim_investigation_id": { "type": "string", "format": "uuid" },
    "claim_id": { "type": "string", "format": "uuid", "x-references": "claim.claim_id" },
    "investigation_status": {
      "type": "string",
      "enum": [
        "REFERRED", "ACCEPTED", "IN_PROGRESS", "CLOSED_FRAUD_CONFIRMED", "CLOSED_NO_FRAUD", "CLOSED_INCONCLUSIVE",
        "DECLINED"
      ]
    },
    "referral_source": { "type": "string", "maxLength": 30, "description": "ADJUSTER, MODEL, HOTLINE, NICB, ..." },
    "fraud_score": { "type": "number", "format": "decimal" },
    "indicators": { "type": "string", "description": "Fraud indicators observed." },
    "investigator_staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "referred_on": { "type": "string", "format": "date" },
    "closed_on": { "type": "string", "format": "date" },
    "reported_to_authorities_on": { "type": "string", "format": "date", "description": "State fraud bureau / NICB report date." },
    "savings_amount": { "type": "number", "format": "money" }
  },
  "additionalProperties": false
}
