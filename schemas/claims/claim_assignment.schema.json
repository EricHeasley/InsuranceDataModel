{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim_assignment",
  "description": "Assignment of a staff member to a claim or exposure over a period.",
  "type": "object",
  "x-primaryKey": ["claim_assignment_id"],
  "required": ["claim_assignment_id", "claim_id", "staff_member_id", "claim_assignment_role", "assigned_at"],
  "properties": {
    "claim_assignment_id": { "type": "string", "format": "uuid" },
    "claim_id": { "type": "string", "format": "uuid", "x-references": "claim.claim_id" },
    "claim_exposure_id": { "type": "string", "format": "uuid", "x-references": "claim_exposure.claim_exposure_id" },
    "staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "claim_assignment_role": {
      "type": "string",
      "enum": [
        "OWNER", "FIELD_ADJUSTER", "INJURY_ADJUSTER", "PROPERTY_ADJUSTER", "TOTAL_LOSS", "SUBROGATION", "SIU",
        "LITIGATION", "NURSE_CASE_MANAGER", "SUPERVISOR"
      ]
    },
    "assigned_at": { "type": "string", "format": "date-time" },
    "unassigned_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
