{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catastrophe_event",
  "description": "A catastrophe to which many claims are attributed, such as a named hurricane, wildfire or hailstorm.",
  "type": "object",
  "x-primaryKey": ["catastrophe_event_id"],
  "x-unique": [
    ["catastrophe_code"]
  ],
  "required": ["catastrophe_event_id", "catastrophe_code", "name", "start_date"],
  "properties": {
    "catastrophe_event_id": { "type": "string", "format": "uuid" },
    "catastrophe_code": { "type": "string", "maxLength": 30, "description": "Company catastrophe code." },
    "pcs_serial_number": { "type": "string", "maxLength": 20, "description": "Verisk PCS catastrophe serial number." },
    "name": { "type": "string", "maxLength": 255 },
    "cause_of_loss_code": { "type": "string", "maxLength": 30, "x-references": "cause_of_loss.cause_of_loss_code" },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "affected_jurisdictions": { "type": "string", "maxLength": 500, "description": "Comma-separated jurisdiction codes." }
  },
  "additionalProperties": false
}
