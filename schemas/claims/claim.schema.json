{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim",
  "description": "A demand for benefits arising from one loss occurrence under one policy. Supertype for line-specific claim detail.",
  "type": "object",
  "x-primaryKey": ["claim_id"],
  "x-unique": [
    ["claim_number"]
  ],
  "required": ["claim_id", "claim_number", "claim_status", "loss_at", "reported_at"],
  "properties": {
    "claim_id": { "type": "string", "format": "uuid" },
    "claim_number": { "type": "string", "maxLength": 30 },
    "policy_id": {
      "type": "string",
      "format": "uuid",
      "description": "Null only while coverage is unverified at first notice.",
      "x-references": "policy.policy_id"
    },
    "policy_term_id": {
      "type": "string",
      "format": "uuid",
      "description": "Term in force on the loss date (or report date for claims-made).",
      "x-references": "policy_term.policy_term_id"
    },
    "line_of_business_code": { "type": "string", "maxLength": 30, "x-references": "line_of_business.line_of_business_code" },
    "claim_status": { "type": "string", "enum": ["DRAFT", "OPEN", "CLOSED", "REOPENED", "DENIED", "WITHDRAWN", "VOIDED"] },
    "loss_at": { "type": "string", "format": "date-time", "description": "Date and time of loss." },
    "loss_date_is_estimated": { "type": "boolean" },
    "reported_at": { "type": "string", "format": "date-time", "description": "When the insurer first received notice." },
    "claims_made_date": {
      "type": "string",
      "format": "date",
      "description": "Date the claim was first made against the insured (claims-made coverage)."
    },
    "fnol_channel": {
      "type": "string",
      "enum": ["PHONE", "WEB", "MOBILE_APP", "AGENT", "EMAIL", "MAIL", "TELEMATICS", "EDI", "THIRD_PARTY_ADMINISTRATOR"]
    },
    "cause_of_loss_code": { "type": "string", "maxLength": 30, "x-references": "cause_of_loss.cause_of_loss_code" },
    "loss_description": { "type": "string" },
    "loss_address_id": { "type": "string", "format": "uuid", "x-references": "address.address_id" },
    "loss_jurisdiction_code": {
      "type": "string",
      "maxLength": 6,
      "description": "State where the loss occurred.",
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "catastrophe_event_id": { "type": "string", "format": "uuid", "x-references": "catastrophe_event.catastrophe_event_id" },
    "coverage_verification_status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "RESERVATION_OF_RIGHTS", "DENIED", "PARTIAL"] },
    "insured_fault_percent": { "type": "number", "format": "percent" },
    "police_report_number": { "type": "string", "maxLength": 50 },
    "is_in_litigation": { "type": "boolean" },
    "is_large_loss": { "type": "boolean" },
    "handling_office_code": { "type": "string", "maxLength": 30 },
    "third_party_administrator_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "closed_at": { "type": "string", "format": "date-time" },
    "reopened_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
