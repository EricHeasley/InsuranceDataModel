{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim_exposure",
  "description": "One claimant's claim under one coverage (also called a feature or sub-claim). The level at which reserves are set, payments are made and losses are reported by coverage and statutory line.",
  "type": "object",
  "x-primaryKey": ["claim_exposure_id"],
  "x-unique": [
    ["claim_id", "exposure_number"]
  ],
  "required": [
    "claim_exposure_id", "claim_id", "exposure_number", "claimant_claim_party_id", "coverage_definition_id",
    "exposure_status", "opened_at"
  ],
  "properties": {
    "claim_exposure_id": { "type": "string", "format": "uuid" },
    "claim_id": { "type": "string", "format": "uuid", "x-references": "claim.claim_id" },
    "exposure_number": { "type": "integer" },
    "claimant_claim_party_id": { "type": "string", "format": "uuid", "x-references": "claim_party.claim_party_id" },
    "policy_coverage_id": { "type": "string", "format": "uuid", "x-references": "policy_coverage.policy_coverage_id" },
    "coverage_definition_id": { "type": "string", "format": "uuid", "x-references": "coverage_definition.coverage_definition_id" },
    "claim_incident_id": { "type": "string", "format": "uuid", "x-references": "claim_incident.claim_incident_id" },
    "exposure_status": { "type": "string", "enum": ["DRAFT", "OPEN", "CLOSED", "REOPENED", "DENIED", "WITHDRAWN", "VOIDED"] },
    "jurisdiction_code": {
      "type": "string",
      "maxLength": 6,
      "description": "State the loss is reported in for statutory purposes.",
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "asl_code": { "type": "string", "maxLength": 10, "x-references": "annual_statement_line.asl_code" },
    "is_first_party": { "type": "boolean" },
    "deductible_applied_amount": { "type": "number", "format": "money" },
    "denial_reason": { "type": "string", "maxLength": 200 },
    "opened_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
