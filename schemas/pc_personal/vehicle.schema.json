{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vehicle",
  "description": "A motor vehicle or trailer, personal or commercial.",
  "type": "object",
  "x-primaryKey": ["insurable_object_id"],
  "x-subtypeOf": "insurable_object",
  "required": ["insurable_object_id", "vehicle_type"],
  "properties": {
    "insurable_object_id": { "type": "string", "format": "uuid", "x-references": "insurable_object.insurable_object_id" },
    "vin": { "type": "string", "maxLength": 17, "description": "Vehicle identification number." },
    "model_year": { "type": "integer" },
    "make": { "type": "string", "maxLength": 50 },
    "model": { "type": "string", "maxLength": 50 },
    "body_style": { "type": "string", "maxLength": 50 },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "PRIVATE_PASSENGER", "PICKUP_VAN", "MOTORCYCLE", "MOTORHOME", "TRAILER", "LIGHT_TRUCK", "MEDIUM_TRUCK",
        "HEAVY_TRUCK", "EXTRA_HEAVY_TRUCK", "TRACTOR", "BUS", "ANTIQUE", "OFF_ROAD", "OTHER"
      ]
    },
    "gross_vehicle_weight": { "type": "integer", "description": "Pounds." },
    "cost_new_amount": { "type": "number", "format": "money" },
    "symbol_code": { "type": "string", "maxLength": 10, "description": "ISO or company vehicle rating symbol." },
    "has_anti_theft_device": { "type": "boolean" },
    "has_advanced_driver_assistance": { "type": "boolean" },
    "registration_jurisdiction_code": { "type": "string", "maxLength": 6, "x-references": "jurisdiction.jurisdiction_code" },
    "license_plate": { "type": "string", "maxLength": 15, "x-sensitivity": "PII" }
  },
  "additionalProperties": false
}
