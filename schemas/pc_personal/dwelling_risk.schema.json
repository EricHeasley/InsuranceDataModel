{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dwelling_risk",
  "description": "Policy-specific rating detail for a dwelling or residence on a homeowners, condo, renters or dwelling fire policy.",
  "type": "object",
  "x-primaryKey": ["policy_risk_id"],
  "x-subtypeOf": "policy_risk",
  "required": ["policy_risk_id"],
  "properties": {
    "policy_risk_id": { "type": "string", "format": "uuid", "x-references": "policy_risk.policy_risk_id" },
    "homeowners_form": {
      "type": "string",
      "oneOf": [
        { "const": "HO2", "description": "Broad form" },
        { "const": "HO3", "description": "Special form" },
        { "const": "HO4", "description": "Tenants (renters)" },
        { "const": "HO5", "description": "Comprehensive form" },
        { "const": "HO6", "description": "Condominium unit owners" },
        { "const": "HO8", "description": "Modified coverage" },
        { "const": "DP1", "description": "Dwelling fire basic" },
        { "const": "DP3", "description": "Dwelling fire special" }
      ]
    },
    "residence_type": {
      "type": "string",
      "enum": ["SINGLE_FAMILY", "TWO_TO_FOUR_FAMILY", "CONDO_UNIT", "TOWNHOUSE", "APARTMENT", "MOBILE_HOME"]
    },
    "dwelling_occupancy": {
      "type": "string",
      "enum": ["OWNER_PRIMARY", "OWNER_SECONDARY", "SEASONAL", "TENANT", "VACANT", "UNDER_CONSTRUCTION"]
    },
    "replacement_cost_amount": { "type": "number", "format": "money", "description": "Estimated cost to rebuild." },
    "replacement_cost_estimated_on": { "type": "string", "format": "date" },
    "valuation_method": {
      "type": "string",
      "enum": [
        "REPLACEMENT_COST", "ACTUAL_CASH_VALUE", "AGREED_VALUE", "STATED_AMOUNT", "FUNCTIONAL_REPLACEMENT_COST",
        "MARKET_VALUE"
      ]
    },
    "protection_class": { "type": "string", "maxLength": 5, "description": "Public protection classification." },
    "distance_to_fire_station_miles": { "type": "number", "format": "decimal" },
    "distance_to_hydrant_feet": { "type": "integer" },
    "purchase_date": { "type": "string", "format": "date" },
    "has_swimming_pool": { "type": "boolean" },
    "has_trampoline": { "type": "boolean" },
    "has_wood_stove": { "type": "boolean" },
    "has_restricted_dog_breed": { "type": "boolean" },
    "has_wind_mitigation_features": { "type": "boolean" },
    "has_water_leak_detection": { "type": "boolean" },
    "household_member_count": { "type": "integer" },
    "home_business_description": { "type": "string", "maxLength": 200 }
  },
  "additionalProperties": false
}
