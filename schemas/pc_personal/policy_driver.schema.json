{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy_driver",
  "description": "A driver listed on an auto policy, with rating characteristics.",
  "type": "object",
  "x-primaryKey": ["policy_driver_id"],
  "required": ["policy_driver_id", "policy_id", "party_id", "driver_status", "effective_date", "added_by_transaction_id"],
  "properties": {
    "policy_driver_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "party_id": { "type": "string", "format": "uuid", "x-references": "person.party_id" },
    "driver_status": { "type": "string", "enum": ["RATED", "EXCLUDED", "LISTED_NOT_RATED", "PERMIT"] },
    "relationship_to_insured": { "type": "string", "maxLength": 30 },
    "license_jurisdiction_code": { "type": "string", "maxLength": 6, "x-references": "jurisdiction.jurisdiction_code" },
    "first_licensed_date": { "type": "string", "format": "date" },
    "has_good_student_discount": { "type": "boolean" },
    "has_defensive_driver_course": { "type": "boolean" },
    "requires_financial_responsibility_filing": { "type": "boolean", "description": "SR-22 / FR-44 filing required." },
    "insurance_score_tier": { "type": "string", "maxLength": 20, "x-sensitivity": "SPI" },
    "effective_date": { "type": "string", "format": "date", "description": "First business date this row applies." },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Business date this row stops applying (exclusive); null while open-ended."
    },
    "added_by_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Policy transaction that introduced this row.",
      "x-references": "policy_transaction.policy_transaction_id"
    },
    "removed_by_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Policy transaction that removed or superseded this row.",
      "x-references": "policy_transaction.policy_transaction_id"
    }
  },
  "additionalProperties": false
}
