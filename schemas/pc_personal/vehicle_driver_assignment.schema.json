{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vehicle_driver_assignment",
  "description": "Assignment of a driver to a vehicle for rating.",
  "type": "object",
  "x-primaryKey": ["vehicle_driver_assignment_id"],
  "required": [
    "vehicle_driver_assignment_id", "policy_risk_id", "policy_driver_id", "is_principal_operator", "effective_date",
    "added_by_transaction_id"
  ],
  "properties": {
    "vehicle_driver_assignment_id": { "type": "string", "format": "uuid" },
    "policy_risk_id": { "type": "string", "format": "uuid", "x-references": "personal_auto_risk.policy_risk_id" },
    "policy_driver_id": { "type": "string", "format": "uuid", "x-references": "policy_driver.policy_driver_id" },
    "is_principal_operator": { "type": "boolean" },
    "usage_percent": { "type": "number", "format": "percent" },
    "effective_date": { "type": "string", "format": "date", "description": "First business date this row applies." },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Business date this row stops applying (exclusive); null while open-ended."
    },
    "added_by_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Policy transaction that introduced this row.",
      "x-references": "policy_transaction.policy_transaction_id"
    },
    "removed_by_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Policy transaction that removed or superseded this row.",
      "x-references": "policy_transaction.policy_transaction_id"
    }
  },
  "additionalProperties": false
}
