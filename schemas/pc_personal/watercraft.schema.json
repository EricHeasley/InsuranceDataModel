{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "watercraft",
  "description": "A boat or personal watercraft.",
  "type": "object",
  "x-primaryKey": ["insurable_object_id"],
  "x-subtypeOf": "insurable_object",
  "required": ["insurable_object_id"],
  "properties": {
    "insurable_object_id": { "type": "string", "format": "uuid", "x-references": "insurable_object.insurable_object_id" },
    "hull_identification_number": { "type": "string", "maxLength": 20 },
    "model_year": { "type": "integer" },
    "make": { "type": "string", "maxLength": 50 },
    "model": { "type": "string", "maxLength": 50 },
    "watercraft_type": { "type": "string", "maxLength": 30, "description": "SAILBOAT, POWERBOAT, PWC, YACHT, ..." },
    "length_feet": { "type": "number", "format": "decimal" },
    "hull_material": { "type": "string", "maxLength": 30 },
    "propulsion_type": { "type": "string", "maxLength": 30 },
    "horsepower": { "type": "integer" },
    "maximum_speed_mph": { "type": "integer" }
  },
  "additionalProperties": false
}
