{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "driver_incident",
  "description": "An accident, violation or claim on a driver's record used in rating, from an MVR, CLUE report or self-report.",
  "type": "object",
  "x-primaryKey": ["driver_incident_id"],
  "required": ["driver_incident_id", "policy_driver_id", "driver_incident_type", "incident_date"],
  "properties": {
    "driver_incident_id": { "type": "string", "format": "uuid" },
    "policy_driver_id": { "type": "string", "format": "uuid", "x-references": "policy_driver.policy_driver_id" },
    "driver_incident_type": {
      "type": "string",
      "enum": [
        "AT_FAULT_ACCIDENT", "NOT_AT_FAULT_ACCIDENT", "MINOR_VIOLATION", "MAJOR_VIOLATION", "DUI", "SUSPENSION",
        "COMPREHENSIVE_CLAIM"
      ]
    },
    "incident_date": { "type": "string", "format": "date" },
    "conviction_date": { "type": "string", "format": "date" },
    "violation_code": { "type": "string", "maxLength": 30 },
    "description": { "type": "string", "maxLength": 500 },
    "source": { "type": "string", "maxLength": 30, "description": "MVR, CLUE, SELF_REPORTED, INTERNAL_CLAIM." },
    "paid_amount": { "type": "number", "format": "money" },
    "is_chargeable": { "type": "boolean", "description": "Whether the incident is surcharged." }
  },
  "additionalProperties": false
}
