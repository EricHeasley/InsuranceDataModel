{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scheduled_item",
  "description": "An individually described item of property: jewelry, fine art, a musical instrument, contractor's equipment, a cargo shipment.",
  "type": "object",
  "x-primaryKey": ["insurable_object_id"],
  "x-subtypeOf": "insurable_object",
  "required": ["insurable_object_id", "item_category"],
  "properties": {
    "insurable_object_id": { "type": "string", "format": "uuid", "x-references": "insurable_object.insurable_object_id" },
    "item_category": {
      "type": "string",
      "maxLength": 50,
      "description": "JEWELRY, FINE_ART, FURS, CAMERAS, MUSICAL_INSTRUMENT, CONTRACTORS_EQUIPMENT, EDP, CARGO, ..."
    },
    "manufacturer": { "type": "string", "maxLength": 100 },
    "serial_number": { "type": "string", "maxLength": 100 },
    "appraised_value_amount": { "type": "number", "format": "money" },
    "appraisal_date": { "type": "string", "format": "date" },
    "appraisal_document_id": { "type": "string", "format": "uuid", "x-references": "document.document_id" }
  },
  "additionalProperties": false
}
