{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/health/health_plan.schema.json",
  "title": "health_plan",
  "description": "A benefit plan design offered under a health product for a plan year.",
  "x-primaryKey": ["health_plan_id"],
  "x-unique": [
    ["plan_code", "plan_year"]
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "health_plan_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "product_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "product.product_id"
    },
    "plan_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 30
    },
    "plan_year": {
      "$ref": "../common/types.schema.json#/$defs/integer"
    },
    "name": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 255
    },
    "health_plan_type": {
      "$ref": "enums/health_plan_type.schema.json"
    },
    "market_segment": {
      "$ref": "enums/market_segment.schema.json"
    },
    "metal_tier": {
      "$ref": "enums/metal_tier.schema.json"
    },
    "hios_plan_id": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 20,
      "description": "CMS HIOS standard component ID with variant, for ACA plans."
    },
    "cms_contract_number": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 20,
      "description": "Medicare Advantage / Part D contract and plan benefit package."
    },
    "provider_network_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "provider_network.provider_network_id"
    },
    "individual_deductible_amount": {
      "$ref": "../common/types.schema.json#/$defs/money"
    },
    "family_deductible_amount": {
      "$ref": "../common/types.schema.json#/$defs/money"
    },
    "individual_out_of_pocket_max_amount": {
      "$ref": "../common/types.schema.json#/$defs/money"
    },
    "family_out_of_pocket_max_amount": {
      "$ref": "../common/types.schema.json#/$defs/money"
    },
    "is_hsa_eligible": {
      "$ref": "../common/types.schema.json#/$defs/boolean"
    },
    "actuarial_value_percent": {
      "$ref": "../common/types.schema.json#/$defs/percent"
    },
    "accumulator_period": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 20,
      "description": "CALENDAR_YEAR or PLAN_YEAR."
    }
  },
  "required": [
    "health_plan_id",
    "product_id",
    "plan_code",
    "plan_year",
    "name",
    "health_plan_type",
    "market_segment"
  ],
  "unevaluatedProperties": false
}
