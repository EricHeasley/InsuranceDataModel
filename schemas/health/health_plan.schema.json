{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health_plan",
  "description": "A benefit plan design offered under a health product for a plan year.",
  "type": "object",
  "x-primaryKey": ["health_plan_id"],
  "x-unique": [
    ["plan_code", "plan_year"]
  ],
  "required": ["health_plan_id", "product_id", "plan_code", "plan_year", "name", "health_plan_type", "market_segment"],
  "properties": {
    "health_plan_id": { "type": "string", "format": "uuid" },
    "product_id": { "type": "string", "format": "uuid", "x-references": "product.product_id" },
    "plan_code": { "type": "string", "maxLength": 30 },
    "plan_year": { "type": "integer" },
    "name": { "type": "string", "maxLength": 255 },
    "health_plan_type": {
      "type": "string",
      "enum": [
        "HMO", "PPO", "EPO", "POS", "HDHP", "INDEMNITY", "DENTAL_PPO", "DENTAL_HMO", "VISION", "MEDICARE_SUPPLEMENT",
        "MEDICARE_ADVANTAGE", "PART_D", "SHORT_TERM_DISABILITY", "LONG_TERM_DISABILITY", "LONG_TERM_CARE", "ACCIDENT",
        "CRITICAL_ILLNESS", "HOSPITAL_INDEMNITY"
      ]
    },
    "market_segment": {
      "type": "string",
      "enum": ["INDIVIDUAL", "SMALL_GROUP", "LARGE_GROUP", "SELF_FUNDED", "MEDICARE", "MEDICAID", "STUDENT", "ASSOCIATION"]
    },
    "metal_tier": { "type": "string", "enum": ["CATASTROPHIC", "BRONZE", "SILVER", "GOLD", "PLATINUM", "NOT_APPLICABLE"] },
    "hios_plan_id": {
      "type": "string",
      "maxLength": 20,
      "description": "CMS HIOS standard component ID with variant, for ACA plans."
    },
    "cms_contract_number": {
      "type": "string",
      "maxLength": 20,
      "description": "Medicare Advantage / Part D contract and plan benefit package."
    },
    "provider_network_id": { "type": "string", "format": "uuid", "x-references": "provider_network.provider_network_id" },
    "individual_deductible_amount": { "type": "number", "format": "money" },
    "family_deductible_amount": { "type": "number", "format": "money" },
    "individual_out_of_pocket_max_amount": { "type": "number", "format": "money" },
    "family_out_of_pocket_max_amount": { "type": "number", "format": "money" },
    "is_hsa_eligible": { "type": "boolean" },
    "actuarial_value_percent": { "type": "number", "format": "percent" },
    "accumulator_period": { "type": "string", "maxLength": 20, "description": "CALENDAR_YEAR or PLAN_YEAR." }
  },
  "additionalProperties": false
}
