{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "benefit_accumulator",
  "description": "Running total toward a deductible, out-of-pocket maximum or benefit limit for a member or family in a benefit period.",
  "type": "object",
  "x-primaryKey": ["benefit_accumulator_id"],
  "required": [
    "benefit_accumulator_id", "enrollment_id", "accumulator_type", "accumulator_level", "network_tier",
    "period_start_date", "period_end_date", "accumulated_amount"
  ],
  "properties": {
    "benefit_accumulator_id": { "type": "string", "format": "uuid" },
    "enrollment_id": { "type": "string", "format": "uuid", "x-references": "enrollment.enrollment_id" },
    "accumulator_type": {
      "type": "string",
      "enum": ["DEDUCTIBLE", "OUT_OF_POCKET_MAXIMUM", "BENEFIT_MAXIMUM", "VISIT_LIMIT", "LIFETIME_MAXIMUM"]
    },
    "accumulator_level": { "type": "string", "enum": ["INDIVIDUAL", "FAMILY"] },
    "network_tier": { "type": "string", "enum": ["IN_NETWORK", "PREFERRED", "OUT_OF_NETWORK", "ANY"] },
    "plan_benefit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Benefit a limit accumulator belongs to.",
      "x-references": "plan_benefit.plan_benefit_id"
    },
    "period_start_date": { "type": "string", "format": "date" },
    "period_end_date": { "type": "string", "format": "date" },
    "accumulated_amount": { "type": "number", "format": "decimal" },
    "limit_amount": { "type": "number", "format": "decimal" },
    "last_health_claim_id": { "type": "string", "format": "uuid", "x-references": "health_claim.health_claim_id" }
  },
  "additionalProperties": false
}
