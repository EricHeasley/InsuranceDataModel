{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health_claim_payment",
  "description": "Portion of a disbursement (remittance) that pays a health claim.",
  "type": "object",
  "x-primaryKey": ["health_claim_payment_id"],
  "required": ["health_claim_payment_id", "health_claim_id", "disbursement_id", "amount"],
  "properties": {
    "health_claim_payment_id": { "type": "string", "format": "uuid" },
    "health_claim_id": { "type": "string", "format": "uuid", "x-references": "health_claim.health_claim_id" },
    "disbursement_id": { "type": "string", "format": "uuid", "x-references": "disbursement.disbursement_id" },
    "amount": { "type": "number", "format": "money" },
    "interest_amount": { "type": "number", "format": "money", "description": "Prompt-pay interest." },
    "is_paid_to_member": { "type": "boolean" }
  },
  "additionalProperties": false
}
