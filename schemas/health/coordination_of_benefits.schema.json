{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coordination_of_benefits",
  "description": "Other health coverage a member holds, and the order in which payers are responsible.",
  "type": "object",
  "x-primaryKey": ["coordination_of_benefits_id"],
  "required": ["coordination_of_benefits_id", "member_id", "other_carrier_name", "payer_order", "effective_date"],
  "properties": {
    "coordination_of_benefits_id": { "type": "string", "format": "uuid" },
    "member_id": { "type": "string", "format": "uuid", "x-references": "member.member_id" },
    "other_carrier_name": { "type": "string", "maxLength": 255 },
    "other_carrier_insurer_id": { "type": "string", "format": "uuid", "x-references": "insurer.insurer_id" },
    "other_policy_number": { "type": "string", "maxLength": 50, "x-sensitivity": "PHI" },
    "other_coverage_type": {
      "type": "string",
      "maxLength": 30,
      "description": "COMMERCIAL, MEDICARE_A, MEDICARE_B, MEDICAID, TRICARE, WORKERS_COMP, AUTO."
    },
    "payer_order": { "type": "integer", "description": "1 primary, 2 secondary, 3 tertiary for the other coverage." },
    "effective_date": { "type": "string", "format": "date" },
    "termination_date": { "type": "string", "format": "date" },
    "verified_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
