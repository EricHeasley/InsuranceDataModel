{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan_benefit",
  "description": "Cost sharing and limits for a category of service under a plan and network tier.",
  "type": "object",
  "x-primaryKey": ["plan_benefit_id"],
  "x-unique": [
    ["health_plan_id", "benefit_code", "network_tier"]
  ],
  "required": ["plan_benefit_id", "health_plan_id", "benefit_code", "name", "network_tier", "is_covered"],
  "properties": {
    "plan_benefit_id": { "type": "string", "format": "uuid" },
    "health_plan_id": { "type": "string", "format": "uuid", "x-references": "health_plan.health_plan_id" },
    "benefit_code": {
      "type": "string",
      "maxLength": 30,
      "description": "Service category, e.g. PCP_VISIT, SPECIALIST, ER, INPATIENT, RX_TIER_1, PREVENTIVE_DENTAL."
    },
    "name": { "type": "string", "maxLength": 255 },
    "network_tier": { "type": "string", "enum": ["IN_NETWORK", "PREFERRED", "OUT_OF_NETWORK", "ANY"] },
    "is_covered": { "type": "boolean" },
    "copay_amount": { "type": "number", "format": "money" },
    "coinsurance_percent": { "type": "number", "format": "percent", "description": "Member share." },
    "deductible_applies": { "type": "boolean" },
    "limit_quantity": { "type": "number", "format": "decimal" },
    "limit_unit": { "type": "string", "maxLength": 20, "description": "VISITS, DAYS, DOLLARS, UNITS." },
    "limit_period": {
      "type": "string",
      "enum": [
        "PER_OCCURRENCE", "PER_CLAIM", "PER_PERSON", "PER_ACCIDENT", "PER_ITEM", "PER_LOCATION", "PER_DAY",
        "PER_WEEK", "PER_MONTH", "PER_VISIT", "AGGREGATE", "POLICY_PERIOD", "CALENDAR_YEAR", "LIFETIME",
        "NOT_APPLICABLE"
      ]
    },
    "requires_prior_authorization": { "type": "boolean" },
    "requires_referral": { "type": "boolean" },
    "waiting_period_days": { "type": "integer" }
  },
  "additionalProperties": false
}
