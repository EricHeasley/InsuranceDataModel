{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health_claim_line",
  "description": "A service line of a health claim with its adjudicated amounts.",
  "type": "object",
  "x-primaryKey": ["health_claim_line_id"],
  "x-unique": [
    ["health_claim_id", "line_number"]
  ],
  "required": [
    "health_claim_line_id", "health_claim_id", "line_number", "claim_line_status", "service_from_date",
    "billed_amount"
  ],
  "properties": {
    "health_claim_line_id": { "type": "string", "format": "uuid" },
    "health_claim_id": { "type": "string", "format": "uuid", "x-references": "health_claim.health_claim_id" },
    "line_number": { "type": "integer" },
    "claim_line_status": { "type": "string", "enum": ["PENDED", "APPROVED", "DENIED", "ADJUSTED"] },
    "service_from_date": { "type": "string", "format": "date", "x-sensitivity": "PHI" },
    "service_to_date": { "type": "string", "format": "date", "x-sensitivity": "PHI" },
    "procedure_code_value_id": {
      "type": "string",
      "format": "uuid",
      "description": "CPT, HCPCS or CDT code.",
      "x-references": "code_value.code_value_id",
      "x-sensitivity": "PHI"
    },
    "modifier_1": { "type": "string", "maxLength": 2 },
    "modifier_2": { "type": "string", "maxLength": 2 },
    "modifier_3": { "type": "string", "maxLength": 2 },
    "modifier_4": { "type": "string", "maxLength": 2 },
    "revenue_code": { "type": "string", "maxLength": 4 },
    "ndc_code": { "type": "string", "maxLength": 11, "description": "National Drug Code.", "x-sensitivity": "PHI" },
    "tooth_number": { "type": "string", "maxLength": 5 },
    "place_of_service_code": { "type": "string", "maxLength": 2 },
    "diagnosis_pointers": { "type": "string", "maxLength": 20, "description": "Sequence numbers of related diagnoses." },
    "rendering_provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "plan_benefit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Benefit the line was adjudicated under.",
      "x-references": "plan_benefit.plan_benefit_id"
    },
    "units": { "type": "number", "format": "decimal" },
    "days_supply": { "type": "integer" },
    "billed_amount": { "type": "number", "format": "money" },
    "allowed_amount": { "type": "number", "format": "money" },
    "not_covered_amount": { "type": "number", "format": "money" },
    "deductible_amount": { "type": "number", "format": "money" },
    "copay_amount": { "type": "number", "format": "money" },
    "coinsurance_amount": { "type": "number", "format": "money" },
    "other_payer_paid_amount": { "type": "number", "format": "money" },
    "paid_amount": { "type": "number", "format": "money" }
  },
  "additionalProperties": false
}
