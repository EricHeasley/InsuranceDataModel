{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "disability_claim_detail",
  "description": "Disability, long-term care and waiver specific attributes of a claim.",
  "type": "object",
  "x-primaryKey": ["claim_id"],
  "x-subtypeOf": "claim",
  "required": ["claim_id", "disability_type", "claimant_party_id", "disability_date"],
  "properties": {
    "claim_id": { "type": "string", "format": "uuid", "x-references": "claim.claim_id" },
    "disability_type": {
      "type": "string",
      "enum": ["SHORT_TERM", "LONG_TERM", "WAIVER_OF_PREMIUM", "LONG_TERM_CARE", "PAID_FAMILY_LEAVE"]
    },
    "claimant_party_id": { "type": "string", "format": "uuid", "x-references": "person.party_id" },
    "disability_date": { "type": "string", "format": "date" },
    "last_day_worked": { "type": "string", "format": "date" },
    "primary_diagnosis_code_value_id": { "type": "string", "format": "uuid", "x-references": "code_value.code_value_id", "x-sensitivity": "PHI" },
    "elimination_period_days": { "type": "integer" },
    "benefit_start_date": { "type": "string", "format": "date" },
    "maximum_benefit_end_date": { "type": "string", "format": "date" },
    "gross_benefit_amount": { "type": "number", "format": "money" },
    "benefit_frequency": {
      "type": "string",
      "enum": ["ANNUAL", "SEMI_ANNUAL", "QUARTERLY", "MONTHLY", "BIWEEKLY", "WEEKLY", "SINGLE", "FLEXIBLE"]
    },
    "predisability_earnings_amount": { "type": "number", "format": "money", "x-sensitivity": "SPI" },
    "offset_amount": { "type": "number", "format": "money", "description": "Social Security, workers' comp and other income offsets." },
    "own_occupation_end_date": {
      "type": "string",
      "format": "date",
      "description": "Date the definition of disability changes from own to any occupation."
    },
    "expected_return_to_work_date": { "type": "string", "format": "date" },
    "actual_return_to_work_date": { "type": "string", "format": "date" },
    "is_work_related": { "type": "boolean" },
    "ssdi_award_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
