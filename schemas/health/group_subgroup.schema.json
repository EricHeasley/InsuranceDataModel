{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "group_subgroup",
  "description": "A division, class or billing unit within an employer group, with the plans offered to it.",
  "type": "object",
  "x-primaryKey": ["group_subgroup_id"],
  "x-unique": [
    ["policy_id", "subgroup_code"]
  ],
  "required": ["group_subgroup_id", "policy_id", "subgroup_code", "name", "effective_date"],
  "properties": {
    "group_subgroup_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "employer_group.policy_id" },
    "subgroup_code": { "type": "string", "maxLength": 30 },
    "name": { "type": "string", "maxLength": 255 },
    "eligibility_class": { "type": "string", "maxLength": 50, "description": "E.g. salaried, hourly, executives, retirees." },
    "billing_account_id": { "type": "string", "format": "uuid", "x-references": "billing_account.billing_account_id" },
    "effective_date": { "type": "string", "format": "date" },
    "termination_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
