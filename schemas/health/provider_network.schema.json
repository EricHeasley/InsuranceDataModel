{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "provider_network",
  "description": "A contracted network of providers that plans use to define in-network benefits.",
  "type": "object",
  "x-primaryKey": ["provider_network_id"],
  "x-unique": [
    ["network_code"]
  ],
  "required": ["provider_network_id", "network_code", "name"],
  "properties": {
    "provider_network_id": { "type": "string", "format": "uuid" },
    "network_code": { "type": "string", "maxLength": 30 },
    "name": { "type": "string", "maxLength": 255 },
    "network_type": { "type": "string", "maxLength": 30, "description": "MEDICAL, DENTAL, VISION, PHARMACY, BEHAVIORAL." },
    "is_leased": { "type": "boolean", "description": "Rented from a third-party network." }
  },
  "additionalProperties": false
}
