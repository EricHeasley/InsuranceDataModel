{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "employer_group",
  "description": "Group-specific attributes of a group master policy: the employer or association sponsoring coverage for its members.",
  "type": "object",
  "x-primaryKey": ["policy_id"],
  "x-subtypeOf": "policy",
  "required": ["policy_id", "group_number", "sponsor_party_id", "market_segment"],
  "properties": {
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "group_number": { "type": "string", "maxLength": 30 },
    "sponsor_party_id": { "type": "string", "format": "uuid", "x-references": "organization.party_id" },
    "market_segment": {
      "type": "string",
      "enum": ["INDIVIDUAL", "SMALL_GROUP", "LARGE_GROUP", "SELF_FUNDED", "MEDICARE", "MEDICAID", "STUDENT", "ASSOCIATION"]
    },
    "eligible_employee_count": { "type": "integer" },
    "enrolled_employee_count": { "type": "integer" },
    "new_hire_waiting_period_days": { "type": "integer" },
    "employer_contribution_percent": { "type": "number", "format": "percent" },
    "plan_year_start_month": { "type": "integer" },
    "is_erisa_plan": { "type": "boolean" },
    "is_cobra_eligible": { "type": "boolean" },
    "funding_arrangement": { "type": "string", "maxLength": 30, "description": "FULLY_INSURED, LEVEL_FUNDED, ASO, MINIMUM_PREMIUM." },
    "stop_loss_specific_attachment_amount": { "type": "number", "format": "money" },
    "stop_loss_aggregate_attachment_percent": { "type": "number", "format": "percent" }
  },
  "additionalProperties": false
}
