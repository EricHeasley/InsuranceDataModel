{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health_claim_line_adjustment",
  "description": "A reason-coded difference between billed and paid amounts on a claim line (X12 835 CAS adjustment).",
  "type": "object",
  "x-primaryKey": ["health_claim_line_adjustment_id"],
  "required": [
    "health_claim_line_adjustment_id", "health_claim_line_id", "adjustment_group_code", "reason_code_value_id",
    "amount"
  ],
  "properties": {
    "health_claim_line_adjustment_id": { "type": "string", "format": "uuid" },
    "health_claim_line_id": { "type": "string", "format": "uuid", "x-references": "health_claim_line.health_claim_line_id" },
    "adjustment_group_code": {
      "type": "string",
      "maxLength": 2,
      "description": "CO contractual, PR patient responsibility, OA other, PI payer initiated."
    },
    "reason_code_value_id": {
      "type": "string",
      "format": "uuid",
      "description": "Claim adjustment reason code (CARC).",
      "x-references": "code_value.code_value_id"
    },
    "remark_code_value_id": {
      "type": "string",
      "format": "uuid",
      "description": "Remittance advice remark code (RARC).",
      "x-references": "code_value.code_value_id"
    },
    "amount": { "type": "number", "format": "money" }
  },
  "additionalProperties": false
}
