{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "network_participation",
  "description": "Participation of a provider in a network at a practice location over a period, with the reimbursement arrangement.",
  "type": "object",
  "x-primaryKey": ["network_participation_id"],
  "required": ["network_participation_id", "provider_network_id", "provider_id", "effective_date"],
  "properties": {
    "network_participation_id": { "type": "string", "format": "uuid" },
    "provider_network_id": { "type": "string", "format": "uuid", "x-references": "provider_network.provider_network_id" },
    "provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "practice_address_id": { "type": "string", "format": "uuid", "x-references": "address.address_id" },
    "network_tier": { "type": "string", "enum": ["IN_NETWORK", "PREFERRED", "OUT_OF_NETWORK", "ANY"] },
    "contract_number": { "type": "string", "maxLength": 50 },
    "reimbursement_method": {
      "type": "string",
      "maxLength": 30,
      "description": "FEE_SCHEDULE, PERCENT_OF_CHARGES, PERCENT_OF_MEDICARE, DRG, PER_DIEM, CAPITATION, CASE_RATE."
    },
    "reimbursement_percent": { "type": "number", "format": "percent" },
    "fee_schedule_code": { "type": "string", "maxLength": 30 },
    "effective_date": { "type": "string", "format": "date" },
    "termination_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
