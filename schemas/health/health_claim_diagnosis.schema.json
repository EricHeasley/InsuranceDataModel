{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health_claim_diagnosis",
  "description": "A diagnosis reported on a health claim.",
  "type": "object",
  "x-primaryKey": ["health_claim_diagnosis_id"],
  "x-unique": [
    ["health_claim_id", "sequence_number"]
  ],
  "required": [
    "health_claim_diagnosis_id", "health_claim_id", "sequence_number", "diagnosis_code_value_id",
    "diagnosis_qualifier"
  ],
  "properties": {
    "health_claim_diagnosis_id": { "type": "string", "format": "uuid" },
    "health_claim_id": { "type": "string", "format": "uuid", "x-references": "health_claim.health_claim_id" },
    "sequence_number": { "type": "integer" },
    "diagnosis_code_value_id": {
      "type": "string",
      "format": "uuid",
      "description": "ICD-10-CM code.",
      "x-references": "code_value.code_value_id",
      "x-sensitivity": "PHI"
    },
    "diagnosis_qualifier": {
      "type": "string",
      "enum": ["PRINCIPAL", "ADMITTING", "SECONDARY", "EXTERNAL_CAUSE", "PATIENT_REASON_FOR_VISIT"]
    },
    "present_on_admission": { "type": "string", "maxLength": 1 }
  },
  "additionalProperties": false
}
