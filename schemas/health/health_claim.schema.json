{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health_claim",
  "description": "A claim for health care services submitted by a provider or member, as adjudicated. Adjustments are new claims that point to the claim they replace.",
  "type": "object",
  "x-primaryKey": ["health_claim_id"],
  "x-unique": [
    ["claim_number"]
  ],
  "required": [
    "health_claim_id", "claim_number", "health_claim_type", "health_claim_status", "enrollment_id", "received_date",
    "service_from_date", "billed_amount"
  ],
  "properties": {
    "health_claim_id": { "type": "string", "format": "uuid" },
    "claim_number": { "type": "string", "maxLength": 30 },
    "health_claim_type": {
      "type": "string",
      "oneOf": [
        { "const": "PROFESSIONAL", "description": "CMS-1500 / 837P" },
        { "const": "INSTITUTIONAL", "description": "UB-04 / 837I" },
        { "const": "DENTAL", "description": "ADA / 837D" },
        { "const": "PHARMACY", "description": "NCPDP" },
        { "const": "VISION" },
        { "const": "MEMBER_REIMBURSEMENT" }
      ]
    },
    "health_claim_status": {
      "type": "string",
      "enum": [
        "RECEIVED", "PENDED", "IN_REVIEW", "ADJUDICATED", "PAID", "DENIED", "PARTIALLY_DENIED", "ADJUSTED",
        "REVERSED", "VOIDED"
      ]
    },
    "enrollment_id": {
      "type": "string",
      "format": "uuid",
      "description": "Coverage span of the patient the claim is adjudicated under.",
      "x-references": "enrollment.enrollment_id"
    },
    "billing_provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "rendering_provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "facility_provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "referring_provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "network_tier": { "type": "string", "enum": ["IN_NETWORK", "PREFERRED", "OUT_OF_NETWORK", "ANY"] },
    "received_date": { "type": "string", "format": "date" },
    "service_from_date": { "type": "string", "format": "date", "x-sensitivity": "PHI" },
    "service_to_date": { "type": "string", "format": "date", "x-sensitivity": "PHI" },
    "admission_date": { "type": "string", "format": "date", "x-sensitivity": "PHI" },
    "discharge_date": { "type": "string", "format": "date", "x-sensitivity": "PHI" },
    "type_of_bill": { "type": "string", "maxLength": 4, "description": "UB-04 type of bill." },
    "place_of_service_code": { "type": "string", "maxLength": 2 },
    "drg_code_value_id": { "type": "string", "format": "uuid", "x-references": "code_value.code_value_id", "x-sensitivity": "PHI" },
    "discharge_status_code": { "type": "string", "maxLength": 2 },
    "claim_frequency_code": { "type": "string", "maxLength": 1, "description": "1 original, 7 replacement, 8 void." },
    "replaces_health_claim_id": { "type": "string", "format": "uuid", "x-references": "health_claim.health_claim_id" },
    "prior_authorization_id": { "type": "string", "format": "uuid", "x-references": "prior_authorization.prior_authorization_id" },
    "submitter_claim_id": { "type": "string", "maxLength": 50, "description": "Patient control number from the provider." },
    "billed_amount": { "type": "number", "format": "money" },
    "allowed_amount": { "type": "number", "format": "money" },
    "paid_amount": { "type": "number", "format": "money" },
    "member_responsibility_amount": { "type": "number", "format": "money" },
    "other_payer_paid_amount": { "type": "number", "format": "money" },
    "adjudicated_at": { "type": "string", "format": "date-time" },
    "accounting_date": { "type": "string", "format": "date" },
    "is_accident_related": { "type": "boolean" },
    "accident_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
