{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prior_authorization",
  "description": "A request for approval of services before they are rendered, and the utilization management decision.",
  "type": "object",
  "x-primaryKey": ["prior_authorization_id"],
  "x-unique": [
    ["authorization_number"]
  ],
  "required": ["prior_authorization_id", "authorization_number", "enrollment_id", "authorization_status", "requested_at"],
  "properties": {
    "prior_authorization_id": { "type": "string", "format": "uuid" },
    "authorization_number": { "type": "string", "maxLength": 30 },
    "enrollment_id": { "type": "string", "format": "uuid", "x-references": "enrollment.enrollment_id" },
    "requesting_provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "servicing_provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "authorization_status": {
      "type": "string",
      "enum": ["REQUESTED", "PENDED", "APPROVED", "PARTIALLY_APPROVED", "DENIED", "WITHDRAWN", "EXPIRED"]
    },
    "service_type": {
      "type": "string",
      "maxLength": 50,
      "description": "INPATIENT, OUTPATIENT_SURGERY, IMAGING, DME, SPECIALTY_DRUG, ..."
    },
    "is_urgent": { "type": "boolean" },
    "procedure_code_value_id": { "type": "string", "format": "uuid", "x-references": "code_value.code_value_id", "x-sensitivity": "PHI" },
    "diagnosis_code_value_id": { "type": "string", "format": "uuid", "x-references": "code_value.code_value_id", "x-sensitivity": "PHI" },
    "requested_units": { "type": "number", "format": "decimal" },
    "approved_units": { "type": "number", "format": "decimal" },
    "requested_at": { "type": "string", "format": "date-time" },
    "decided_at": { "type": "string", "format": "date-time" },
    "valid_from": { "type": "string", "format": "date" },
    "valid_to": { "type": "string", "format": "date" },
    "denial_reason": { "type": "string", "maxLength": 200 },
    "reviewer_staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" }
  },
  "additionalProperties": false
}
