{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "provider",
  "description": "A health care practitioner, group or facility that renders or bills services.",
  "type": "object",
  "x-primaryKey": ["provider_id"],
  "required": ["provider_id", "party_id", "provider_type"],
  "properties": {
    "provider_id": { "type": "string", "format": "uuid" },
    "party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "npi": { "type": "string", "maxLength": 10, "description": "National Provider Identifier." },
    "provider_type": {
      "type": "string",
      "enum": [
        "INDIVIDUAL_PRACTITIONER", "GROUP_PRACTICE", "HOSPITAL", "AMBULATORY_FACILITY", "SKILLED_NURSING",
        "HOME_HEALTH", "PHARMACY", "LABORATORY", "DME_SUPPLIER", "DENTAL", "VISION", "BEHAVIORAL_HEALTH", "OTHER"
      ]
    },
    "taxonomy_code_value_id": {
      "type": "string",
      "format": "uuid",
      "description": "NUCC health care provider taxonomy code.",
      "x-references": "code_value.code_value_id"
    },
    "specialty": { "type": "string", "maxLength": 100 },
    "billing_group_provider_id": {
      "type": "string",
      "format": "uuid",
      "description": "Group practice the practitioner bills under.",
      "x-references": "provider.provider_id"
    },
    "credentialed_on": { "type": "string", "format": "date" },
    "recredential_due_on": { "type": "string", "format": "date" },
    "is_accepting_new_patients": { "type": "boolean" },
    "is_sanctioned": { "type": "boolean", "description": "Excluded from federal programs (OIG/SAM)." }
  },
  "additionalProperties": false
}
