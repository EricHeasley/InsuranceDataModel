{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "enrollment_rate",
  "description": "Premium rate for an enrollment over a period, with its split between employer, member and subsidy.",
  "type": "object",
  "x-primaryKey": ["enrollment_rate_id"],
  "required": ["enrollment_rate_id", "enrollment_id", "effective_date", "monthly_premium_amount"],
  "properties": {
    "enrollment_rate_id": { "type": "string", "format": "uuid" },
    "enrollment_id": { "type": "string", "format": "uuid", "x-references": "enrollment.enrollment_id" },
    "effective_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "monthly_premium_amount": { "type": "number", "format": "money" },
    "employer_contribution_amount": { "type": "number", "format": "money" },
    "member_contribution_amount": { "type": "number", "format": "money" },
    "advance_premium_tax_credit_amount": { "type": "number", "format": "money", "description": "ACA APTC subsidy." },
    "rating_area": { "type": "string", "maxLength": 20 },
    "rated_age": { "type": "integer" },
    "tobacco_surcharge_amount": { "type": "number", "format": "money" }
  },
  "additionalProperties": false
}
