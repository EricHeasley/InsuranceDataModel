{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "member",
  "description": "A person covered or formerly covered by health or group benefits, identified by a member ID.",
  "type": "object",
  "x-primaryKey": ["member_id"],
  "x-unique": [
    ["member_number"]
  ],
  "required": ["member_id", "party_id", "member_number"],
  "properties": {
    "member_id": { "type": "string", "format": "uuid" },
    "party_id": { "type": "string", "format": "uuid", "x-references": "person.party_id" },
    "member_number": { "type": "string", "maxLength": 30, "description": "ID printed on the member's card.", "x-sensitivity": "PHI" },
    "medicare_eligibility_reason": { "type": "string", "maxLength": 20, "description": "AGE, DISABILITY, ESRD." },
    "is_tobacco_user": { "type": "boolean", "x-sensitivity": "PHI" }
  },
  "additionalProperties": false
}
