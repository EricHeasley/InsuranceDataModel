{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "enrollment",
  "description": "A span of a member's coverage in a plan under a policy (individual policy or group master). Subscribers and dependents each have their own spans; dependents point to the subscriber.",
  "type": "object",
  "x-primaryKey": ["enrollment_id"],
  "required": [
    "enrollment_id", "policy_id", "health_plan_id", "member_id", "subscriber_member_id", "member_relationship",
    "enrollment_status", "effective_date"
  ],
  "properties": {
    "enrollment_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "health_plan_id": { "type": "string", "format": "uuid", "x-references": "health_plan.health_plan_id" },
    "member_id": { "type": "string", "format": "uuid", "x-references": "member.member_id" },
    "subscriber_member_id": { "type": "string", "format": "uuid", "x-references": "member.member_id" },
    "member_relationship": {
      "type": "string",
      "enum": ["SELF", "SPOUSE", "DOMESTIC_PARTNER", "CHILD", "DISABLED_DEPENDENT", "OTHER_DEPENDENT"]
    },
    "coverage_tier": {
      "type": "string",
      "enum": ["EMPLOYEE_ONLY", "EMPLOYEE_SPOUSE", "EMPLOYEE_CHILDREN", "FAMILY", "INDIVIDUAL", "CHILD_ONLY"]
    },
    "group_subgroup_id": { "type": "string", "format": "uuid", "x-references": "group_subgroup.group_subgroup_id" },
    "enrollment_status": { "type": "string", "enum": ["PENDING", "ACTIVE", "TERMINATED", "CANCELLED", "COBRA", "GRACE_PERIOD"] },
    "effective_date": { "type": "string", "format": "date" },
    "termination_date": { "type": "string", "format": "date" },
    "termination_reason": { "type": "string", "maxLength": 50 },
    "enrollment_source": { "type": "string", "maxLength": 30, "description": "EDI_834, EXCHANGE, PORTAL, PAPER, ..." },
    "qualifying_event": { "type": "string", "maxLength": 50, "description": "Special enrollment or COBRA qualifying event." },
    "primary_care_provider_id": { "type": "string", "format": "uuid", "x-references": "provider.provider_id" },
    "exchange_subscriber_id": { "type": "string", "maxLength": 30 },
    "paid_through_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
