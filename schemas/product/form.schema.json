{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "form",
  "description": "A policy form, endorsement or notice edition (ISO, NCCI, ACORD or proprietary).",
  "type": "object",
  "x-primaryKey": ["form_id"],
  "x-unique": [
    ["form_number", "edition"]
  ],
  "required": ["form_id", "form_number", "edition", "title", "form_type"],
  "properties": {
    "form_id": { "type": "string", "format": "uuid" },
    "form_number": { "type": "string", "maxLength": 50 },
    "edition": { "type": "string", "maxLength": 20, "description": "Edition date as printed, e.g. 04 13." },
    "title": { "type": "string", "maxLength": 255 },
    "form_type": {
      "type": "string",
      "enum": [
        "POLICY_JACKET", "COVERAGE_FORM", "DECLARATIONS", "ENDORSEMENT", "RIDER", "NOTICE", "APPLICATION",
        "CERTIFICATE"
      ]
    },
    "publisher": { "type": "string", "maxLength": 50, "description": "ISO, NCCI, AAIS, ACORD or the company." },
    "template_document_id": { "type": "string", "format": "uuid", "x-references": "document.document_id" }
  },
  "additionalProperties": false
}
