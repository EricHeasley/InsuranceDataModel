{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_form",
  "description": "Approval of a form for use with a product in a jurisdiction.",
  "type": "object",
  "x-primaryKey": ["product_form_id"],
  "required": ["product_form_id", "product_id", "form_id", "form_usage", "effective_on"],
  "properties": {
    "product_form_id": { "type": "string", "format": "uuid" },
    "product_id": { "type": "string", "format": "uuid", "x-references": "product.product_id" },
    "form_id": { "type": "string", "format": "uuid", "x-references": "form.form_id" },
    "jurisdiction_code": {
      "type": "string",
      "maxLength": 6,
      "description": "Null for countrywide forms.",
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "coverage_definition_id": {
      "type": "string",
      "format": "uuid",
      "description": "Coverage whose selection triggers the form, if any.",
      "x-references": "coverage_definition.coverage_definition_id"
    },
    "form_usage": { "type": "string", "enum": ["MANDATORY", "CONDITIONAL", "OPTIONAL"] },
    "product_filing_id": { "type": "string", "format": "uuid", "x-references": "product_filing.product_filing_id" },
    "effective_on": { "type": "string", "format": "date" },
    "expires_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
