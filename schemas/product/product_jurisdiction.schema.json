{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_jurisdiction",
  "description": "Availability of a product in a jurisdiction through a specific writing company.",
  "type": "object",
  "x-primaryKey": ["product_jurisdiction_id"],
  "required": ["product_jurisdiction_id", "product_id", "jurisdiction_code", "insurer_id", "new_business_effective_on"],
  "properties": {
    "product_jurisdiction_id": { "type": "string", "format": "uuid" },
    "product_id": { "type": "string", "format": "uuid", "x-references": "product.product_id" },
    "jurisdiction_code": { "type": "string", "maxLength": 6, "x-references": "jurisdiction.jurisdiction_code" },
    "insurer_id": { "type": "string", "format": "uuid", "x-references": "insurer.insurer_id" },
    "new_business_effective_on": { "type": "string", "format": "date" },
    "renewal_effective_on": { "type": "string", "format": "date" },
    "closed_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
