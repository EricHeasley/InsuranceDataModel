{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage_term_definition",
  "description": "A limit, deductible, coinsurance, waiting period or other quantitative term that a coverage can carry, with its allowed range.",
  "type": "object",
  "x-primaryKey": ["coverage_term_definition_id"],
  "x-unique": [
    ["coverage_definition_id", "term_code"]
  ],
  "required": [
    "coverage_term_definition_id", "coverage_definition_id", "term_code", "name", "coverage_term_type",
    "coverage_term_basis", "term_value_type", "is_required"
  ],
  "properties": {
    "coverage_term_definition_id": { "type": "string", "format": "uuid" },
    "coverage_definition_id": { "type": "string", "format": "uuid", "x-references": "coverage_definition.coverage_definition_id" },
    "term_code": { "type": "string", "maxLength": 30 },
    "name": { "type": "string", "maxLength": 255 },
    "coverage_term_type": {
      "type": "string",
      "enum": [
        "LIMIT", "SUBLIMIT", "DEDUCTIBLE", "SELF_INSURED_RETENTION", "COINSURANCE", "COPAY", "OUT_OF_POCKET_MAX",
        "WAITING_PERIOD", "ELIMINATION_PERIOD", "BENEFIT_PERIOD", "BENEFIT_AMOUNT", "FACE_AMOUNT", "OPTION"
      ]
    },
    "coverage_term_basis": {
      "type": "string",
      "enum": [
        "PER_OCCURRENCE", "PER_CLAIM", "PER_PERSON", "PER_ACCIDENT", "PER_ITEM", "PER_LOCATION", "PER_DAY",
        "PER_WEEK", "PER_MONTH", "PER_VISIT", "AGGREGATE", "POLICY_PERIOD", "CALENDAR_YEAR", "LIFETIME",
        "NOT_APPLICABLE"
      ]
    },
    "term_value_type": { "type": "string", "enum": ["AMOUNT", "PERCENT", "DAYS", "MONTHS", "COUNT", "CODE"] },
    "default_value": { "type": "number", "format": "decimal" },
    "minimum_value": { "type": "number", "format": "decimal" },
    "maximum_value": { "type": "number", "format": "decimal" },
    "is_required": { "type": "boolean" }
  },
  "additionalProperties": false
}
