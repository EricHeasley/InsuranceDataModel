{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_filing",
  "description": "A rate, rule or form filing made with a regulator for a product (typically via SERFF).",
  "type": "object",
  "x-primaryKey": ["product_filing_id"],
  "required": ["product_filing_id", "product_id", "jurisdiction_code", "filing_type", "filing_status"],
  "properties": {
    "product_filing_id": { "type": "string", "format": "uuid" },
    "product_id": { "type": "string", "format": "uuid", "x-references": "product.product_id" },
    "jurisdiction_code": { "type": "string", "maxLength": 6, "x-references": "jurisdiction.jurisdiction_code" },
    "insurer_id": { "type": "string", "format": "uuid", "x-references": "insurer.insurer_id" },
    "filing_type": { "type": "string", "enum": ["RATE", "RULE", "FORM", "RATE_AND_RULE", "PRODUCT", "ADVERTISING"] },
    "filing_status": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "APPROVED", "ACKNOWLEDGED", "DISAPPROVED", "WITHDRAWN"] },
    "tracking_number": { "type": "string", "maxLength": 50, "description": "SERFF or state tracking number." },
    "overall_rate_change_percent": { "type": "number", "format": "percent" },
    "submitted_on": { "type": "string", "format": "date" },
    "disposition_on": { "type": "string", "format": "date" },
    "new_business_effective_on": { "type": "string", "format": "date" },
    "renewal_effective_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
