{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/party/party_consent.schema.json",
  "title": "party_consent",
  "description": "A consent, authorization or communication preference given by a party.",
  "x-primaryKey": ["party_consent_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "party_consent_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "party_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "party.party_id"
    },
    "consent_type": {
      "$ref": "enums/consent_type.schema.json"
    },
    "consent_status": {
      "$ref": "enums/consent_status.schema.json"
    },
    "captured_at": {
      "$ref": "../common/types.schema.json#/$defs/timestamp"
    },
    "capture_channel": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 30
    },
    "expires_on": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "evidence_document_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "document.document_id"
    }
  },
  "required": ["party_consent_id", "party_id", "consent_type", "consent_status", "captured_at"],
  "unevaluatedProperties": false
}
