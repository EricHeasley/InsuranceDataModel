{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contact_point",
  "description": "An email address, phone number or other channel for reaching a party.",
  "type": "object",
  "x-primaryKey": ["contact_point_id"],
  "required": ["contact_point_id", "party_id", "contact_point_type", "contact_value", "is_primary"],
  "properties": {
    "contact_point_id": { "type": "string", "format": "uuid" },
    "party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "contact_point_type": { "type": "string", "enum": ["EMAIL", "PHONE", "MOBILE", "FAX", "PORTAL", "OTHER"] },
    "contact_value": { "type": "string", "maxLength": 320, "x-sensitivity": "PII" },
    "contact_usage": { "type": "string", "enum": ["HOME", "WORK", "OTHER"] },
    "is_primary": { "type": "boolean" },
    "is_verified": { "type": "boolean" },
    "do_not_contact": { "type": "boolean" }
  },
  "additionalProperties": false
}
