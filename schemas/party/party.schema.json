{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "party",
  "description": "A person or organization of interest to the business in any capacity. Supertype of person and organization.",
  "type": "object",
  "x-primaryKey": ["party_id"],
  "required": ["party_id", "party_type", "display_name", "party_status"],
  "properties": {
    "party_id": { "type": "string", "format": "uuid" },
    "party_type": { "type": "string", "enum": ["PERSON", "ORGANIZATION"] },
    "display_name": {
      "type": "string",
      "maxLength": 255,
      "description": "Full name formatted for display and search.",
      "x-sensitivity": "PII"
    },
    "party_status": {
      "type": "string",
      "oneOf": [
        { "const": "ACTIVE" },
        { "const": "INACTIVE" },
        { "const": "DECEASED" },
        { "const": "DISSOLVED" },
        { "const": "MERGED", "description": "Merged into another party record as a duplicate" }
      ]
    },
    "merged_into_party_id": {
      "type": "string",
      "format": "uuid",
      "description": "Surviving record when this one was merged as a duplicate.",
      "x-references": "party.party_id"
    },
    "preferred_language": { "type": "string", "maxLength": 10, "description": "BCP 47 language tag." }
  },
  "additionalProperties": false
}
