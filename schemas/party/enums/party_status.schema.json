{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/party/enums/party_status.schema.json",
  "title": "party_status",
  "description": "Lifecycle status of a party record.",
  "type": "string",
  "oneOf": [
    {
      "const": "ACTIVE"
    },
    {
      "const": "INACTIVE"
    },
    {
      "const": "DECEASED"
    },
    {
      "const": "DISSOLVED"
    },
    {
      "const": "MERGED",
      "description": "Merged into another party record as a duplicate"
    }
  ]
}
