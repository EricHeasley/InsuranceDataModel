{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "person",
  "description": "A natural person.",
  "type": "object",
  "x-primaryKey": ["party_id"],
  "x-subtypeOf": "party",
  "required": ["party_id", "last_name"],
  "properties": {
    "party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "first_name": { "type": "string", "maxLength": 100, "x-sensitivity": "PII" },
    "middle_name": { "type": "string", "maxLength": 100, "x-sensitivity": "PII" },
    "last_name": { "type": "string", "maxLength": 100, "x-sensitivity": "PII" },
    "name_suffix": { "type": "string", "maxLength": 20 },
    "birth_date": { "type": "string", "format": "date", "x-sensitivity": "PII" },
    "death_date": { "type": "string", "format": "date", "x-sensitivity": "PII" },
    "gender": { "type": "string", "enum": ["FEMALE", "MALE", "NONBINARY", "UNKNOWN"], "x-sensitivity": "SPI" },
    "marital_status": {
      "type": "string",
      "enum": ["SINGLE", "MARRIED", "DOMESTIC_PARTNER", "DIVORCED", "SEPARATED", "WIDOWED", "UNKNOWN"],
      "x-sensitivity": "SPI"
    },
    "occupation": { "type": "string", "maxLength": 255 }
  },
  "additionalProperties": false
}
