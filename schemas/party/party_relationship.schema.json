{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "party_relationship",
  "description": "A directed relationship between two parties (family, household, employment, ownership, legal representation).",
  "type": "object",
  "x-primaryKey": ["party_relationship_id"],
  "required": ["party_relationship_id", "from_party_id", "to_party_id", "party_relationship_type"],
  "properties": {
    "party_relationship_id": { "type": "string", "format": "uuid" },
    "from_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "to_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "party_relationship_type": {
      "type": "string",
      "oneOf": [
        { "const": "SPOUSE" },
        { "const": "DOMESTIC_PARTNER" },
        { "const": "CHILD" },
        { "const": "PARENT" },
        { "const": "DEPENDENT" },
        { "const": "HOUSEHOLD_MEMBER" },
        { "const": "EMPLOYEE", "description": "From-party is employed by to-party" },
        { "const": "OWNER", "description": "From-party owns to-party" },
        { "const": "SUBSIDIARY", "description": "From-party is a subsidiary of to-party" },
        { "const": "TRUSTEE" },
        { "const": "GUARDIAN" },
        { "const": "POWER_OF_ATTORNEY" },
        { "const": "ATTORNEY", "description": "From-party legally represents to-party" },
        { "const": "CONTACT", "description": "From-party is a contact person for to-party" },
        { "const": "OTHER" }
      ]
    },
    "ownership_percent": { "type": "number", "format": "percent", "description": "For OWNER relationships." },
    "valid_from": { "type": "string", "format": "date" },
    "valid_to": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
