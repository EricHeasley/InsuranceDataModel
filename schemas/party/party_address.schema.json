{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "party_address",
  "description": "Use of an address by a party over a period.",
  "type": "object",
  "x-primaryKey": ["party_address_id"],
  "required": ["party_address_id", "party_id", "address_id", "address_usage", "is_primary"],
  "properties": {
    "party_address_id": { "type": "string", "format": "uuid" },
    "party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "address_id": { "type": "string", "format": "uuid", "x-references": "address.address_id" },
    "address_usage": { "type": "string", "enum": ["RESIDENCE", "MAILING", "BILLING", "BUSINESS", "PRACTICE", "PAY_TO", "OTHER"] },
    "is_primary": { "type": "boolean" },
    "valid_from": { "type": "string", "format": "date" },
    "valid_to": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
