{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document",
  "description": "Metadata for a stored document or image (application, policy declaration, loss photo, medical record, correspondence). Content lives in a document store.",
  "type": "object",
  "x-primaryKey": ["document_id"],
  "required": ["document_id", "document_type", "storage_uri"],
  "properties": {
    "document_id": { "type": "string", "format": "uuid" },
    "document_type": {
      "type": "string",
      "maxLength": 50,
      "description": "E.g. APPLICATION, DECLARATIONS, ENDORSEMENT, INVOICE, LOSS_PHOTO, ESTIMATE, MEDICAL_RECORD, EOB, CORRESPONDENCE."
    },
    "title": { "type": "string", "maxLength": 255 },
    "storage_uri": { "type": "string", "maxLength": 1000 },
    "mime_type": { "type": "string", "maxLength": 100 },
    "content_hash": { "type": "string", "maxLength": 128, "description": "Digest of the content for integrity." },
    "received_at": { "type": "string", "format": "date-time" },
    "direction": { "type": "string", "maxLength": 10, "description": "INBOUND, OUTBOUND or INTERNAL." },
    "contains_phi": { "type": "boolean" },
    "party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "submission_id": { "type": "string", "format": "uuid", "x-references": "submission.submission_id" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "policy_transaction_id": { "type": "string", "format": "uuid", "x-references": "policy_transaction.policy_transaction_id" },
    "claim_id": { "type": "string", "format": "uuid", "x-references": "claim.claim_id" },
    "health_claim_id": { "type": "string", "format": "uuid", "x-references": "health_claim.health_claim_id" },
    "billing_account_id": { "type": "string", "format": "uuid", "x-references": "billing_account.billing_account_id" }
  },
  "additionalProperties": false
}
