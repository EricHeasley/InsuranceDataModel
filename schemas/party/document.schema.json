{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/party/document.schema.json",
  "title": "document",
  "description": "Metadata for a stored document or image (application, policy declaration, loss photo, medical record, correspondence). Content lives in a document store.",
  "x-primaryKey": ["document_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "document_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "document_type": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 50,
      "description": "E.g. APPLICATION, DECLARATIONS, ENDORSEMENT, INVOICE, LOSS_PHOTO, ESTIMATE, MEDICAL_RECORD, EOB, CORRESPONDENCE."
    },
    "title": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 255
    },
    "storage_uri": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 1000
    },
    "mime_type": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 100
    },
    "content_hash": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 128,
      "description": "Digest of the content for integrity."
    },
    "received_at": {
      "$ref": "../common/types.schema.json#/$defs/timestamp"
    },
    "direction": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 10,
      "description": "INBOUND, OUTBOUND or INTERNAL."
    },
    "contains_phi": {
      "$ref": "../common/types.schema.json#/$defs/boolean"
    },
    "party_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "party.party_id"
    },
    "submission_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "submission.submission_id"
    },
    "policy_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy.policy_id"
    },
    "policy_transaction_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy_transaction.policy_transaction_id"
    },
    "claim_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "claim.claim_id"
    },
    "health_claim_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "health_claim.health_claim_id"
    },
    "billing_account_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "billing_account.billing_account_id"
    }
  },
  "required": ["document_id", "document_type", "storage_uri"],
  "unevaluatedProperties": false
}
