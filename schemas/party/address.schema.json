{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "address",
  "description": "A postal or physical location. Shared by parties, insured locations and loss locations.",
  "type": "object",
  "x-primaryKey": ["address_id"],
  "required": ["address_id", "line_1", "city", "postal_code", "country_code"],
  "properties": {
    "address_id": { "type": "string", "format": "uuid" },
    "line_1": { "type": "string", "maxLength": 255, "x-sensitivity": "PII" },
    "line_2": { "type": "string", "maxLength": 255, "x-sensitivity": "PII" },
    "city": { "type": "string", "maxLength": 100 },
    "county": { "type": "string", "maxLength": 100 },
    "jurisdiction_code": {
      "type": "string",
      "maxLength": 6,
      "description": "State or equivalent.",
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "postal_code": { "type": "string", "maxLength": 20 },
    "country_code": { "type": "string", "maxLength": 2, "x-references": "country.country_code" },
    "latitude": { "type": "number", "format": "decimal" },
    "longitude": { "type": "number", "format": "decimal" },
    "geocode_precision": { "type": "string", "maxLength": 30, "description": "ROOFTOP, PARCEL, STREET, POSTAL_CODE, ..." },
    "census_block_fips": { "type": "string", "maxLength": 15 },
    "is_validated": { "type": "boolean", "description": "True when standardized against a postal reference (e.g. USPS CASS)." }
  },
  "additionalProperties": false
}
