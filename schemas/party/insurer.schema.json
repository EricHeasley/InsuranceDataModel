{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "insurer",
  "description": "A licensed insurance company (underwriting/writing company) of the enterprise, or an external carrier referenced on claims and prior coverage.",
  "type": "object",
  "x-primaryKey": ["insurer_id"],
  "x-unique": [
    ["party_id"]
  ],
  "required": ["insurer_id", "party_id", "is_internal"],
  "properties": {
    "insurer_id": { "type": "string", "format": "uuid" },
    "party_id": { "type": "string", "format": "uuid", "x-references": "organization.party_id" },
    "naic_company_code": { "type": "string", "maxLength": 5 },
    "naic_group_code": { "type": "string", "maxLength": 5 },
    "domicile_jurisdiction_code": { "type": "string", "maxLength": 6, "x-references": "jurisdiction.jurisdiction_code" },
    "is_internal": { "type": "boolean", "description": "True for the enterprise's own writing companies." },
    "financial_strength_rating": { "type": "string", "maxLength": 10, "description": "E.g. AM Best rating." }
  },
  "additionalProperties": false
}
