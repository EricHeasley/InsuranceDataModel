{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "organization",
  "description": "A legal entity or other organized group.",
  "type": "object",
  "x-primaryKey": ["party_id"],
  "x-subtypeOf": "party",
  "required": ["party_id", "legal_name"],
  "properties": {
    "party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "legal_name": { "type": "string", "maxLength": 255 },
    "dba_name": { "type": "string", "maxLength": 255, "description": "Doing-business-as name." },
    "organization_type": {
      "type": "string",
      "enum": [
        "CORPORATION", "LLC", "PARTNERSHIP", "SOLE_PROPRIETOR", "NONPROFIT", "GOVERNMENT", "TRUST", "ESTATE",
        "ASSOCIATION", "OTHER"
      ]
    },
    "naics_code_value_id": {
      "type": "string",
      "format": "uuid",
      "description": "Primary NAICS industry code.",
      "x-references": "code_value.code_value_id"
    },
    "formation_date": { "type": "string", "format": "date" },
    "formation_jurisdiction_code": { "type": "string", "maxLength": 6, "x-references": "jurisdiction.jurisdiction_code" },
    "annual_revenue_amount": { "type": "number", "format": "money" },
    "employee_count": { "type": "integer" },
    "website_url": { "type": "string", "maxLength": 500 }
  },
  "additionalProperties": false
}
