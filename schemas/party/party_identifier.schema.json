{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/party/party_identifier.schema.json",
  "title": "party_identifier",
  "description": "An identifier issued to a party by an external authority (SSN, FEIN, driver license, NPI, NPN, ...).",
  "x-primaryKey": ["party_identifier_id"],
  "x-unique": [
    ["identifier_type", "identifier_value", "issuing_jurisdiction_code", "party_id"]
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "party_identifier_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "party_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "party.party_id"
    },
    "identifier_type": {
      "$ref": "enums/identifier_type.schema.json"
    },
    "identifier_value": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 100,
      "description": "Store encrypted or tokenized.",
      "x-sensitivity": "PII"
    },
    "issuing_jurisdiction_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 6,
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "valid_from": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "valid_to": {
      "$ref": "../common/types.schema.json#/$defs/date"
    }
  },
  "required": ["party_identifier_id", "party_id", "identifier_type", "identifier_value"],
  "unevaluatedProperties": false
}
