{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "staff_member",
  "description": "An employee, contractor or system identity that performs work on policies and claims.",
  "type": "object",
  "x-primaryKey": ["staff_member_id"],
  "required": ["staff_member_id", "user_name", "staff_role", "is_active"],
  "properties": {
    "staff_member_id": { "type": "string", "format": "uuid" },
    "party_id": {
      "type": "string",
      "format": "uuid",
      "description": "Null for system identities.",
      "x-references": "party.party_id"
    },
    "user_name": { "type": "string", "maxLength": 100 },
    "staff_role": {
      "type": "string",
      "enum": [
        "UNDERWRITER", "CLAIM_ADJUSTER", "CLAIM_SUPERVISOR", "SIU_INVESTIGATOR", "CUSTOMER_SERVICE",
        "BILLING_SPECIALIST", "PREMIUM_AUDITOR", "NURSE_CASE_MANAGER", "ACTUARY", "SYSTEM", "OTHER"
      ]
    },
    "supervisor_staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "office_code": { "type": "string", "maxLength": 30 },
    "payment_authority_amount": { "type": "number", "format": "money", "description": "Maximum single claim payment this person may approve." },
    "reserve_authority_amount": { "type": "number", "format": "money" },
    "is_active": { "type": "boolean" }
  },
  "additionalProperties": false
}
