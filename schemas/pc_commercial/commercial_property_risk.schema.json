{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commercial_property_risk",
  "description": "Policy-specific rating detail for a building or business personal property at a location on a commercial property, BOP or package policy.",
  "type": "object",
  "x-primaryKey": ["policy_risk_id"],
  "x-subtypeOf": "policy_risk",
  "required": ["policy_risk_id"],
  "properties": {
    "policy_risk_id": { "type": "string", "format": "uuid", "x-references": "policy_risk.policy_risk_id" },
    "building_number": { "type": "integer" },
    "occupancy_code_value_id": {
      "type": "string",
      "format": "uuid",
      "description": "ISO occupancy / class code.",
      "x-references": "code_value.code_value_id"
    },
    "occupancy_description": { "type": "string", "maxLength": 200 },
    "protection_class": { "type": "string", "maxLength": 5 },
    "building_value_amount": { "type": "number", "format": "money" },
    "business_personal_property_value_amount": { "type": "number", "format": "money" },
    "business_income_value_amount": { "type": "number", "format": "money" },
    "valuation_method": {
      "type": "string",
      "enum": [
        "REPLACEMENT_COST", "ACTUAL_CASH_VALUE", "AGREED_VALUE", "STATED_AMOUNT", "FUNCTIONAL_REPLACEMENT_COST",
        "MARKET_VALUE"
      ]
    },
    "coinsurance_percent": { "type": "number", "format": "percent" },
    "is_owner_occupied": { "type": "boolean" },
    "occupied_percent": { "type": "number", "format": "percent" },
    "is_vacant": { "type": "boolean" },
    "wind_hail_excluded": { "type": "boolean" },
    "earthquake_zone": { "type": "string", "maxLength": 10 },
    "wind_tier": { "type": "string", "maxLength": 10 },
    "last_inspection_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
