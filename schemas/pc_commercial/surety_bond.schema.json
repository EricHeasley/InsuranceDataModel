{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "surety_bond",
  "description": "Surety or fidelity bond specific attributes of a policy. Principal and obligee are policy parties.",
  "type": "object",
  "x-primaryKey": ["policy_id"],
  "x-subtypeOf": "policy",
  "required": ["policy_id", "bond_type", "penal_sum_amount"],
  "properties": {
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "bond_type": {
      "type": "string",
      "enum": [
        "CONTRACT_BID", "CONTRACT_PERFORMANCE", "CONTRACT_PAYMENT", "LICENSE_PERMIT", "COURT", "PUBLIC_OFFICIAL",
        "FIDUCIARY", "FIDELITY", "MISCELLANEOUS"
      ]
    },
    "penal_sum_amount": { "type": "number", "format": "money" },
    "contract_amount": { "type": "number", "format": "money" },
    "obligation_description": { "type": "string" },
    "is_continuous": { "type": "boolean", "description": "Continuous until cancelled rather than a fixed term." },
    "collateral_amount": { "type": "number", "format": "money" },
    "indemnity_agreement_document_id": { "type": "string", "format": "uuid", "x-references": "document.document_id" },
    "released_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
