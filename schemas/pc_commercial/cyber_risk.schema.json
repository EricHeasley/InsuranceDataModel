{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cyber_risk",
  "description": "Policy-specific rating detail for cyber liability and privacy coverage.",
  "type": "object",
  "x-primaryKey": ["policy_risk_id"],
  "x-subtypeOf": "policy_risk",
  "required": ["policy_risk_id"],
  "properties": {
    "policy_risk_id": { "type": "string", "format": "uuid", "x-references": "policy_risk.policy_risk_id" },
    "sensitive_record_count": { "type": "integer", "description": "Number of PII/PHI/PCI records held." },
    "annual_online_revenue_amount": { "type": "number", "format": "money" },
    "has_multi_factor_authentication": { "type": "boolean" },
    "has_endpoint_detection": { "type": "boolean" },
    "has_offline_backups": { "type": "boolean" },
    "has_incident_response_plan": { "type": "boolean" },
    "pci_compliance_level": { "type": "string", "maxLength": 10 },
    "security_rating_score": { "type": "number", "format": "decimal", "description": "External security posture score." },
    "security_assessed_on": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
