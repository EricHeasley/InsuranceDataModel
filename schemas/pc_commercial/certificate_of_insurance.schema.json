{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "certificate_of_insurance",
  "description": "Evidence of coverage issued to a third party (ACORD 25/28 style).",
  "type": "object",
  "x-primaryKey": ["certificate_of_insurance_id"],
  "required": ["certificate_of_insurance_id", "policy_id", "holder_party_id", "issued_on"],
  "properties": {
    "certificate_of_insurance_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "holder_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "certificate_number": { "type": "string", "maxLength": 50 },
    "issued_on": { "type": "string", "format": "date" },
    "description_of_operations": { "type": "string" },
    "issued_by_producer_id": { "type": "string", "format": "uuid", "x-references": "producer.producer_id" },
    "document_id": { "type": "string", "format": "uuid", "x-references": "document.document_id" }
  },
  "additionalProperties": false
}
