{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "premium_audit",
  "description": "An audit of actual exposures for an auditable policy term, producing additional or return premium through a PREMIUM_AUDIT policy transaction.",
  "type": "object",
  "x-primaryKey": ["premium_audit_id"],
  "required": [
    "premium_audit_id", "policy_term_id", "audit_type", "audit_status", "audit_period_start_date",
    "audit_period_end_date"
  ],
  "properties": {
    "premium_audit_id": { "type": "string", "format": "uuid" },
    "policy_term_id": { "type": "string", "format": "uuid", "x-references": "policy_term.policy_term_id" },
    "audit_type": { "type": "string", "enum": ["FINAL", "INTERIM", "PRELIMINARY", "REVISED"] },
    "audit_method": { "type": "string", "enum": ["PHYSICAL", "PHONE", "MAIL", "VIRTUAL", "WAIVED", "ESTIMATED"] },
    "audit_status": { "type": "string", "enum": ["ORDERED", "IN_PROGRESS", "COMPLETED", "DISPUTED", "NON_COMPLIANT", "WAIVED"] },
    "audit_period_start_date": { "type": "string", "format": "date" },
    "audit_period_end_date": { "type": "string", "format": "date" },
    "ordered_on": { "type": "string", "format": "date" },
    "completed_on": { "type": "string", "format": "date" },
    "auditor_staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "audit_vendor_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "policy_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Transaction that booked the audit result.",
      "x-references": "policy_transaction.policy_transaction_id"
    }
  },
  "additionalProperties": false
}
