{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commercial_auto_risk",
  "description": "Policy-specific rating detail for a vehicle on a commercial auto policy.",
  "type": "object",
  "x-primaryKey": ["policy_risk_id"],
  "x-subtypeOf": "policy_risk",
  "required": ["policy_risk_id"],
  "properties": {
    "policy_risk_id": { "type": "string", "format": "uuid", "x-references": "policy_risk.policy_risk_id" },
    "vehicle_class_code_value_id": {
      "type": "string",
      "format": "uuid",
      "description": "ISO commercial auto classification code.",
      "x-references": "code_value.code_value_id"
    },
    "commercial_vehicle_use": { "type": "string", "enum": ["SERVICE", "RETAIL", "COMMERCIAL"] },
    "radius_of_operation": {
      "type": "string",
      "oneOf": [
        { "const": "LOCAL", "description": "Up to 50 miles" },
        { "const": "INTERMEDIATE", "description": "51 to 200 miles" },
        { "const": "LONG_DISTANCE", "description": "Over 200 miles" }
      ]
    },
    "ownership_type": { "type": "string", "enum": ["OWNED", "FINANCED", "LEASED", "NON_OWNED", "HIRED"] },
    "garaging_address_id": { "type": "string", "format": "uuid", "x-references": "address.address_id" },
    "stated_amount": { "type": "number", "format": "money" },
    "is_fleet": { "type": "boolean" },
    "covered_auto_symbol": { "type": "string", "maxLength": 20, "description": "Covered auto designation symbols (1-9, 19)." },
    "has_interstate_filing": { "type": "boolean", "description": "Federal or state motor carrier filing (e.g. MCS-90) required." },
    "usdot_number": { "type": "string", "maxLength": 20 }
  },
  "additionalProperties": false
}
