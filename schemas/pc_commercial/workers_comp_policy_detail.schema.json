{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workers_comp_policy_detail",
  "description": "Workers' compensation specific attributes of a policy.",
  "type": "object",
  "x-primaryKey": ["policy_id"],
  "x-subtypeOf": "policy",
  "required": ["policy_id"],
  "properties": {
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "bureau_risk_id": { "type": "string", "maxLength": 20, "description": "NCCI or state bureau risk identification number." },
    "rating_bureau": { "type": "string", "maxLength": 30, "description": "NCCI or independent bureau (WCIRB, NYCIRB, PCRB, ...)." },
    "anniversary_rating_date": { "type": "string", "format": "date" },
    "is_experience_rated": { "type": "boolean" },
    "has_owner_officer_exclusions": { "type": "boolean" },
    "is_assigned_risk": { "type": "boolean" },
    "is_retrospectively_rated": { "type": "boolean" },
    "deductible_program_type": { "type": "string", "maxLength": 30, "description": "NONE, SMALL_DEDUCTIBLE, LARGE_DEDUCTIBLE." },
    "employee_leasing_arrangement": { "type": "string", "maxLength": 30, "description": "PEO / employee leasing arrangement, if any." }
  },
  "additionalProperties": false
}
