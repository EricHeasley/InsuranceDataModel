{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy_location",
  "description": "A premises or location scheduled on a policy.",
  "type": "object",
  "x-primaryKey": ["policy_location_id"],
  "required": ["policy_location_id", "policy_id", "location_number", "address_id", "effective_date", "added_by_transaction_id"],
  "properties": {
    "policy_location_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "location_number": { "type": "integer" },
    "address_id": { "type": "string", "format": "uuid", "x-references": "address.address_id" },
    "is_primary": { "type": "boolean" },
    "territory_code": { "type": "string", "maxLength": 20, "description": "Rating territory." },
    "description": { "type": "string", "maxLength": 500 },
    "effective_date": { "type": "string", "format": "date", "description": "First business date this row applies." },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Business date this row stops applying (exclusive); null while open-ended."
    },
    "added_by_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Policy transaction that introduced this row.",
      "x-references": "policy_transaction.policy_transaction_id"
    },
    "removed_by_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Policy transaction that removed or superseded this row.",
      "x-references": "policy_transaction.policy_transaction_id"
    }
  },
  "additionalProperties": false
}
