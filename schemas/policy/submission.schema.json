{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "submission",
  "description": "A request for insurance received from an applicant or producer, prior to and independent of any policy.",
  "type": "object",
  "x-primaryKey": ["submission_id"],
  "x-unique": [
    ["submission_number"]
  ],
  "required": ["submission_id", "submission_number", "applicant_party_id", "product_id", "submission_status", "received_at"],
  "properties": {
    "submission_id": { "type": "string", "format": "uuid" },
    "submission_number": { "type": "string", "maxLength": 30 },
    "applicant_party_id": { "type": "string", "format": "uuid", "x-references": "party.party_id" },
    "product_id": { "type": "string", "format": "uuid", "x-references": "product.product_id" },
    "producer_id": { "type": "string", "format": "uuid", "x-references": "producer.producer_id" },
    "jurisdiction_code": { "type": "string", "maxLength": 6, "x-references": "jurisdiction.jurisdiction_code" },
    "submission_status": { "type": "string", "enum": ["RECEIVED", "IN_REVIEW", "QUOTED", "BOUND", "DECLINED", "WITHDRAWN", "EXPIRED"] },
    "is_renewal": { "type": "boolean", "description": "True for renewal re-underwriting of an existing policy." },
    "renewal_of_policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "channel": {
      "type": "string",
      "maxLength": 30,
      "description": "AGENT_PORTAL, DIRECT_WEB, CALL_CENTER, API, EXCHANGE, PAPER, ..."
    },
    "received_at": { "type": "string", "format": "date-time" },
    "requested_effective_date": { "type": "string", "format": "date" },
    "assigned_underwriter_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "application_data": {
      "type": "object",
      "description": "Application answers not modeled as attributes (underwriting questionnaires)."
    }
  },
  "additionalProperties": false
}
