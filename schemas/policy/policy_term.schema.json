{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy_term",
  "description": "A contiguous period of coverage under a policy, typically 6 or 12 months for P&C and plan-year for health. Continuous contracts (life, annuity) have a single open-ended term.",
  "type": "object",
  "x-primaryKey": ["policy_term_id"],
  "x-unique": [
    ["policy_id", "term_number"]
  ],
  "required": ["policy_term_id", "policy_id", "term_number", "effective_date", "policy_term_status"],
  "properties": {
    "policy_term_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "term_number": { "type": "integer", "description": "1 for the first term, incremented at each renewal." },
    "effective_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date", "description": "Null for continuous contracts." },
    "policy_term_status": { "type": "string", "enum": ["PENDING", "IN_FORCE", "CANCELLED", "EXPIRED", "VOIDED"] },
    "cancellation_date": { "type": "string", "format": "date" },
    "cancellation_reason": {
      "type": "string",
      "enum": [
        "INSURED_REQUEST", "NON_PAYMENT", "UNDERWRITING", "MATERIAL_MISREPRESENTATION", "REWRITTEN",
        "SOLD_OR_NO_LONGER_OWNED", "COVERAGE_PLACED_ELSEWHERE", "DECEASED", "COMPANY_WITHDRAWAL", "OTHER"
      ]
    },
    "cancellation_method": { "type": "string", "enum": ["PRO_RATA", "SHORT_RATE", "FLAT"] },
    "product_filing_id": {
      "type": "string",
      "format": "uuid",
      "description": "Rate filing edition the term is rated under.",
      "x-references": "product_filing.product_filing_id"
    },
    "is_auditable": { "type": "boolean", "description": "True when premium is subject to audit of actual exposure." }
  },
  "additionalProperties": false
}
