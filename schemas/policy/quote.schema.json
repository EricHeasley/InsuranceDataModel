{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quote",
  "description": "A priced offer made in response to a submission. A submission may have several quote versions or options; at most one is bound into a policy transaction.",
  "type": "object",
  "x-primaryKey": ["quote_id"],
  "x-unique": [
    ["quote_number", "version_number"]
  ],
  "required": ["quote_id", "submission_id", "quote_number", "version_number", "quote_status"],
  "properties": {
    "quote_id": { "type": "string", "format": "uuid" },
    "submission_id": { "type": "string", "format": "uuid", "x-references": "submission.submission_id" },
    "quote_number": { "type": "string", "maxLength": 30 },
    "version_number": { "type": "integer" },
    "quote_status": { "type": "string", "enum": ["DRAFT", "RATED", "PRESENTED", "ACCEPTED", "BOUND", "DECLINED", "EXPIRED"] },
    "proposed_effective_date": { "type": "string", "format": "date" },
    "proposed_expiration_date": { "type": "string", "format": "date" },
    "total_premium_amount": { "type": "number", "format": "money" },
    "total_taxes_fees_amount": { "type": "number", "format": "money" },
    "valid_until": { "type": "string", "format": "date" },
    "rated_at": { "type": "string", "format": "date-time" },
    "quote_data": {
      "type": "object",
      "description": "Full rated quote payload (risks, coverages, rating worksheet) as produced by the quoting system."
    },
    "bound_policy_transaction_id": { "type": "string", "format": "uuid", "x-references": "policy_transaction.policy_transaction_id" }
  },
  "additionalProperties": false
}
