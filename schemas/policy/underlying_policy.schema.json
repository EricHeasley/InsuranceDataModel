{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "underlying_policy",
  "description": "A primary policy scheduled beneath an umbrella or excess policy, whether written by this insurer or another.",
  "type": "object",
  "x-primaryKey": ["underlying_policy_id"],
  "required": ["underlying_policy_id", "policy_id", "effective_date", "added_by_transaction_id"],
  "properties": {
    "underlying_policy_id": { "type": "string", "format": "uuid" },
    "policy_id": {
      "type": "string",
      "format": "uuid",
      "description": "The umbrella or excess policy.",
      "x-references": "policy.policy_id"
    },
    "internal_policy_id": {
      "type": "string",
      "format": "uuid",
      "description": "The underlying policy when written by this insurer.",
      "x-references": "policy.policy_id"
    },
    "carrier_name": { "type": "string", "maxLength": 255 },
    "underlying_policy_number": { "type": "string", "maxLength": 50 },
    "line_of_business_code": { "type": "string", "maxLength": 30, "x-references": "line_of_business.line_of_business_code" },
    "per_occurrence_limit_amount": { "type": "number", "format": "money" },
    "aggregate_limit_amount": { "type": "number", "format": "money" },
    "limits_description": { "type": "string", "maxLength": 200 },
    "underlying_effective_date": { "type": "string", "format": "date" },
    "underlying_expiration_date": { "type": "string", "format": "date" },
    "effective_date": { "type": "string", "format": "date", "description": "First business date this row applies." },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Business date this row stops applying (exclusive); null while open-ended."
    },
    "added_by_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Policy transaction that introduced this row.",
      "x-references": "policy_transaction.policy_transaction_id"
    },
    "removed_by_transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Policy transaction that removed or superseded this row.",
      "x-references": "policy_transaction.policy_transaction_id"
    }
  },
  "additionalProperties": false
}
