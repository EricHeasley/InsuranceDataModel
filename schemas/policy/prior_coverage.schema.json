{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prior_coverage",
  "description": "Insurance an applicant held previously with any carrier, as declared or verified at underwriting.",
  "type": "object",
  "x-primaryKey": ["prior_coverage_id"],
  "required": ["prior_coverage_id", "carrier_name"],
  "properties": {
    "prior_coverage_id": { "type": "string", "format": "uuid" },
    "submission_id": { "type": "string", "format": "uuid", "x-references": "submission.submission_id" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "carrier_name": { "type": "string", "maxLength": 255 },
    "carrier_insurer_id": { "type": "string", "format": "uuid", "x-references": "insurer.insurer_id" },
    "prior_policy_number": { "type": "string", "maxLength": 50 },
    "line_of_business_code": { "type": "string", "maxLength": 30, "x-references": "line_of_business.line_of_business_code" },
    "effective_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" },
    "premium_amount": { "type": "number", "format": "money" },
    "limits_description": { "type": "string", "maxLength": 200 },
    "claim_count": { "type": "integer" },
    "incurred_loss_amount": { "type": "number", "format": "money" },
    "had_lapse": { "type": "boolean" }
  },
  "additionalProperties": false
}
