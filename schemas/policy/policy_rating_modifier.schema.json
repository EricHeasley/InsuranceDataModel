{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/policy/policy_rating_modifier.schema.json",
  "title": "policy_rating_modifier",
  "description": "A discount, surcharge, experience modification, schedule credit or underwriting class applied in rating a policy, risk or coverage.",
  "x-primaryKey": ["policy_rating_modifier_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    },
    {
      "$ref": "../common/policy_versioned.schema.json"
    }
  ],
  "properties": {
    "policy_rating_modifier_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "policy_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy.policy_id"
    },
    "policy_risk_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy_risk.policy_risk_id"
    },
    "policy_coverage_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy_coverage.policy_coverage_id"
    },
    "rating_modifier_type": {
      "$ref": "enums/rating_modifier_type.schema.json"
    },
    "modifier_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 50
    },
    "factor": {
      "$ref": "../common/types.schema.json#/$defs/rate",
      "description": "Multiplicative factor, e.g. 0.85 experience mod."
    },
    "amount": {
      "$ref": "../common/types.schema.json#/$defs/money",
      "description": "Flat amount when the modifier is additive."
    },
    "jurisdiction_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 6,
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "justification": {
      "$ref": "../common/types.schema.json#/$defs/text"
    }
  },
  "required": ["policy_rating_modifier_id", "policy_id", "rating_modifier_type", "modifier_code"],
  "unevaluatedProperties": false
}
