{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/policy/premium_transaction.schema.json",
  "title": "premium_transaction",
  "description": "The written-premium ledger: one signed amount per policy transaction, coverage, state and charge type, with the coverage period it is earned over. Written, earned, unearned and in-force premium are all derived from these rows.",
  "x-primaryKey": ["premium_transaction_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    }
  ],
  "properties": {
    "premium_transaction_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "policy_transaction_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy_transaction.policy_transaction_id"
    },
    "policy_coverage_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "description": "Null for policy-level fees and taxes.",
      "x-references": "policy_coverage.policy_coverage_id"
    },
    "premium_charge_type": {
      "$ref": "enums/premium_charge_type.schema.json"
    },
    "amount": {
      "$ref": "../common/types.schema.json#/$defs/money",
      "description": "Signed change in written amount; negative for return premium."
    },
    "jurisdiction_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 6,
      "description": "State the premium is allocated to for statutory reporting and premium tax.",
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "asl_code": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 10,
      "x-references": "annual_statement_line.asl_code"
    },
    "earning_start_date": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "earning_end_date": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "accounting_date": {
      "$ref": "../common/types.schema.json#/$defs/date"
    },
    "is_commissionable": {
      "$ref": "../common/types.schema.json#/$defs/boolean"
    }
  },
  "required": [
    "premium_transaction_id",
    "policy_transaction_id",
    "premium_charge_type",
    "amount",
    "jurisdiction_code",
    "earning_start_date",
    "earning_end_date",
    "accounting_date"
  ],
  "unevaluatedProperties": false
}
