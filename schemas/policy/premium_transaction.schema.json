{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "premium_transaction",
  "description": "The written-premium ledger: one signed amount per policy transaction, coverage, state and charge type, with the coverage period it is earned over. Written, earned, unearned and in-force premium are all derived from these rows.",
  "type": "object",
  "x-primaryKey": ["premium_transaction_id"],
  "required": [
    "premium_transaction_id", "policy_transaction_id", "premium_charge_type", "amount", "jurisdiction_code",
    "earning_start_date", "earning_end_date", "accounting_date"
  ],
  "properties": {
    "premium_transaction_id": { "type": "string", "format": "uuid" },
    "policy_transaction_id": { "type": "string", "format": "uuid", "x-references": "policy_transaction.policy_transaction_id" },
    "policy_coverage_id": {
      "type": "string",
      "format": "uuid",
      "description": "Null for policy-level fees and taxes.",
      "x-references": "policy_coverage.policy_coverage_id"
    },
    "premium_charge_type": {
      "type": "string",
      "oneOf": [
        { "const": "PREMIUM", "description": "Risk premium" },
        { "const": "MINIMUM_PREMIUM_ADJUSTMENT" },
        { "const": "POLICY_FEE" },
        { "const": "INSTALLMENT_FEE" },
        { "const": "INSPECTION_FEE" },
        { "const": "BROKER_FEE" },
        { "const": "PREMIUM_TAX" },
        { "const": "SURPLUS_LINES_TAX" },
        { "const": "STAMPING_FEE" },
        {
          "const": "STATE_SURCHARGE",
          "description": "Statutory assessment or surcharge (e.g. FIGA, FHCF, WC assessments)"
        },
        { "const": "TERRORISM_PREMIUM", "description": "TRIA premium" },
        { "const": "EXPENSE_CONSTANT" },
        { "const": "OTHER_FEE" }
      ]
    },
    "amount": {
      "type": "number",
      "format": "money",
      "description": "Signed change in written amount; negative for return premium."
    },
    "jurisdiction_code": {
      "type": "string",
      "maxLength": 6,
      "description": "State the premium is allocated to for statutory reporting and premium tax.",
      "x-references": "jurisdiction.jurisdiction_code"
    },
    "asl_code": { "type": "string", "maxLength": 10, "x-references": "annual_statement_line.asl_code" },
    "earning_start_date": { "type": "string", "format": "date" },
    "earning_end_date": { "type": "string", "format": "date" },
    "accounting_date": { "type": "string", "format": "date" },
    "is_commissionable": { "type": "boolean" }
  },
  "additionalProperties": false
}
