{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/policy/policy_party.schema.json",
  "title": "policy_party",
  "description": "A party's role on a policy, optionally scoped to one risk (e.g. lienholder on a vehicle, mortgagee on a building).",
  "x-primaryKey": ["policy_party_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    },
    {
      "$ref": "../common/policy_versioned.schema.json"
    }
  ],
  "properties": {
    "policy_party_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "policy_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy.policy_id"
    },
    "party_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "party.party_id"
    },
    "policy_party_role": {
      "$ref": "enums/policy_party_role.schema.json"
    },
    "policy_risk_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy_risk.policy_risk_id"
    },
    "is_primary": {
      "$ref": "../common/types.schema.json#/$defs/boolean"
    },
    "interest_rank": {
      "$ref": "../common/types.schema.json#/$defs/integer",
      "description": "Priority among interests of the same role (1st mortgagee, 2nd mortgagee)."
    },
    "reference_number": {
      "$ref": "../common/types.schema.json#/$defs/string",
      "maxLength": 50,
      "description": "Loan number or similar reference of the interested party."
    },
    "mailing_address_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "address.address_id"
    }
  },
  "required": ["policy_party_id", "policy_id", "party_id", "policy_party_role"],
  "unevaluatedProperties": false
}
