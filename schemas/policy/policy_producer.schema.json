{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy_producer",
  "description": "A producer credited with a policy, with their share of commission.",
  "type": "object",
  "x-primaryKey": ["policy_producer_id"],
  "required": ["policy_producer_id", "policy_id", "producer_id", "policy_producer_role", "effective_date"],
  "properties": {
    "policy_producer_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "format": "uuid", "x-references": "policy.policy_id" },
    "producer_id": { "type": "string", "format": "uuid", "x-references": "producer.producer_id" },
    "policy_producer_role": { "type": "string", "enum": ["WRITING", "SERVICING", "SPLIT", "OVERRIDE", "WHOLESALE"] },
    "commission_split_percent": { "type": "number", "format": "percent" },
    "effective_date": { "type": "string", "format": "date" },
    "expiration_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
