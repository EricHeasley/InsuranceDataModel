{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EricHeasley/InsuranceDataModel/schemas/policy/policy_form.schema.json",
  "title": "policy_form",
  "description": "A form or endorsement attached to a policy.",
  "x-primaryKey": ["policy_form_id"],
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/audit.schema.json"
    },
    {
      "$ref": "../common/policy_versioned.schema.json"
    }
  ],
  "properties": {
    "policy_form_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid"
    },
    "policy_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy.policy_id"
    },
    "form_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "form.form_id"
    },
    "policy_coverage_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy_coverage.policy_coverage_id"
    },
    "policy_risk_id": {
      "$ref": "../common/types.schema.json#/$defs/uuid",
      "x-references": "policy_risk.policy_risk_id"
    },
    "variable_data": {
      "$ref": "../common/types.schema.json#/$defs/json",
      "description": "Fill-in values for manuscript or schedule fields on the form."
    }
  },
  "required": ["policy_form_id", "policy_id", "form_id"],
  "unevaluatedProperties": false
}
