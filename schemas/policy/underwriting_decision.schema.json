{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "underwriting_decision",
  "description": "A recorded underwriting decision on a submission or policy transaction.",
  "type": "object",
  "x-primaryKey": ["underwriting_decision_id"],
  "required": ["underwriting_decision_id", "underwriting_decision_type", "decided_at"],
  "properties": {
    "underwriting_decision_id": { "type": "string", "format": "uuid" },
    "submission_id": { "type": "string", "format": "uuid", "x-references": "submission.submission_id" },
    "policy_transaction_id": { "type": "string", "format": "uuid", "x-references": "policy_transaction.policy_transaction_id" },
    "underwriting_decision_type": {
      "type": "string",
      "enum": ["APPROVED", "APPROVED_WITH_CONDITIONS", "COUNTER_OFFER", "REFERRED", "POSTPONED", "DECLINED", "INCOMPLETE"]
    },
    "is_automated": { "type": "boolean", "description": "True when decided by rules or a model without human review." },
    "decided_by_staff_member_id": { "type": "string", "format": "uuid", "x-references": "staff_member.staff_member_id" },
    "decided_at": { "type": "string", "format": "date-time" },
    "reason_code": { "type": "string", "maxLength": 50, "description": "Reason given, including adverse action reasons." },
    "conditions": { "type": "string" }
  },
  "additionalProperties": false
}
