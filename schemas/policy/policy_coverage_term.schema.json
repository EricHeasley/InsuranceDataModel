{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy_coverage_term",
  "description": "The selected value of a limit, deductible or other term for a coverage on a policy.",
  "type": "object",
  "x-primaryKey": ["policy_coverage_term_id"],
  "x-unique": [
    ["policy_coverage_id", "coverage_term_definition_id"]
  ],
  "required": ["policy_coverage_term_id", "policy_coverage_id", "coverage_term_definition_id"],
  "properties": {
    "policy_coverage_term_id": { "type": "string", "format": "uuid" },
    "policy_coverage_id": { "type": "string", "format": "uuid", "x-references": "policy_coverage.policy_coverage_id" },
    "coverage_term_definition_id": { "type": "string", "format": "uuid", "x-references": "coverage_term_definition.coverage_term_definition_id" },
    "term_value": {
      "type": "number",
      "format": "decimal",
      "description": "Numeric value: amount, percent, days, months or count per the definition's value type."
    },
    "term_code_value": { "type": "string", "maxLength": 50, "description": "Selected option when the term is a coded choice." }
  },
  "additionalProperties": false
}
